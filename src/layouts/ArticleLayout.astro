---
import BaseLayout from "./BaseLayout.astro";
import { TableOfContents } from "../components/interactive";
import ArticleImagePreview from "../components/interactive/ArticleImagePreview";
import ArrowLink from "../components/content/ArrowLink.astro";
import Chip from "../components/ui/Chip.astro";
import { SITE } from "../config/site";
import { withBase } from "../lib/paths";

interface Props {
  title: string;
  description?: string;
  image?: string;
  articleTitle: string;
  date: string;
  backHref: string;
  backLabel: string;
  tags?: string[];
  tagLinkPrefix?: string;
  readingTime?: number;
}

const {
  title,
  description,
  image = '/og-image.svg',
  articleTitle,
  date,
  backHref,
  backLabel,
  tags = [],
  tagLinkPrefix = '',
  readingTime = 0,
} = Astro.props;

const siteUrl = Astro.site?.href || SITE.url;
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = new URL(withBase(image), siteUrl).href;
---

<BaseLayout title={title} description={description} image={image}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": articleTitle,
    "datePublished": date,
    "author": {
      "@type": "Person",
      "name": SITE.name
    },
    "image": imageUrl,
    "mainEntityOfPage": currentUrl,
    ...(description ? { "description": description } : {})
  })} />
  
  <main id="main-content" class="pt-24 pb-10 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-[650px] mx-auto mb-8 lg:ml-auto lg:mr-[calc(250px+4.5rem)]">
        <div class="flex items-center justify-between mb-6">
          <ArrowLink href={backHref} label={backLabel} direction="back" />
          <span class="text-sm text-gray-600">{date}</span>
        </div>

        <h1 class="text-3xl font-bold text-gray-800 mb-4">{articleTitle}</h1>
        <slot name="meta" />

        {tags && tags.length > 0 && !Astro.slots.has('meta') && (
          <div class="mb-8">
            <div class="flex items-center gap-2 flex-wrap">
              {tags.map((tag: string) => (
                <Chip
                  label={tag}
                  href={`${tagLinkPrefix}?tag=${encodeURIComponent(tag)}`}
                />
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_650px_250px] gap-18">
        <div class="hidden lg:block"></div>
        
        <div>
          <slot name="cover" />
          
          <div class="flex flex-wrap items-center justify-between gap-3 py-4 mb-6 border-b border-gray-200 text-sm text-gray-600">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
              {readingTime > 0 && (
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span>{readingTime} min read</span>
                </div>
              )}
              <slot name="actions" />
            </div>
            
            <button 
              id="share-btn"
              type="button"
              class="ui-action cursor-pointer"
              data-url={currentUrl}
              data-title={articleTitle}
              aria-live="polite"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
              </svg>
              <span data-share-label>Share</span>
            </button>
          </div>

          <slot name="beforeContent" />
          
          <article class="prose prose-sm" id="article-content">
            <slot />
          </article>
        </div>

        <TableOfContents client:load />
      </div>
    </div>
  </main>

  <ArticleImagePreview client:load />

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const shareBtn = document.getElementById('share-btn');
      if (!shareBtn) return;

      const label = shareBtn.querySelector('[data-share-label]');
      const originalText = label?.textContent || 'Share';
      let resetTimer: number | undefined;

      const setShareLabel = (text: string) => {
        if (!label) return;
        label.textContent = text;
        if (resetTimer) window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          label.textContent = originalText;
        }, 2000);
      };

      const copyUrl = async (url: string) => {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(url);
          return;
        }

        const textarea = document.createElement('textarea');
        textarea.value = url;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.top = '-9999px';
        textarea.style.left = '-9999px';
        document.body.appendChild(textarea);
        textarea.select();

        const copied = document.execCommand('copy');
        textarea.remove();

        if (!copied) throw new Error('Copy command failed');
      };

      shareBtn.addEventListener('click', async () => {
        const url = shareBtn.getAttribute('data-url') || window.location.href;
        const title = shareBtn.getAttribute('data-title') || document.title;

        if (navigator.share && window.isSecureContext) {
          try {
            await navigator.share({ title, url });
            setShareLabel('Shared');
            return;
          } catch (error) {
            if (error instanceof DOMException && error.name === 'AbortError') return;
          }
        }

        try {
          await copyUrl(url);
          setShareLabel('Copied');
        } catch (error) {
          setShareLabel('Copy failed');
          console.error('Failed to share or copy:', error);
        }
      });
    });
  </script>
</BaseLayout>

<style is:global>
  .prose {
    color: var(--color-text-body);
    max-width: 100%;
    font-family: var(--font-body);
    text-align: left;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
  }
  
  .prose h1 {
    display: none;
  }
  
  .prose h2 {
    font-size: 1.5rem;
    font-weight: 600;
    font-family: var(--font-heading);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-text-heading);
    scroll-margin-top: 100px;
  }

  .prose h3 {
    font-size: 1.25rem;
    font-weight: 600;
    font-family: var(--font-heading);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-text-heading);
    scroll-margin-top: 100px;
  }
  
  .prose h4 {
    font-family: var(--font-heading);
    color: var(--color-text-heading);
  }
  
  .prose p {
    margin-bottom: 1rem;
    line-height: 1.7;
    color: var(--color-text-body);
    font-family: var(--font-body);
  }
  
  .prose ul {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    list-style-type: disc;
  }
  
  .prose ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    list-style-type: decimal;
  }
  
  .prose li {
    margin-bottom: 0.5rem;
    color: var(--color-text-body);
    font-family: var(--font-body);
    display: list-item;
  }
  
  .prose strong {
    font-weight: 600;
    color: var(--color-text-heading);
  }
  
  .prose code {
    color: var(--color-text-muted);
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: var(--font-code);
  }
  
  .prose pre {
    background-color: #2B2B2B;
    color: #F9FAFB;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  
  .prose pre code {
    background-color: transparent;
    padding: 0;
    color: #F9FAFB;
  }
  
  .prose hr {
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    display: table;
    table-layout: fixed;
  }
  .prose th,
  .prose td {
    border: 1px solid var(--color-border);
    padding: 0.625rem 0.75rem;
    text-align: left;
    vertical-align: top;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }
  .prose table th:nth-child(1),
  .prose table td:nth-child(1) { width: 22%; min-width: 0; }
  .prose table th:nth-child(2),
  .prose table td:nth-child(2) { width: 48%; min-width: 0; }
  .prose table th:nth-child(3),
  .prose table td:nth-child(3) { width: 30%; min-width: 0; }
  .prose th {
    background-color: var(--color-surface-muted);
    font-weight: 600;
    font-family: var(--font-heading);
    color: var(--color-text-heading);
  }
  .prose td {
    color: var(--color-text-body);
    font-family: var(--font-body);
  }
  .prose thead tr {
    border-bottom: 2px solid #D1D5DB;
  }
  .prose tbody tr:nth-child(even) td {
    background-color: #F9FAFB;
  }
  
  .prose a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  
  .prose a:hover {
    color: var(--color-link-hover);
  }

  .prose img {
    cursor: zoom-in;
    transition: opacity 0.2s;
  }

  .prose img:hover {
    opacity: 0.9;
  }

  html.dark .prose {
    color: #D6D3D1;
  }
  
  html.dark .prose h1,
  html.dark .prose h2,
  html.dark .prose h3,
  html.dark .prose h4,
  html.dark .prose h5,
  html.dark .prose h6,
  html.dark .prose strong {
    color: #F5F5F4;
  }
  
  html.dark .prose p,
  html.dark .prose li {
    color: #D6D3D1;
  }
  
  html.dark .prose code {
    color: #D6D3D1;
  }
  
  html.dark .prose hr {
    border-color: #44403C;
  }

  html.dark .prose th,
  html.dark .prose td {
    border-color: #44403C;
  }
  html.dark .prose th {
    background-color: #292524;
    color: #F5F5F4;
  }
  html.dark .prose td {
    color: #D6D3D1;
  }
  html.dark .prose thead tr {
    border-bottom-color: #57534E;
  }
  html.dark .prose tbody tr:nth-child(even) td {
    background-color: #1C1917;
  }
  
  html.dark .bg-gray-100 {
    background-color: #292524 !important;
  }

  html.dark .prose a {
    color: #93C5FD;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  html.dark .prose a:hover {
    color: #BFDBFE;
  }

  html.dark .border-gray-200 {
    border-color: #44403C !important;
  }
</style>
