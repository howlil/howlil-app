---
import BaseLayout from "./BaseLayout.astro";
import { TableOfContents } from "../components/interactive";
import ArticleImagePreview from "../components/interactive/ArticleImagePreview";
import ArrowLink from "../components/content/ArrowLink.astro";
import Chip from "../components/ui/Chip.astro";
import { SITE } from "../config/site";
import { withBase } from "../lib/paths";

interface Props {
  title: string;
  description?: string;
  image?: string;
  articleTitle: string;
  date: string;
  backHref: string;
  backLabel: string;
  tags?: string[];
  tagLinkPrefix?: string;
  readingTime?: number;
  contentVariant?: 'editorial' | 'technical';
}

const {
  title,
  description,
  image = '/og-image.svg',
  articleTitle,
  date,
  backHref,
  backLabel,
  tags = [],
  tagLinkPrefix = '',
  readingTime = 0,
  contentVariant = 'editorial',
} = Astro.props;

const siteUrl = Astro.site?.href || SITE.url;
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = new URL(withBase(image), siteUrl).href;
const dateLabel = new Intl.DateTimeFormat('en', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${date}T00:00:00.000Z`));
---

<BaseLayout title={title} description={description} image={image}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": articleTitle,
    "datePublished": date,
    "author": { "@type": "Person", "name": SITE.name },
    "image": imageUrl,
    "mainEntityOfPage": currentUrl,
    ...(description ? { "description": description } : {})
  })} />

  <main id="main-content" class="pb-20 pt-[84px]">
    <div class="site-shell">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-x-10">
        <div class="lg:col-span-9">
          <div class="reading-column">
            <header class="pb-8">
              <ArrowLink href={backHref} label={backLabel} direction="back" />

              <div class="site-ui mb-4 mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[11px] text-gray-500">
                <span>{dateLabel}</span>
                {readingTime > 0 && <span>{readingTime} min read</span>}
              </div>

              <h1 class="text-balance text-3xl font-semibold leading-[1.12] tracking-[-0.03em] text-gray-900 sm:text-4xl">{articleTitle}</h1>
              <slot name="meta" />

              {tags && tags.length > 0 && !Astro.slots.has('meta') && (
                <div class="mt-5 flex flex-wrap items-center gap-2">
                  {tags.map((tag: string) => (
                    <Chip label={tag} href={`${tagLinkPrefix}?tag=${encodeURIComponent(tag)}`} />
                  ))}
                </div>
              )}

              {Astro.slots.has('actions') && (
                <div class="site-ui mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-gray-600">
                  <slot name="actions" />
                </div>
              )}
            </header>

            <slot name="cover" />
            <slot name="beforeContent" />

            <article class:list={["prose prose-sm", { "prose-technical": contentVariant === 'technical' }]} id="article-content">
              <slot />
            </article>
          </div>
        </div>

        <div class="lg:col-span-3">
          <aside class="mt-10 lg:sticky lg:top-20 lg:mt-0">
            <TableOfContents client:load />
          </aside>
        </div>
      </div>
    </div>
  </main>

  <ArticleImagePreview client:load />
</BaseLayout>

<style is:global>
  .prose {
    color: var(--color-text-body);
    max-width: 100%;
    font-family: var(--font-prose);
    text-align: left;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
  }

  .prose-technical {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .prose h1 { display: none; }

  .prose h2 {
    font-size: 1.375rem;
    font-weight: 600;
    font-family: var(--font-heading);
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    color: var(--color-text-heading);
    scroll-margin-top: 84px;
    letter-spacing: -0.015em;
  }

  .prose h3 {
    font-size: 1.125rem;
    font-weight: 600;
    font-family: var(--font-heading);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    color: var(--color-text-heading);
    scroll-margin-top: 84px;
  }

  .prose h4 {
    font-family: var(--font-heading);
    color: var(--color-text-heading);
  }

  .prose p {
    margin-bottom: 1rem;
    line-height: 1.75;
    color: var(--color-text-body);
    font-family: var(--font-prose);
  }

  .prose-technical p,
  .prose-technical li,
  .prose-technical td {
    font-family: var(--font-heading);
  }

  .prose ul {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    list-style-type: disc;
  }

  .prose ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    list-style-type: decimal;
  }

  .prose li {
    margin-bottom: 0.5rem;
    color: var(--color-text-body);
    font-family: var(--font-prose);
    display: list-item;
  }

  .prose strong {
    font-weight: 600;
    color: var(--color-text-heading);
  }

  .prose code {
    color: var(--color-text-muted);
    padding: 0.15rem 0.3rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-muted);
    font-size: 0.875rem;
    font-family: var(--font-code);
  }

  .prose pre {
    background-color: #171a21;
    color: #f0f3f6;
    padding: 1rem;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-bottom: 1rem;
  }

  .prose pre code {
    background-color: transparent;
    padding: 0;
    color: #f0f3f6;
  }

  .prose hr {
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    display: table;
    table-layout: fixed;
  }

  .prose th,
  .prose td {
    border: 1px solid var(--color-border);
    padding: 0.625rem 0.75rem;
    text-align: left;
    vertical-align: top;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .prose table th:nth-child(1),
  .prose table td:nth-child(1) { width: 22%; min-width: 0; }
  .prose table th:nth-child(2),
  .prose table td:nth-child(2) { width: 48%; min-width: 0; }
  .prose table th:nth-child(3),
  .prose table td:nth-child(3) { width: 30%; min-width: 0; }

  .prose th {
    background-color: var(--color-surface-muted);
    font-weight: 600;
    font-family: var(--font-heading);
    color: var(--color-text-heading);
  }

  .prose td {
    color: var(--color-text-body);
    font-family: var(--font-prose);
  }

  .prose thead tr { border-bottom: 2px solid var(--color-border-strong); }
  .prose tbody tr:nth-child(even) td { background-color: var(--color-surface-muted); }

  .prose a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose a:hover { color: var(--color-link-hover); }

  .prose img {
    cursor: zoom-in;
    transition: opacity 0.2s;
  }

  .prose img:hover { opacity: 0.9; }
</style>
