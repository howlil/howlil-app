---
import BaseLayout from "./BaseLayout.astro";
import { TableOfContents } from "../components/interactive";
import ArticleImagePreview from "../components/interactive/ArticleImagePreview";
import ArrowLink from "../components/content/ArrowLink.astro";
import { SITE } from "../config/site";
import { withBase } from "../lib/paths";

interface Props {
  title: string;
  description?: string;
  image?: string;
  articleTitle: string;
  date: string;
  backHref: string;
  backLabel: string;
  tags?: string[];
  tagLinkPrefix?: string;
  readingTime?: number;
  contentVariant?: 'editorial' | 'technical';
  recordLabel?: string;
}

const {
  title,
  description,
  image = '/og-image.svg',
  articleTitle,
  date,
  backHref,
  backLabel,
  tags = [],
  tagLinkPrefix = '',
  readingTime = 0,
  contentVariant = 'technical',
  recordLabel = 'Article',
} = Astro.props;

const siteUrl = Astro.site?.href || SITE.url;
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = new URL(withBase(image), siteUrl).href;
const dateLabel = new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00.000Z`));
---

<BaseLayout title={title} description={description} image={image}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": articleTitle,
    "datePublished": date,
    "author": { "@type": "Person", "name": SITE.name },
    "image": imageUrl,
    "mainEntityOfPage": currentUrl,
    ...(description ? { "description": description } : {})
  })} />

  <main id="main-content" class="pb-10">
    <div class="site-shell">
      <header class="border-b border-gray-200 py-10 sm:py-12">
        <ArrowLink href={backHref} label={backLabel} direction="back" />
        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class="eyebrow">{recordLabel}</span>
          <span class="eyebrow">{dateLabel}</span>
          {readingTime > 0 && <span class="eyebrow">{readingTime} min read</span>}
        </div>
        <h1 class="mt-4 max-w-[19ch] text-balance text-[35px] font-semibold leading-[1.04] tracking-[-0.045em] text-gray-900 sm:text-[42px]">{articleTitle}</h1>
        <slot name="meta" />

        {tags && tags.length > 0 && !Astro.slots.has('meta') && (
          <div class="site-ui mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[10px] text-gray-500">
            {tags.map((tag: string, index: number) => (
              <Fragment>
                {index > 0 && <span aria-hidden="true">·</span>}
                <a href={`${tagLinkPrefix}?tag=${encodeURIComponent(tag)}`} class="hover:text-gray-900">{tag}</a>
              </Fragment>
            ))}
          </div>
        )}

        {Astro.slots.has('actions') && (
          <div class="site-ui mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-gray-600"><slot name="actions" /></div>
        )}
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_13rem]">
        <div class="min-w-0 py-8 lg:pr-10">
          <div class="reading-column">
            <slot name="cover" />
            <slot name="beforeContent" />
            <article class:list={["prose", { "prose-technical": contentVariant === 'technical' }]} id="article-content"><slot /></article>
          </div>
        </div>
        <aside class="border-t border-gray-200 py-7 lg:border-l lg:border-t-0 lg:pl-6">
          <div class="lg:sticky lg:top-6"><TableOfContents client:load /></div>
        </aside>
      </div>
    </div>
  </main>
  <ArticleImagePreview client:load />
</BaseLayout>

<style is:global>
  .prose {
    color: var(--color-text-body);
    max-width: 100%;
    font-family: var(--font-prose);
    text-align: left;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
  }
  .prose-technical { font-size: .9375rem; line-height: 1.74; }
  .prose h1 { display:none; }
  .prose h2 {
    border-top:1px solid var(--color-border);
    padding-top:1.35rem;
    font-size:1.4rem;
    font-weight:600;
    font-family:var(--font-heading);
    line-height:1.22;
    margin-top:3rem;
    margin-bottom:.9rem;
    color:var(--color-text-heading);
    scroll-margin-top:2rem;
    letter-spacing:-.03em;
  }
  .prose h2:first-child { margin-top:0; }
  .prose h3 {
    font-size:1.025rem;
    font-weight:600;
    font-family:var(--font-heading);
    margin-top:2rem;
    margin-bottom:.65rem;
    color:var(--color-text-heading);
    scroll-margin-top:2rem;
    letter-spacing:-.015em;
  }
  .prose h4 { font-family:var(--font-heading); color:var(--color-text-heading); }
  .prose p { margin-bottom:1rem; line-height:1.74; color:var(--color-text-body); font-family:var(--font-prose); }
  .prose ul,.prose ol { margin-bottom:1rem; padding-left:1.35rem; }
  .prose ul { list-style-type:disc; }
  .prose ol { list-style-type:decimal; }
  .prose li { margin-bottom:.45rem; color:var(--color-text-body); font-family:var(--font-prose); display:list-item; }
  .prose strong { font-weight:600; color:var(--color-text-heading); }
  .prose blockquote {
    margin:1.6rem 0;
    border-left:2px solid var(--color-accent);
    padding:.2rem 0 .2rem 1rem;
    color:var(--color-text-secondary);
  }
  .prose blockquote p:last-child { margin-bottom:0; }
  .prose code {
    color:var(--color-text-heading);
    padding:.1rem .28rem;
    border-radius:.25rem;
    background:var(--color-surface-muted);
    font-size:.8125rem;
    font-family:var(--font-code);
  }
  .prose pre {
    background:#171816;
    color:#f1f1ed;
    padding:1rem 1.05rem;
    border-radius:.375rem;
    overflow-x:auto;
    margin:1.35rem 0 1.55rem;
    border:1px solid var(--color-border-strong);
  }
  .prose pre code { background:transparent; padding:0; color:#f1f1ed; }
  .prose hr { border-top:1px solid var(--color-border); margin:2.25rem 0; }
  .prose table {
    width:100%;
    border-collapse:collapse;
    margin:1.4rem 0 1.65rem;
    display:table;
    table-layout:fixed;
    font-size:.8125rem;
    border-top:1px solid var(--color-border-strong);
    border-bottom:1px solid var(--color-border-strong);
  }
  .prose th,.prose td { border-bottom:1px solid var(--color-border); padding:.7rem .65rem; text-align:left; vertical-align:top; word-wrap:break-word; overflow-wrap:break-word; }
  .prose tr:last-child td { border-bottom:0; }
  .prose table th:nth-child(1),.prose table td:nth-child(1) { width:22%; }
  .prose table th:nth-child(2),.prose table td:nth-child(2) { width:48%; }
  .prose table th:nth-child(3),.prose table td:nth-child(3) { width:30%; }
  .prose th { background:transparent; font-weight:600; font-family:var(--font-heading); color:var(--color-text-heading); }
  .prose td { color:var(--color-text-body); font-family:var(--font-prose); }
  .prose a { color:var(--color-link); text-decoration:underline; text-underline-offset:2px; }
  .prose a:hover { color:var(--color-link-hover); }
  .prose img { cursor:zoom-in; border-radius:.5rem; border:1px solid var(--color-border); transition:opacity .2s ease; }
  .prose img:hover { opacity:.94; }
  .prose.prose-technical,.prose.prose-technical p,.prose.prose-technical li,.prose.prose-technical td { font-family:var(--font-heading); }
</style>
