---
import BaseLayout from "./BaseLayout.astro";
import { TableOfContents } from "../components/interactive";
import ArticleImagePreview from "../components/interactive/ArticleImagePreview";
import ArrowLink from "../components/content/ArrowLink.astro";
import Chip from "../components/ui/Chip.astro";
import { SITE } from "../config/site";
import { withBase } from "../lib/paths";

interface Props {
  title: string;
  description?: string;
  image?: string;
  articleTitle: string;
  date: string;
  backHref: string;
  backLabel: string;
  tags?: string[];
  tagLinkPrefix?: string;
  readingTime?: number;
  contentVariant?: 'editorial' | 'technical';
  recordLabel?: string;
}

const {
  title,
  description,
  image = '/og-image.svg',
  articleTitle,
  date,
  backHref,
  backLabel,
  tags = [],
  tagLinkPrefix = '',
  readingTime = 0,
  contentVariant = 'technical',
  recordLabel = 'Article',
} = Astro.props;

const siteUrl = Astro.site?.href || SITE.url;
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = new URL(withBase(image), siteUrl).href;
const dateLabel = new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00.000Z`));
---

<BaseLayout title={title} description={description} image={image}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": articleTitle,
    "datePublished": date,
    "author": { "@type": "Person", "name": SITE.name },
    "image": imageUrl,
    "mainEntityOfPage": currentUrl,
    ...(description ? { "description": description } : {})
  })} />

  <main id="main-content" class="pb-20 pt-[92px]">
    <div class="site-shell">
      <header class="max-w-3xl pb-9 pt-5">
        <ArrowLink href={backHref} label={backLabel} direction="back" />
        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class="eyebrow">{recordLabel}</span>
          <span class="eyebrow">{dateLabel}</span>
          {readingTime > 0 && <span class="eyebrow">{readingTime} min read</span>}
        </div>
        <h1 class="mt-4 max-w-[18ch] text-balance text-[36px] font-semibold leading-[1.02] tracking-[-0.05em] text-gray-900 sm:text-[44px]">{articleTitle}</h1>
        <slot name="meta" />

        {tags && tags.length > 0 && !Astro.slots.has('meta') && (
          <div class="mt-5 flex flex-wrap items-center gap-2">
            {tags.map((tag: string) => <Chip label={tag} href={`${tagLinkPrefix}?tag=${encodeURIComponent(tag)}`} />)}
          </div>
        )}

        {Astro.slots.has('actions') && (
          <div class="site-ui mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-gray-600"><slot name="actions" /></div>
        )}
      </header>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_10rem] lg:gap-x-9">
        <div class="min-w-0">
          <div class="reading-column">
            <slot name="cover" />
            <slot name="beforeContent" />
            <article class:list={["prose", { "prose-technical": contentVariant === 'technical' }]} id="article-content"><slot /></article>
          </div>
        </div>
        <aside class="mt-4 lg:sticky lg:top-24 lg:mt-0 lg:self-start"><TableOfContents client:load /></aside>
      </div>
    </div>
  </main>
  <ArticleImagePreview client:load />
</BaseLayout>

<style is:global>
  .prose {
    color: var(--color-text-body);
    max-width: 100%;
    font-family: var(--font-prose);
    text-align: left;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
    padding-top: 1.75rem;
  }
  .prose-technical { font-size: .9375rem; line-height: 1.72; }
  .prose h1 { display:none; }
  .prose h2 {
    font-size: 1.5rem;
    font-weight: 600;
    font-family: var(--font-heading);
    line-height: 1.2;
    margin-top: 2.75rem;
    margin-bottom: .85rem;
    color: var(--color-text-heading);
    scroll-margin-top: 96px;
    letter-spacing: -.03em;
  }
  .prose h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    font-family: var(--font-heading);
    margin-top: 1.9rem;
    margin-bottom: .65rem;
    color: var(--color-text-heading);
    scroll-margin-top: 96px;
    letter-spacing: -.015em;
  }
  .prose h4 { font-family:var(--font-heading); color:var(--color-text-heading); }
  .prose p { margin-bottom:1rem; line-height:1.72; color:var(--color-text-body); font-family:var(--font-prose); }
  .prose ul,.prose ol { margin-bottom:1rem; padding-left:1.35rem; }
  .prose ul { list-style-type:disc; }
  .prose ol { list-style-type:decimal; }
  .prose li { margin-bottom:.45rem; color:var(--color-text-body); font-family:var(--font-prose); display:list-item; }
  .prose strong { font-weight:600; color:var(--color-text-heading); }
  .prose blockquote {
    margin:1.5rem 0;
    border-left:3px solid var(--color-accent);
    border-radius:0 var(--radius-md) var(--radius-md) 0;
    background:var(--color-accent-soft);
    padding:.9rem 1rem;
    color:var(--color-text-secondary);
  }
  .prose blockquote p:last-child { margin-bottom:0; }
  .prose code {
    color:var(--color-text-heading);
    padding:.12rem .3rem;
    border-radius:.3rem;
    background:var(--color-surface-muted);
    font-size:.8125rem;
    font-family:var(--font-code);
  }
  .prose pre {
    background:#171614;
    color:#f7f4ef;
    padding:1rem;
    border-radius:var(--radius-md);
    overflow-x:auto;
    margin:1.2rem 0 1.4rem;
    border:1px solid var(--color-border-strong);
  }
  .prose pre code { background:transparent; padding:0; color:#f7f4ef; }
  .prose hr { border-top:1px solid var(--color-border); margin:2rem 0; }
  .prose table {
    width:100%; border-collapse:separate; border-spacing:0; margin:1.25rem 0 1.5rem; display:table; table-layout:fixed;
    font-size:.8125rem; overflow:hidden; border:1px solid var(--color-border); border-radius:var(--radius-md);
  }
  .prose th,.prose td { border-bottom:1px solid var(--color-border); padding:.65rem .7rem; text-align:left; vertical-align:top; word-wrap:break-word; overflow-wrap:break-word; }
  .prose tr:last-child td { border-bottom:0; }
  .prose table th:nth-child(1),.prose table td:nth-child(1) { width:22%; }
  .prose table th:nth-child(2),.prose table td:nth-child(2) { width:48%; }
  .prose table th:nth-child(3),.prose table td:nth-child(3) { width:30%; }
  .prose th { background:var(--color-surface-muted); font-weight:600; font-family:var(--font-heading); color:var(--color-text-heading); }
  .prose td { color:var(--color-text-body); font-family:var(--font-prose); }
  .prose a { color:var(--color-link); text-decoration:underline; text-underline-offset:2px; }
  .prose a:hover { color:var(--color-link-hover); }
  .prose img { cursor:zoom-in; border-radius:var(--radius-lg); transition:opacity .2s ease; }
  .prose img:hover { opacity:.94; }
  .prose.prose-technical,.prose.prose-technical p,.prose.prose-technical li,.prose.prose-technical td { font-family:var(--font-heading); }
</style>
