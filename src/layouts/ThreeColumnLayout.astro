---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  headerTitle: string;
  headerDescription?: string;
  headerLabel?: string;
}

const { title, description, headerTitle, headerDescription = '', headerLabel = '' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main id="main-content" class="site-ui">
    <div class="site-shell">
      <header class="frame-section border-b border-gray-200 py-10 sm:py-12">
        {headerLabel && <p class="eyebrow">{headerLabel}</p>}
        <h1 class:list={["page-title", { "mt-3": headerLabel }]}>{headerTitle}</h1>
        {headerDescription && <p class="page-lede mt-4">{headerDescription}</p>}
      </header>

      <div class="grid lg:grid-cols-[13rem_minmax(0,1fr)]">
        <aside class="border-b border-gray-200 px-[var(--frame-padding)] py-6 lg:border-b-0 lg:border-r lg:py-7">
          <slot name="sidebar" />
        </aside>
        <div class="min-w-0 px-[var(--frame-padding)] py-6 lg:py-7">
          <slot name="content" />
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
