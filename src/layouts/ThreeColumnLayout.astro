---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  headerTitle: string;
  headerDescription: string;
}

const { title, description, headerTitle, headerDescription } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main id="main-content" class="pt-28 pb-20">
    <div class="site-shell">
      <header class="grid gap-6 pb-12 md:grid-cols-12 md:gap-8">
        <div class="md:col-span-3">
          <p class="meta-label">Index</p>
        </div>
        <div class="md:col-span-9 lg:col-span-8">
          <h1 class="text-balance text-4xl font-bold tracking-tight text-gray-900">{headerTitle}</h1>
          <p class="reading-column mt-4 text-base leading-7 text-gray-700">{headerDescription}</p>
        </div>
      </header>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        <div class="lg:col-span-3 lg:order-2">
          <aside class="lg:sticky lg:top-24 lg:self-start">
            <slot name="sidebar" />
          </aside>
        </div>

        <div class="lg:col-span-9 lg:order-1">
          <slot name="content" />
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
