---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  headerTitle: string;
  headerDescription?: string;
  headerLabel?: string;
}

const { title, description, headerTitle, headerDescription = '', headerLabel = '' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main id="main-content" class="site-ui pb-20 pt-[92px]">
    <div class="site-shell">
      <header class="max-w-3xl pb-10 pt-5">
        {headerLabel && <p class="eyebrow">{headerLabel}</p>}
        <h1 class:list={["max-w-[15ch] text-[38px] font-semibold leading-[1.02] tracking-[-0.05em] text-gray-900 sm:text-[46px]", { "mt-4": headerLabel }]}>{headerTitle}</h1>
        {headerDescription && <p class="mt-5 max-w-2xl text-[15px] leading-7 text-gray-600">{headerDescription}</p>}
      </header>

      <div class="border-t border-gray-200 pt-8">
        <div class="mb-7"><slot name="sidebar" /></div>
        <div class="min-w-0"><slot name="content" /></div>
      </div>
    </div>
  </main>
</BaseLayout>
