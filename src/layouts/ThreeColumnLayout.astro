---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  headerTitle: string;
  headerDescription: string;
}

const { title, description, headerTitle, headerDescription } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main id="main-content" class="pt-24 pb-10 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-2xl mx-auto mb-8">
        <h1 class="text-4xl font-bold text-gray-800 mb-3">
          {headerTitle}
        </h1>
        <p class="text-base text-gray-700 leading-7">
          {headerDescription}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-y-6 lg:grid-cols-[1fr_650px_250px] lg:gap-18">
        <div class="hidden lg:block lg:order-1"></div>

        <div class="order-2 lg:order-2">
          <slot name="content" />
        </div>

        <aside class="order-1 lg:order-3 lg:sticky lg:top-24 lg:self-start">
          <slot name="sidebar" />
        </aside>
      </div>
    </div>
  </main>
</BaseLayout>
