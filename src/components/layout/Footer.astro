---
import SocialLinks from '../about/SocialLinks.astro';
import { withBase } from '../../lib/paths';
const year = new Date().getFullYear();
---

<footer class="site-footer site-ui mt-10 border-t-2 border-gray-900 py-4">
  <div class="site-shell grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start sm:gap-x-8">
    <div>
      <p class="swiss-label"><span class="swiss-index">© {year}</span> / MHD ULIL ABSHAR</p>
      <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[10px] uppercase tracking-[0.05em] text-gray-500">
        <a href={withBase('/')} class="hover:text-gray-900">Home</a>
        <a href={withBase('/projects')} class="hover:text-gray-900">Work</a>
        <a href={withBase('/blog')} class="hover:text-gray-900">Writing</a>
        <a href={withBase('/about')} class="hover:text-gray-900">About</a>
      </div>
    </div>
    <SocialLinks orientation="horizontal" />
  </div>
</footer>
