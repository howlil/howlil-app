---
import SocialLinks from '../about/SocialLinks.astro';
import { withBase } from '../../lib/paths';
const year = new Date().getFullYear();
---

<footer class="site-footer site-ui mt-14 pb-8 pt-4">
  <div class="site-shell">
    <div class="surface-card p-6 sm:p-8">
      <div class="grid gap-7 md:grid-cols-[1.3fr_.7fr] md:items-end">
        <div>
          <p class="eyebrow">Keep in touch</p>
          <p class="mt-3 max-w-xl text-[24px] font-semibold leading-tight tracking-[-0.035em] text-gray-900 sm:text-[28px]">
            Interested in reliable products, useful systems, and the decisions behind them.
          </p>
          <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-sm">
            <a href={withBase('/projects')} class="signal-link">Work →</a>
            <a href={withBase('/blog')} class="text-gray-600 hover:text-gray-900">Writing</a>
            <a href={withBase('/about')} class="text-gray-600 hover:text-gray-900">About</a>
          </div>
        </div>
        <div class="md:justify-self-end">
          <SocialLinks orientation="horizontal" />
        </div>
      </div>
    </div>
    <div class="mt-5 flex flex-col gap-2 text-xs text-gray-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Mhd Ulil Abshar</p>
      <p>Designed and built as a personal product case-study portfolio.</p>
    </div>
  </div>
</footer>
