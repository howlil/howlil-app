---
import { SOCIAL_LINKS } from '../../constants/socialLinks';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer border-t border-gray-200">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-8">
    <div class="flex flex-col items-center gap-6">
      <div class="flex items-center gap-4 flex-wrap justify-center">
        {SOCIAL_LINKS.map((link) => {
          const Icon = link.icon;
          return (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 text-gray-600 hover:text-gray-900 transition-transform transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center hover:-translate-y-0.5 focus-visible:-translate-y-0.5"
              aria-label={link.label}
            >
              <Icon className="w-5 h-5" aria-hidden="true" />
            </a>
          );
        })}
      </div>

      <div class="text-center">
        <p class="text-sm text-gray-600">
          &copy; {currentYear} Mhd Ulil Abshar. All rights reserved.
        </p>
        <p class="text-xs text-gray-500 mt-1">
          Built with Astro, React, and Tailwind CSS
        </p>
      </div>
    </div>
  </div>
</footer>
