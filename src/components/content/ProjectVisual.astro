---
interface Props {
  title: string;
  index?: number;
  problem?: string;
  decision?: string;
  outcome?: string;
  focus?: string[];
  compact?: boolean;
}

const {
  title,
  problem = '',
  decision = '',
  outcome = '',
  focus = [],
  compact = false,
} = Astro.props;
---

<section
  class:list={[
    'evidence-surface overflow-hidden',
    compact ? 'p-5' : 'p-5 sm:p-6'
  ]}
  aria-label={`${title} engineering evidence`}
>
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-200 pb-4">
    <div>
      <p class="eyebrow">Engineering evidence</p>
      <h3 class="mt-2 text-[20px] font-semibold leading-tight tracking-[-0.03em] text-gray-900 sm:text-[22px]">{title}</h3>
    </div>
    {focus.length > 0 && <p class="max-w-sm text-right font-mono text-[10px] leading-5 text-gray-500">{focus.slice(0, 3).join(' · ')}</p>}
  </div>

  <dl class:list={['grid gap-0', compact ? 'mt-2' : 'mt-2 sm:grid-cols-3']}>
    {problem && (
      <div class="border-b border-gray-200 py-4 sm:border-b-0 sm:border-r sm:pr-5">
        <dt class="eyebrow">Constraint</dt>
        <dd class="mt-2 text-[13px] leading-6 text-gray-600">{problem}</dd>
      </div>
    )}
    {decision && (
      <div class="border-b border-gray-200 py-4 sm:border-b-0 sm:border-r sm:px-5">
        <dt class="eyebrow">Decision</dt>
        <dd class="mt-2 text-[13px] leading-6 text-gray-700">{decision}</dd>
      </div>
    )}
    {outcome && (
      <div class="py-4 sm:pl-5">
        <dt class="eyebrow">Outcome</dt>
        <dd class="mt-2 text-[13px] leading-6 text-gray-600">{outcome}</dd>
      </div>
    )}
  </dl>
</section>
