---
interface Props {
  title: string;
  index?: number;
  problem?: string;
  decision?: string;
  outcome?: string;
  focus?: string[];
  compact?: boolean;
}

const {
  title,
  index = 0,
  problem = '',
  decision = '',
  outcome = '',
  focus = [],
  compact = false,
} = Astro.props;

const palettes = [
  ['#DDE6FF', '#C8D6FF', '#293B73'],
  ['#F4DECD', '#EACAB0', '#6E3C22'],
  ['#DDEBDD', '#C9DFC9', '#31573A'],
];
const [base, block, ink] = palettes[index % palettes.length];
---

<div
  class:list={[
    'relative overflow-hidden rounded-[22px] border border-black/5 p-5 sm:p-6',
    compact ? 'min-h-[260px]' : 'min-h-[330px]'
  ]}
  style={`background:${base}; color:${ink}`}
  aria-label={`${title} case study map`}
>
  <div class="flex items-center justify-between gap-4 font-mono text-[10px] uppercase tracking-[0.05em] opacity-70">
    <span>Case {String(index + 1).padStart(2, '0')}</span>
    <span>Decision trail</span>
  </div>

  <h3 class="mt-8 max-w-lg text-[24px] font-semibold leading-[1.05] tracking-[-0.035em] sm:text-[28px]">{title}</h3>

  <div class:list={['mt-8 grid gap-2', compact ? 'sm:grid-cols-3' : 'sm:grid-cols-3']}>
    {problem && (
      <div class="rounded-xl p-3.5" style={`background:${block}`}>
        <p class="font-mono text-[9px] uppercase tracking-[0.05em] opacity-60">Problem</p>
        <p class="mt-2 text-xs leading-5 opacity-90">{problem}</p>
      </div>
    )}
    {decision && (
      <div class="rounded-xl bg-white/55 p-3.5 dark:bg-black/10">
        <p class="font-mono text-[9px] uppercase tracking-[0.05em] opacity-60">Decision</p>
        <p class="mt-2 text-xs leading-5 opacity-90">{decision}</p>
      </div>
    )}
    {outcome && (
      <div class="rounded-xl bg-white/75 p-3.5 dark:bg-black/10">
        <p class="font-mono text-[9px] uppercase tracking-[0.05em] opacity-60">Outcome</p>
        <p class="mt-2 text-xs leading-5 opacity-90">{outcome}</p>
      </div>
    )}
  </div>

  {focus.length > 0 && (
    <div class="mt-5 flex flex-wrap gap-2">
      {focus.slice(0, 3).map((item) => (
        <span class="rounded-full border border-current/15 bg-white/30 px-2.5 py-1 font-mono text-[9px] uppercase tracking-[0.03em]">{item}</span>
      ))}
    </div>
  )}
</div>
