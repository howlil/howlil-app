---
interface Props {
  href: string;
  title: string;
  excerpt: string;
  date: string;
  category?: string;
  filterValue: string;
}

const { href, title, excerpt, date, category, filterValue } = Astro.props;
---

<a href={href} data-tags={filterValue} class="surface-card interactive-card group flex min-h-[230px] flex-col p-5">
  <div class="flex items-center justify-between gap-4">
    <p class="eyebrow">{date}</p>
    {category && <span class="rounded-full border border-gray-200 px-2.5 py-1 text-[10px] text-gray-500">{category}</span>}
  </div>
  <h2 class="mt-5 text-[20px] font-semibold leading-6 tracking-[-0.03em] text-gray-900 group-hover:text-[var(--color-link)]">{title}</h2>
  <p class="mt-3 text-sm leading-6 text-gray-600">{excerpt}</p>
  <p class="mt-auto pt-7 text-xs text-gray-500">Read article →</p>
</a>
