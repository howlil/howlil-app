---
interface Props {
  href: string;
  title: string;
  excerpt: string;
  date: string;
  category?: string;
  filterValue: string;
}

const { href, title, excerpt, date, category, filterValue } = Astro.props;
---

<a href={href} data-tags={filterValue} class="group block">
  <article class="grid gap-2 border-b border-gray-200 py-4 sm:grid-cols-[minmax(0,1fr)_7rem] sm:gap-6">
    <div class="min-w-0">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <h2 class="text-[15px] font-semibold tracking-[-0.01em] text-gray-900 group-hover:underline underline-offset-4">{title}</h2>
        {category && <span class="font-mono text-[10px] uppercase tracking-[0.05em] text-gray-500">{category}</span>}
      </div>
      <p class="mt-1.5 max-w-2xl text-sm leading-6 text-gray-600">{excerpt}</p>
    </div>
    <p class="font-mono text-[10px] text-gray-500 sm:text-right">{date}</p>
  </article>
</a>
