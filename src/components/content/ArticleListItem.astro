---
interface Props {
  href: string;
  title: string;
  excerpt: string;
  date: string;
  category?: string;
  filterValue: string;
}

const { href, title, excerpt, date, category, filterValue } = Astro.props;
---

<a href={href} data-tags={filterValue} class="group block">
  <article class="grid gap-2 border-b border-gray-200 py-4 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-x-5">
    <p class="font-mono text-[10px] text-gray-500">{date}</p>
    <div class="min-w-0">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <h2 class="text-[15px] font-semibold tracking-[-0.012em] text-gray-900 group-hover:underline underline-offset-4">{title}</h2>
        {category && <span class="swiss-label">{category}</span>}
      </div>
      <p class="mt-1.5 text-sm leading-6 text-gray-600">{excerpt}</p>
    </div>
  </article>
</a>
