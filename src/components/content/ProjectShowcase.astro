---
import ProjectVisual from './ProjectVisual.astro';

interface Summary {
  problem: string;
  decision: string;
  result: string;
}

interface Props {
  href: string;
  title: string;
  summary: string;
  date: string;
  index: number;
  role?: string;
  engineeringFocus?: string[];
  tags?: string[];
  repository?: string;
  caseStudySummary?: Summary;
}

const {
  href,
  title,
  summary,
  date,
  index,
  role,
  engineeringFocus = [],
  tags = [],
  repository,
  caseStudySummary,
} = Astro.props;
---

<article class="group grid gap-5 py-7 md:grid-cols-[minmax(0,1.15fr)_minmax(16rem,.85fr)] md:items-center md:gap-8">
  <a href={href} class="block rounded-[22px] focus-visible:outline-none">
    <ProjectVisual
      title={title}
      index={index}
      problem={caseStudySummary?.problem}
      decision={caseStudySummary?.decision}
      outcome={caseStudySummary?.result}
      focus={engineeringFocus}
    />
  </a>

  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <p class="eyebrow">{date}</p>
      {role && <span class="rounded-full border border-gray-200 bg-[var(--color-surface)] px-2.5 py-1 text-[10px] text-gray-600">{role}</span>}
    </div>

    <h3 class="mt-3 text-[24px] font-semibold leading-[1.08] tracking-[-0.035em] text-gray-900 sm:text-[28px]">
      <a href={href} class="hover:text-[var(--color-link)]">{title}</a>
    </h3>
    <p class="mt-3 text-[15px] leading-7 text-gray-600">{summary}</p>

    {(engineeringFocus.length > 0 || tags.length > 0) && (
      <div class="mt-5 flex flex-wrap gap-2">
        {engineeringFocus.slice(0, 3).map((item) => <span class="ui-chip">{item}</span>)}
        {tags.slice(0, 2).map((item) => <span class="ui-chip">{item}</span>)}
      </div>
    )}

    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      <a href={href} class="signal-link font-medium">Read case study →</a>
      {repository && <a href={repository} target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-gray-900">Repository ↗</a>}
    </div>
  </div>
</article>
