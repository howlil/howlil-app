---
interface Summary {
  problem: string;
  decision: string;
  result: string;
}

interface Props {
  href: string;
  title: string;
  summary: string;
  date: string;
  index: number;
  role?: string;
  engineeringFocus?: string[];
  tags?: string[];
  repository?: string;
  caseStudySummary?: Summary;
}

import { ArrowUpRight } from 'lucide-react';

const {
  href,
  title,
  summary,
  date,
  index,
  role,
  engineeringFocus = [],
  tags = [],
  repository,
  caseStudySummary,
} = Astro.props;

const focus = engineeringFocus.slice(0, 3).join(' · ');
const stack = tags.slice(0, 4).join(' · ');
const sequence = String(index + 1).padStart(2, '0');
---

<article class="engineering-row interactive-row group py-7 first:border-t-0 sm:py-8">
  <div class="grid gap-4 sm:grid-cols-[2.5rem_minmax(0,1fr)_4rem] sm:gap-6">
    <p class="eyebrow pt-1" aria-hidden="true">{sequence}</p>

    <div class="min-w-0">
      <h3 class="text-[21px] font-semibold leading-[1.16] tracking-[-0.03em] text-gray-900 sm:text-[23px]">
        <a href={href} class="hover:text-[var(--color-link)]">{title}</a>
      </h3>
      <p class="mt-3 max-w-[66ch] text-[16px] leading-7 text-gray-600">{summary}</p>

      {role && <p class="mt-4 text-[13px] font-medium leading-5 text-gray-700">{role}</p>}

      {(focus || stack) && (
        <p class="mt-2 max-w-[66ch] text-[12px] leading-5 text-gray-500">
          {focus}{focus && stack ? ' · ' : ''}{stack}
        </p>
      )}

      {caseStudySummary?.result && (
        <p class="mt-4 max-w-[66ch] text-[14px] leading-6 text-gray-600">
          {caseStudySummary.result}
        </p>
      )}

      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <a href={href} class="signal-link font-medium">Project details →</a>
        {repository && <a href={repository} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-gray-500 hover:text-gray-900">Repository <ArrowUpRight size={14} strokeWidth={1.8} aria-hidden="true" /></a>}
      </div>
    </div>

    <p class="eyebrow sm:text-right">{date}</p>
  </div>
</article>
