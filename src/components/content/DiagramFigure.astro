---
interface Props {
  title: string;
  src: string;
  alt: string;
  caption?: string;
  source?: string;
}

const { title, src, alt, caption, source } = Astro.props;
---

<figure class="not-prose my-10">
  <div class="mb-3 flex items-baseline justify-between gap-4">
    <h2 class="text-lg font-semibold tracking-tight text-gray-900">{title}</h2>
    {source && (
      <a href={source} class="site-ui text-xs text-gray-500 hover:text-gray-900" target="_blank" rel="noopener noreferrer">
        PlantUML source
      </a>
    )}
  </div>
  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white p-3 sm:p-4">
    <img src={src} alt={alt} loading="lazy" class="mx-auto block h-auto max-w-full" />
  </div>
  {caption && <figcaption class="site-ui mt-3 text-sm leading-6 text-gray-500">{caption}</figcaption>}
</figure>
