---
interface DiagramPreview {
  src: string;
  alt: string;
  title: string;
}

interface CaseStudySummary {
  problem: string;
  decision: string;
  result: string;
}

interface Props {
  href: string;
  index: number;
  title: string;
  excerpt: string;
  date: string;
  engineeringFocus?: string[];
  diagram?: DiagramPreview;
  caseStudySummary?: CaseStudySummary;
}

const {
  href,
  index,
  title,
  excerpt,
  date,
  engineeringFocus = [],
  diagram,
  caseStudySummary,
} = Astro.props;

const focus = engineeringFocus.slice(0, 3);
---

<a href={href} class="group block border-b border-gray-200">
  <article class="py-9 lg:py-11">
    <header class="grid gap-3 sm:grid-cols-[2.75rem_minmax(0,1fr)_auto] sm:gap-5">
      <span class="pt-1 font-mono text-xs text-gray-400">{String(index).padStart(2, '0')}</span>

      <div class="min-w-0">
        <h3 class="text-2xl font-semibold tracking-tight text-gray-900 group-hover:underline underline-offset-4 sm:text-[1.7rem]">
          {title}
        </h3>
        {focus.length > 0 && (
          <p class="mt-2 font-mono text-[11px] uppercase leading-5 tracking-[0.08em] text-gray-500">
            {focus.join(' · ')}
          </p>
        )}
      </div>

      <span class="site-ui text-sm text-gray-500 sm:pt-1">{date}</span>
    </header>

    <div class="mt-6 grid gap-8 sm:ml-[4rem] lg:grid-cols-[minmax(0,1.35fr)_minmax(15rem,0.65fr)] lg:gap-10">
      <div class="min-w-0">
        <p class="site-ui max-w-3xl text-[15px] leading-6 text-gray-600">{excerpt}</p>

        {caseStudySummary && (
          <dl class="mt-7 grid gap-5 sm:grid-cols-3 sm:gap-6">
            <div>
              <dt class="site-ui text-sm font-semibold text-gray-900">Problem</dt>
              <dd class="site-ui mt-1.5 text-sm leading-6 text-gray-600">{caseStudySummary.problem}</dd>
            </div>
            <div>
              <dt class="site-ui text-sm font-semibold text-gray-900">Decision</dt>
              <dd class="site-ui mt-1.5 text-sm leading-6 text-gray-600">{caseStudySummary.decision}</dd>
            </div>
            <div>
              <dt class="site-ui text-sm font-semibold text-gray-900">Result</dt>
              <dd class="site-ui mt-1.5 text-sm leading-6 text-gray-600">{caseStudySummary.result}</dd>
            </div>
          </dl>
        )}
      </div>

      {diagram && (
        <figure class="self-start border-y border-gray-200 py-4">
          <div class="flex min-h-40 items-center justify-center bg-gray-50 p-3">
            <img src={diagram.src} alt={diagram.alt} loading="lazy" class="max-h-44 w-full object-contain" />
          </div>
          <figcaption class="site-ui mt-2 text-xs leading-5 text-gray-500">{diagram.title}</figcaption>
        </figure>
      )}
    </div>
  </article>
</a>
