---
interface Props {
  href: string;
  title: string;
  excerpt: string;
  typeLabel: string;
  focus: string[];
  date: string;
  filterValue: string;
}

const { href, title, excerpt, typeLabel, focus, date, filterValue } = Astro.props;
---

<a href={href} data-tags={filterValue} class="group block">
  <article class="grid gap-3 border-b border-gray-200 py-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-8">
    <div class="min-w-0">
      <div class="flex items-baseline gap-3">
        <h2 class="text-lg font-semibold tracking-tight text-gray-900 group-hover:underline underline-offset-4">{title}</h2>
        <span class="site-ui text-xs text-gray-500">{typeLabel}</span>
      </div>
      <p class="site-ui mt-2 max-w-3xl text-[15px] leading-6 text-gray-600">{excerpt}</p>
      {focus.length > 0 && (
        <p class="site-ui mt-3 text-xs text-gray-500">{focus.slice(0, 3).join(' · ')}</p>
      )}
    </div>
    <p class="site-ui text-sm text-gray-500 sm:whitespace-nowrap">{date}</p>
  </article>
</a>
