---
interface Props {
  href: string;
  title: string;
  excerpt: string;
  date: string;
  role?: string;
  engineeringFocus?: string[];
}

const { href, title, excerpt, date, role, engineeringFocus = [] } = Astro.props;
const focus = engineeringFocus.slice(0, 3);
---

<a href={href} class="group block">
  <article class="grid gap-2 border-b border-gray-200 py-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-8">
    <div class="min-w-0">
      <h3 class="text-lg font-semibold tracking-tight text-gray-900 group-hover:underline underline-offset-4">{title}</h3>
      {focus.length > 0 && (
        <p class="site-ui mt-2 text-xs font-medium uppercase tracking-[0.08em] text-gray-500">{focus.join(' · ')}</p>
      )}
      <p class="site-ui mt-2 max-w-3xl text-[15px] leading-6 text-gray-600">{excerpt}</p>
      {role && <p class="site-ui mt-2 text-sm text-gray-500">{role}</p>}
    </div>
    <p class="site-ui text-sm text-gray-500 sm:whitespace-nowrap">{date}</p>
  </article>
</a>
