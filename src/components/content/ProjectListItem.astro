---
interface Props {
  href: string;
  title: string;
  excerpt: string;
  date: string;
  role?: string;
  engineeringFocus?: string[];
  tags?: string[];
  repository?: string;
}

const { href, title, excerpt, date, role, engineeringFocus = [], tags = [], repository } = Astro.props;
const focus = engineeringFocus.slice(0, 2).join(' · ');
const stack = tags.slice(0, 3).join(' · ');
---

<article class="engineering-row py-5 first:border-t-0">
  <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_10rem] sm:gap-6">
    <div>
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <p class="eyebrow">{date}</p>
        {role && <p class="text-[11px] text-gray-500">{role}</p>}
      </div>
      <h3 class="mt-2 text-[18px] font-semibold leading-6 tracking-[-0.025em] text-gray-900">
        <a href={href} class="hover:text-[var(--color-link)]">{title}</a>
      </h3>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-600">{excerpt}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs">
        <a href={href} class="signal-link font-medium">View engineering work →</a>
        {repository && <a href={repository} target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-gray-900">Repository ↗</a>}
      </div>
    </div>

    {(focus || stack) && (
      <div class="border-t border-gray-200 pt-3 sm:border-l sm:border-t-0 sm:pl-4 sm:pt-0">
        {focus && (
          <div>
            <p class="eyebrow">Focus</p>
            <p class="mt-2 text-[11px] leading-5 text-gray-600">{focus}</p>
          </div>
        )}
        {stack && (
          <div class="mt-4">
            <p class="eyebrow">Stack</p>
            <p class="mt-2 text-[11px] leading-5 text-gray-500">{stack}</p>
          </div>
        )}
      </div>
    )}
  </div>
</article>
