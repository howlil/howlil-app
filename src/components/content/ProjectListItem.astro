---
interface Props {
  href: string;
  title: string;
  excerpt: string;
  date: string;
  role?: string;
  engineeringFocus?: string[];
  tags?: string[];
  repository?: string;
}

const { href, title, excerpt, date, role, engineeringFocus = [], tags = [], repository } = Astro.props;
---

<article class="surface-card interactive-card flex min-h-[235px] flex-col p-5">
  <div class="flex items-center justify-between gap-4">
    <p class="eyebrow">{date}</p>
    {role && <span class="max-w-[14rem] truncate text-[10px] text-gray-500">{role}</span>}
  </div>

  <h3 class="mt-4 text-[20px] font-semibold leading-6 tracking-[-0.03em] text-gray-900">
    <a href={href} class="hover:text-[var(--color-link)]">{title}</a>
  </h3>
  <p class="mt-2 text-sm leading-6 text-gray-600">{excerpt}</p>

  {(engineeringFocus.length > 0 || tags.length > 0) && (
    <div class="mt-4 flex flex-wrap gap-1.5">
      {engineeringFocus.slice(0, 2).map((item) => <span class="ui-chip">{item}</span>)}
      {tags.slice(0, 1).map((item) => <span class="ui-chip">{item}</span>)}
    </div>
  )}

  <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-6 text-xs">
    <a href={href} class="signal-link font-medium">Case study →</a>
    {repository && <a href={repository} target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-gray-900">Repo ↗</a>}
  </div>
</article>
