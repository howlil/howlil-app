---
interface Props {
  href: string;
  title: string;
  subtitle?: string;
  excerpt: string;
  tags: string[];
  date: string;
  filterValue: string;
}

const { href, title, subtitle, excerpt, tags, date, filterValue } = Astro.props;

import Chip from "../ui/Chip.astro";
---

<a href={href} data-tags={filterValue} class="group block cursor-pointer">
  <article class="content-list-item border-b last:border-b-0">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4 mb-2">
      <div class="flex-1">
        <h2 class="text-lg font-semibold text-gray-800 mb-1">
          {title}
        </h2>
        {subtitle && (
          <p class="text-sm text-gray-600 italic mb-2">
            {subtitle}
          </p>
        )}
        <p class="text-[15px] text-gray-700 leading-6">
          {excerpt}
        </p>
        <div class="flex flex-wrap gap-2 mt-3">
          {tags.map((tag: string) => (
            <Chip label={tag} />
          ))}
        </div>
      </div>
      <p class="text-sm text-gray-600 sm:whitespace-nowrap">
        {date}
      </p>
    </div>
  </article>
</a>
