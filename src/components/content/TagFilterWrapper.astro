---
interface TagCount { name: string; count: number; }
interface Props { tags: TagCount[]; title?: string; showHash?: boolean; }
const { tags, title = "Topics", showHash = false } = Astro.props;
const ariaLabel = `Filter by ${title.toLowerCase()}`;
---

<div data-filter-root class="w-full">
  <div class="tag-filter-row" role="group" aria-label={ariaLabel}>
    <button type="button" class="tag-filter-btn" data-tag="all" aria-pressed="true"><span>All</span></button>
    {tags.map(({ name, count }) => (
      <button type="button" class="tag-filter-btn" data-tag={name} aria-pressed="false">
        <span>{showHash ? `#${name}` : name}</span><span class="ml-3 font-mono text-[9px] opacity-55">{count}</span>
      </button>
    ))}
  </div>
</div>

<style>
  .tag-filter-btn {
    min-height: 2rem;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: .42rem .68rem;
    font-size: .72rem;
    line-height: 1.2;
    transition: background-color .15s ease, color .15s ease;
  }
  .tag-filter-row { display:flex; gap:.4rem; overflow-x:auto; padding-bottom:.25rem; scrollbar-width:none; }
  .tag-filter-row::-webkit-scrollbar { display:none; }
  .tag-filter-btn:hover { background: var(--color-surface-muted); color: var(--color-text-heading); }
  .tag-filter-btn[aria-pressed='true'] { border-color:var(--color-text-heading); background:var(--color-text-heading); color:var(--color-page); font-weight:600; }
</style>

<script>
  import { matchesTag } from '../../lib/filters';

  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector<HTMLElement>('[data-filter-root]');
    if (!root) return;

    const filterButtons = root.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
    const items = document.querySelectorAll<HTMLElement>('[data-tags]');
    const emptyState = document.querySelector<HTMLElement>('[data-filter-empty]');
    const banner = document.querySelector<HTMLElement>('[data-filter-banner]');
    const bannerLabel = document.querySelector<HTMLElement>('[data-filter-label]');
    const clearButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-clear]');

    const buttonTags = Array.from(filterButtons).map((button) => button.dataset.tag).filter((tag): tag is string => Boolean(tag));
    const canonicalControlTag = (selectedTag: string) => buttonTags.find((tag) => tag !== 'all' && matchesTag(tag, selectedTag));

    const setButtonState = (selectedTag: string) => {
      const canonical = selectedTag === 'all' ? 'all' : canonicalControlTag(selectedTag);
      filterButtons.forEach((button) => button.setAttribute('aria-pressed', String(Boolean(canonical && button.dataset.tag === canonical))));
    };

    const setBanner = (selectedTag: string) => {
      const active = selectedTag !== 'all';
      banner?.classList.toggle('hidden', !active);
      if (bannerLabel) bannerLabel.textContent = active ? selectedTag : '';
    };

    const applyFilter = (selectedTag: string) => {
      setButtonState(selectedTag);
      setBanner(selectedTag);
      let visible = 0;
      items.forEach((item) => {
        const itemTags = (item.dataset.tags || '').split(',').filter(Boolean);
        const match = selectedTag === 'all' || itemTags.some((tag) => matchesTag(tag, selectedTag));
        item.hidden = !match;
        if (match) visible += 1;
      });
      emptyState?.classList.toggle('hidden', visible !== 0);
    };

    const updateUrl = (selectedTag: string, mode: 'push' | 'replace' = 'push') => {
      const url = new URL(window.location.href);
      if (selectedTag === 'all') url.searchParams.delete('tag'); else url.searchParams.set('tag', selectedTag);
      window.history[mode === 'push' ? 'pushState' : 'replaceState']({}, '', url);
    };

    filterButtons.forEach((button) => button.addEventListener('click', () => {
      const selectedTag = button.dataset.tag || 'all'; applyFilter(selectedTag); updateUrl(selectedTag);
    }));
    clearButtons.forEach((button) => button.addEventListener('click', () => { applyFilter('all'); updateUrl('all'); }));
    window.addEventListener('popstate', () => applyFilter(new URL(window.location.href).searchParams.get('tag')?.trim() || 'all'));

    const initialTag = new URL(window.location.href).searchParams.get('tag')?.trim() || 'all';
    applyFilter(initialTag);
  });
</script>
