---
interface TagCount {
  name: string;
  count: number;
}

interface Props {
  tags: TagCount[];
  title?: string;
  showHash?: boolean;
}

const { tags, title = "Tags", showHash = true } = Astro.props;
---

<div class="hidden lg:block sticky top-24 self-start">
  <div class="border-l border-gray-400/40 pl-6">
    <h3 class="text-sm font-semibold text-gray-800 mb-4 uppercase tracking-wide">
      {title}
    </h3>
    <div class="space-y-2">
      <button
        class="tag-filter-btn block min-h-7 w-full py-1.5 text-left text-sm text-gray-800 font-semibold"
        data-tag="all"
        aria-pressed="true"
      >
        All
      </button>
      {tags.map(({ name, count }) => (
        <button
          class="tag-filter-btn flex min-h-7 w-full items-center justify-between py-1.5 text-left text-sm text-gray-700"
          data-tag={name}
          aria-pressed="false"
        >
          <span>{showHash ? `#${name}` : name}</span>
          <span class="text-xs text-gray-600">{count}</span>
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  import { matchesTag } from '../../lib/filters';

  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
    const items = document.querySelectorAll<HTMLElement>('[data-tags]');
    const emptyState = document.querySelector<HTMLElement>('[data-filter-empty]');

    const applyFilter = (selectedTag: string) => {
      filterButtons.forEach((button) => {
        const active = button.dataset.tag === selectedTag;
        button.setAttribute('aria-pressed', String(active));
        button.classList.toggle('text-gray-800', active);
        button.classList.toggle('font-semibold', active);
        button.classList.toggle('text-gray-700', !active);
      });

      let visible = 0;
      items.forEach((item) => {
        const itemTags = (item.dataset.tags || '').split(',').filter(Boolean);
        const match =
          selectedTag === 'all' || itemTags.some((tag) => matchesTag(tag, selectedTag));
        item.style.display = match ? 'block' : 'none';
        if (match) visible += 1;
      });

      emptyState?.classList.toggle('hidden', visible !== 0);
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        applyFilter(button.dataset.tag || 'all');
      });
    });
  });
</script>
