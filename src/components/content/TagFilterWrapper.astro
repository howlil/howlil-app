---
interface TagCount {
  name: string;
  count: number;
}

interface Props {
  tags: TagCount[];
  title?: string;
  showHash?: boolean;
}

const { tags, title = "Tags", showHash = true } = Astro.props;
const ariaLabel = `Filter by ${title.toLowerCase()}`;
---

<div data-filter-root class="w-full">
  <div class="overflow-x-auto pb-1 lg:hidden">
    <div class="flex min-w-max gap-1.5" role="group" aria-label={ariaLabel}>
      <button
        type="button"
        class="tag-filter-btn min-h-10 rounded-sm border border-gray-400 bg-gray-100 px-3 font-mono text-[11px] font-semibold text-gray-800"
        data-filter-mode="mobile"
        data-tag="all"
        aria-pressed="true"
      >
        all
      </button>
      {tags.map(({ name, count }) => (
        <button
          type="button"
          class="tag-filter-btn min-h-10 rounded-sm border border-gray-200 px-3 font-mono text-[11px] text-gray-700"
          data-filter-mode="mobile"
          data-tag={name}
          aria-pressed="false"
        >
          {showHash ? `#${name}` : name} <span class="text-[10px] text-gray-500">{count}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="hidden lg:block">
    <div class="border-l border-gray-300 pl-4">
      <h3 class="mb-3 font-mono text-[10px] font-semibold uppercase tracking-[0.08em] text-gray-500">
        {title}
      </h3>
      <div class="space-y-0.5" role="group" aria-label={ariaLabel}>
        <button
          type="button"
          class="tag-filter-btn block min-h-8 w-full border-l-2 border-gray-800 py-1 pl-2 text-left font-mono text-[11px] font-semibold text-gray-800"
          data-filter-mode="desktop"
          data-tag="all"
          aria-pressed="true"
        >
          all
        </button>
        {tags.map(({ name, count }) => (
          <button
            type="button"
            class="tag-filter-btn flex min-h-8 w-full items-center justify-between border-l-2 border-transparent py-1 pl-2 text-left font-mono text-[11px] text-gray-600"
            data-filter-mode="desktop"
            data-tag={name}
            aria-pressed="false"
          >
            <span class="truncate">{showHash ? `#${name}` : name}</span>
            <span class="ml-2 text-[10px] text-gray-500">{count}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  import { matchesTag } from '../../lib/filters';

  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector<HTMLElement>('[data-filter-root]');
    if (!root) return;

    const filterButtons = root.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
    const items = document.querySelectorAll<HTMLElement>('[data-tags]');
    const emptyState = document.querySelector<HTMLElement>('[data-filter-empty]');
    const banner = document.querySelector<HTMLElement>('[data-filter-banner]');
    const bannerLabel = document.querySelector<HTMLElement>('[data-filter-label]');
    const clearButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-clear]');

    const buttonTags = Array.from(filterButtons)
      .map((button) => button.dataset.tag)
      .filter((tag): tag is string => Boolean(tag));

    const canonicalControlTag = (selectedTag: string) =>
      buttonTags.find((tag) => tag !== 'all' && matchesTag(tag, selectedTag));

    const setButtonState = (selectedTag: string) => {
      const canonical = selectedTag === 'all' ? 'all' : canonicalControlTag(selectedTag);

      filterButtons.forEach((button) => {
        const tag = button.dataset.tag || 'all';
        const active = canonical ? tag === canonical : false;
        button.setAttribute('aria-pressed', String(active));

        if (button.dataset.filterMode === 'mobile') {
          button.classList.toggle('border-gray-400', active);
          button.classList.toggle('bg-gray-100', active);
          button.classList.toggle('font-semibold', active);
          button.classList.toggle('border-gray-200', !active);
        } else {
          button.classList.toggle('border-gray-800', active);
          button.classList.toggle('font-semibold', active);
          button.classList.toggle('text-gray-800', active);
          button.classList.toggle('border-transparent', !active);
          button.classList.toggle('text-gray-600', !active);
        }
      });
    };

    const setBanner = (selectedTag: string) => {
      const active = selectedTag !== 'all';
      banner?.classList.toggle('hidden', !active);
      if (bannerLabel) bannerLabel.textContent = active ? selectedTag : '';
    };

    const applyFilter = (selectedTag: string) => {
      setButtonState(selectedTag);
      setBanner(selectedTag);

      let visible = 0;
      items.forEach((item) => {
        const itemTags = (item.dataset.tags || '').split(',').filter(Boolean);
        const match =
          selectedTag === 'all' || itemTags.some((tag) => matchesTag(tag, selectedTag));
        item.hidden = !match;
        if (match) visible += 1;
      });

      emptyState?.classList.toggle('hidden', visible !== 0);
    };

    const updateUrl = (selectedTag: string, mode: 'push' | 'replace' = 'push') => {
      const url = new URL(window.location.href);
      if (selectedTag === 'all') url.searchParams.delete('tag');
      else url.searchParams.set('tag', selectedTag);
      window.history[mode === 'push' ? 'pushState' : 'replaceState']({}, '', url);
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const selectedTag = button.dataset.tag || 'all';
        applyFilter(selectedTag);
        updateUrl(selectedTag);
      });
    });

    clearButtons.forEach((button) => {
      button.addEventListener('click', () => {
        applyFilter('all');
        updateUrl('all');
      });
    });

    window.addEventListener('popstate', () => {
      const selectedTag = new URL(window.location.href).searchParams.get('tag')?.trim() || 'all';
      applyFilter(selectedTag);
    });

    const initialTag = new URL(window.location.href).searchParams.get('tag')?.trim() || 'all';
    applyFilter(initialTag);
  });
</script>
