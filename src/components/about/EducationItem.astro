---
interface Props {
  institution: string;
  degree: string;
  period: string;
  description?: string;
  points?: string[];
}

const { institution, degree, period, description, points = [] } = Astro.props;
---

<article class="border-t border-gray-200 py-6 first:border-t-0">
  <header class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_8rem] sm:gap-6">
    <div class="min-w-0">
      <h3 class="text-[17px] font-semibold leading-6 tracking-[-0.015em] text-gray-900">{institution}</h3>
      <p class="mt-1 text-[15px] leading-6 text-gray-600">{degree}</p>
    </div>
    <p class="font-mono text-[10px] leading-5 text-gray-500 sm:text-right">{period}</p>
  </header>

  {description && <p class="mt-4 max-w-[66ch] text-[15px] leading-6 text-gray-600">{description}</p>}

  {points.length > 0 && (
    <ul class="mt-4 max-w-[66ch] space-y-2">
      {points.map((point) => (
        <li class="grid grid-cols-[1rem_minmax(0,1fr)] gap-2 text-[14px] leading-6 text-gray-600">
          <span class="font-mono text-[10px] text-gray-400" aria-hidden="true">—</span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
  )}
</article>
