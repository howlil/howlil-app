---
interface Props {
  institution: string;
  degree: string;
  period: string;
  description?: string;
  points?: string[];
}

const { institution, degree, period, description, points = [] } = Astro.props;
const hasBody = Boolean(description) || points.length > 0;
---

{hasBody ? (
  <details class="group border-b border-gray-200 py-3 last:border-b-0" open>
    <summary class="cursor-pointer list-none rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2">
      <span class="grid gap-1 sm:grid-cols-[minmax(0,1fr)_7rem] sm:gap-x-5">
        <span class="min-w-0">
          <span class="block text-sm font-semibold text-gray-900">{institution}</span>
          <span class="block text-sm leading-6 text-gray-600">{degree}</span>
        </span>
        <span class="flex items-center gap-2 font-mono text-[10px] text-gray-500 sm:justify-end">
          {period}
          <span class="transition-transform group-open:rotate-90" aria-hidden="true">›</span>
        </span>
      </span>
    </summary>
    <div class="mt-3 space-y-3 border-l border-gray-200 pl-4">
      {description && <p class="text-sm leading-6 text-gray-600">{description}</p>}
      {points.length > 0 && (
        <ul class="space-y-1.5">
          {points.map((point) => (
            <li class="flex items-start gap-2 text-sm leading-6 text-gray-600">
              <span class="mt-0.5 flex-shrink-0 font-mono text-[10px] text-gray-400" aria-hidden="true">-</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </details>
) : (
  <div class="grid gap-1 border-b border-gray-200 py-3 last:border-b-0 sm:grid-cols-[minmax(0,1fr)_7rem] sm:gap-x-5">
    <div>
      <h3 class="text-sm font-semibold text-gray-900">{institution}</h3>
      <p class="text-sm leading-6 text-gray-600">{degree}</p>
    </div>
    <p class="font-mono text-[10px] text-gray-500 sm:text-right">{period}</p>
  </div>
)}
