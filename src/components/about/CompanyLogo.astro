---
interface Props {
  src: string;
}

import { withBase } from '../../lib/paths';

const { src } = Astro.props;
const normalizedSrc = src.toLowerCase();
const isMetro = normalizedSrc.includes('metro');
const isMeets = normalizedSrc.includes('meets');
---

<span class:list={['company-logo', { 'company-logo--metro': isMetro, 'company-logo--meets': isMeets }]} aria-hidden="true">
  <img src={withBase(src)} alt="" />
</span>

<style>
  .company-logo {
    display: inline-grid;
    width: 1.75rem;
    height: 1.75rem;
    aspect-ratio: 1 / 1;
    flex: 0 0 1.75rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: .38rem;
    background: linear-gradient(145deg, #ffffff 0%, #f8f8f6 52%, #efefec 100%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.72);
    vertical-align: middle;
  }

  .company-logo--meets {
    border-color: #e2e2de;
    background: linear-gradient(145deg, #ffffff 0%, #f7f7f5 52%, #eeeeeb 100%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.78);
  }

  .company-logo--metro {
    border-color: #242424;
    background: linear-gradient(145deg, #050505 0%, #141414 50%, #090909 100%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.07);
  }

  .company-logo img {
    display: block;
    width: 100% !important;
    height: 100% !important;
    padding: .16rem;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    object-fit: contain;
    object-position: center;
    box-sizing: border-box;
  }

  .company-logo--metro img {
    padding: .1rem;
  }
</style>
