---
interface Props {
  src: string;
}

import { withBase } from '../../lib/paths';

const { src } = Astro.props;
const isMetro = src.toLowerCase().includes('metro');
---

<span class:list={['company-logo', { 'company-logo--metro': isMetro }]} aria-hidden="true">
  <img src={withBase(src)} alt="" />
</span>

<style>
  .company-logo {
    display: inline-grid;
    width: 1.75rem;
    height: 1.75rem;
    aspect-ratio: 1 / 1;
    flex: 0 0 1.75rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: .38rem;
    background: #fff;
    vertical-align: middle;
  }

  .company-logo--metro {
    border-color: #050505;
    background: #050505;
  }

  .company-logo img {
    display: block;
    width: 100% !important;
    height: 100% !important;
    padding: .16rem;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    object-fit: contain;
    object-position: center;
    box-sizing: border-box;
  }

  .company-logo--metro img {
    padding: .1rem;
  }
</style>
