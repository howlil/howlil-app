---
interface Props {
  src: string;
}

import { withBase } from '../../lib/paths';

const { src } = Astro.props;
const normalizedSrc = src.toLowerCase();
const isMetro = normalizedSrc.includes('metro');
const isMeets = normalizedSrc.includes('meets');
---

<span class:list={['company-logo', { 'company-logo--metro': isMetro, 'company-logo--meets': isMeets }]} aria-hidden="true">
  <img src={withBase(src)} alt="" />
</span>

<style>
  .company-logo {
    display: inline-grid;
    width: 1.75rem;
    height: 1.75rem;
    aspect-ratio: 1 / 1;
    flex: 0 0 1.75rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-border) 80%, #b9ccdf 20%);
    border-radius: .38rem;
    background:
      radial-gradient(circle at 24% 18%, rgba(255,255,255,.96), rgba(255,255,255,.54) 36%, transparent 66%),
      linear-gradient(145deg, #ffffff 0%, #edf4fa 58%, #dce7f0 100%);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.82),
      0 5px 14px rgba(64,82,101,.13);
    vertical-align: middle;
  }

  .company-logo--meets {
    border-color: #c8e8f6;
    background:
      radial-gradient(circle at 20% 18%, rgba(255,255,255,.98), rgba(255,255,255,.42) 38%, transparent 66%),
      linear-gradient(145deg, #ffffff 0%, #edfaff 48%, #d8f1fb 100%);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.9),
      0 5px 14px rgba(43,161,207,.16);
  }

  .company-logo--metro {
    border-color: #174536;
    background:
      radial-gradient(circle at 22% 18%, rgba(70,255,187,.16), transparent 48%),
      linear-gradient(145deg, #050505 0%, #0a1411 52%, #123227 100%);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.08),
      0 5px 14px rgba(18,137,91,.2);
  }

  .company-logo img {
    display: block;
    width: 100% !important;
    height: 100% !important;
    padding: .16rem;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    object-fit: contain;
    object-position: center;
    box-sizing: border-box;
  }

  .company-logo--metro img {
    padding: .1rem;
  }
</style>
