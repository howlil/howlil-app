---
interface Props {
  company: string;
  position: string;
  period: string;
  logo: string;
  companyDescription?: string;
  points?: string[];
  technologies?: string[];
}

import CompanyLogo from './CompanyLogo.astro';

const { company, position, period, logo, companyDescription, points = [], technologies = [] } = Astro.props;
---

<article class="border-t border-gray-200 py-6 first:border-t-0 sm:py-7">
  <header class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_10rem] sm:gap-6">
    <div>
      <h3 class="about-company-title"><CompanyLogo src={logo} />{company}</h3>
      <p class="mt-1 text-[15px] leading-6 text-gray-600">{position}</p>
    </div>
    <p class="font-mono text-[10px] leading-5 text-gray-500 sm:text-right">{period}</p>
  </header>

  {companyDescription && <p class="mt-4 max-w-[66ch] text-[15px] leading-6 text-gray-600">{companyDescription}</p>}

  {points.length > 0 && (
    <ul class="mt-4 max-w-[66ch] space-y-2.5" aria-label={`${company} highlights`}>
      {points.map((point) => (
        <li class="grid grid-cols-[1rem_minmax(0,1fr)] gap-2 text-[15px] leading-6 text-gray-600">
          <span class="font-mono text-[10px] text-gray-400" aria-hidden="true">—</span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
  )}

  {technologies.length > 0 && (
    <p class="mt-5 max-w-[66ch] text-[12px] leading-5 text-gray-500">
      <span class="font-mono text-[10px] uppercase tracking-[0.04em]">Tools</span>
      <span class="mx-2" aria-hidden="true">·</span>
      {technologies.join(' · ')}
    </p>
  )}
</article>
