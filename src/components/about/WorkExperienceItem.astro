---
interface Props {
  company: string;
  position: string;
  period: string;
  companyDescription?: string;
  points?: string[];
  technologies?: string[];
}

const { company, position, period, companyDescription, points = [], technologies = [] } = Astro.props;
const hasBody = Boolean(companyDescription) || points.length > 0 || technologies.length > 0;
---

{hasBody ? (
  <details class="group border-b border-gray-200 py-3 last:border-b-0" open>
    <summary class="cursor-pointer list-none rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2">
      <span class="grid gap-1 sm:grid-cols-[minmax(0,1fr)_minmax(10rem,0.7fr)_7rem] sm:gap-x-5">
        <span class="text-sm font-semibold text-gray-900">{company}</span>
        <span class="text-sm text-gray-600">{position}</span>
        <span class="flex items-center gap-2 font-mono text-[10px] text-gray-500 sm:justify-end">
          {period}
          <span class="transition-transform group-open:rotate-90" aria-hidden="true">›</span>
        </span>
      </span>
    </summary>
    <div class="mt-3 space-y-3">
      {companyDescription && <p class="text-sm leading-6 text-gray-600">{companyDescription}</p>}
      {points.length > 0 && (
        <ul class="space-y-1.5">
          {points.map((point) => (
            <li class="flex items-start gap-2 text-sm leading-6 text-gray-600">
              <span class="mt-0.5 flex-shrink-0 font-mono text-[10px] text-gray-400" aria-hidden="true">-</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      )}
      {technologies.length > 0 && (
        <div class="flex flex-wrap gap-1.5" role="list" aria-label="Technologies used">
          {technologies.map((tech) => (
            <span class="ui-chip ui-chip-interactive" role="listitem">{tech}</span>
          ))}
        </div>
      )}
    </div>
  </details>
) : (
  <div class="grid gap-1 border-b border-gray-200 py-3 last:border-b-0 sm:grid-cols-[minmax(0,1fr)_minmax(10rem,0.7fr)_7rem] sm:gap-x-5">
    <h3 class="text-sm font-semibold text-gray-900">{company}</h3>
    <p class="text-sm text-gray-600">{position}</p>
    <p class="font-mono text-[10px] text-gray-500 sm:text-right">{period}</p>
  </div>
)}
