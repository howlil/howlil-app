---
import { ArrowUpRight, Code2 } from 'lucide-react';
import { withBase } from '../../lib/paths';

const cardStyle = '--card-glow:#0ea5e9;--card-start:#38bdf8;--card-end:#0284c7;background:radial-gradient(circle at 50% 34%,color-mix(in srgb,var(--card-glow) 34%,transparent) 0%,color-mix(in srgb,var(--card-glow) 14%,transparent) 38%,transparent 64%),linear-gradient(180deg,color-mix(in srgb,var(--color-surface-muted) 86%,var(--card-glow) 14%) 0%,var(--color-surface-muted) 72%)';
const iconStyle = 'background:linear-gradient(145deg,var(--card-start) 0%,var(--card-end) 100%);color:#fff;box-shadow:inset 0 1px 0 rgba(255,255,255,.28),0 22px 50px color-mix(in srgb,var(--card-glow) 38%,transparent),0 9px 24px rgba(0,0,0,.18)';
---

<a href={withBase('/projects')} class="project-card" data-tone="2" style={cardStyle}>
  <div class="project-card-meta">
    <span>Archive</span>
    <span class="inline-flex items-center gap-1">
      All projects <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" />
    </span>
  </div>

  <div class="project-art" aria-hidden="true">
    <span class="project-art-icon" style={iconStyle}>
      <Code2 size={68} strokeWidth={1.5} />
    </span>
  </div>

  <div class="project-card-body">
    <h3>All Projects</h3>
    <p>Browse the full archive of case studies and engineering work.</p>
  </div>
</a>
