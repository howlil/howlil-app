---
import {
  ArrowUpRight,
  BarChart3,
  BookOpen,
  Briefcase,
  Cloud,
  Code2,
  CreditCard,
  FileText,
} from 'lucide-react';
import { withBase } from '../../lib/paths';
import {
  getProjectSummary,
  getProjectVisual,
  getProjectYear,
  type ProjectEntry,
  type ProjectVisualIcon,
} from './model';

interface Props {
  project: ProjectEntry;
  index: number;
}

const { project, index } = Astro.props;
const visual = getProjectVisual(project, index);
const iconByName: Record<ProjectVisualIcon, typeof Code2> = {
  code: Code2,
  document: FileText,
  notes: BookOpen,
  work: Briefcase,
  payment: CreditCard,
  analytics: BarChart3,
  cloud: Cloud,
};
const Icon = iconByName[visual.icon];
const palette = [
  { glow: '#7c3aed', start: '#9b5cff', end: '#6d28d9' },
  { glow: '#0ea5e9', start: '#38bdf8', end: '#0284c7' },
  { glow: '#f43f5e', start: '#fb7185', end: '#e11d48' },
][visual.tone - 1];
const cardStyle = `--card-glow:${palette.glow};--card-start:${palette.start};--card-end:${palette.end};background:radial-gradient(circle at 50% 34%,color-mix(in srgb,var(--card-glow) 34%,transparent) 0%,color-mix(in srgb,var(--card-glow) 14%,transparent) 38%,transparent 64%),linear-gradient(180deg,color-mix(in srgb,var(--color-surface-muted) 86%,var(--card-glow) 14%) 0%,var(--color-surface-muted) 72%)`;
const iconStyle = 'background:linear-gradient(145deg,var(--card-start) 0%,var(--card-end) 100%);color:#fff;box-shadow:inset 0 1px 0 rgba(255,255,255,.28),0 22px 50px color-mix(in srgb,var(--card-glow) 38%,transparent),0 9px 24px rgba(0,0,0,.18)';
---

<a
  href={withBase(`/projects/${project.slug}`)}
  class="project-card"
  data-tone={String(visual.tone)}
  style={cardStyle}
>
  <div class="project-card-meta">
    <span>{getProjectYear(project)}</span>
    <span class="inline-flex items-center gap-1">
      Case study <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" />
    </span>
  </div>

  <div class="project-art" aria-hidden="true">
    <span class="project-art-icon" style={iconStyle}>
      <Icon size={68} strokeWidth={1.5} />
    </span>
  </div>

  <div class="project-card-body">
    <h3>{project.data.title}</h3>
    <p>{getProjectSummary(project)}</p>
  </div>
</a>
