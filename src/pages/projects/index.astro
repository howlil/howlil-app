---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectShowcase from "../../components/content/ProjectShowcase.astro";
import ProjectListItem from "../../components/content/ProjectListItem.astro";
import { sortByDateDesc } from "../../utils/collectionHelpers";
import { withBase } from "../../lib/paths";
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedByDate = sortByDateDesc(projects);
const featuredProjects = sortedByDate
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const featuredSlugs = new Set(featuredProjects.map((project) => project.slug));
const moreProjects = sortedByDate.filter((project) => !featuredSlugs.has(project.slug));
const yearOf = (date: string) => date.slice(0, 4);
---

<BaseLayout
  title="Work - Mhd Ulil Abshar"
  description="Backend, infrastructure, and product engineering work by Mhd Ulil Abshar."
>
  <main id="main-content" class="site-ui pb-20 pt-[92px]">
    <div class="site-shell">
      <header class="max-w-3xl pb-12 pt-5">
        <p class="eyebrow">Work</p>
        <h1 class="mt-4 max-w-[14ch] text-[40px] font-semibold leading-[1.02] tracking-[-0.05em] text-gray-900 sm:text-[48px]">Building clarity into complex systems.</h1>
        <p class="mt-5 max-w-2xl text-[16px] leading-7 text-gray-600">
          Selected backend and infrastructure work presented as product case studies: the constraint, the decision, and what changed as a result.
        </p>
      </header>

      {featuredProjects.length > 0 && (
        <section class="border-t border-gray-200 py-10" aria-labelledby="selected-work-heading">
          <div>
            <p class="eyebrow">Featured case studies</p>
            <h2 id="selected-work-heading" class="mt-2 text-[27px] font-semibold tracking-[-0.04em] text-gray-900">A few systems worth going deeper on.</h2>
          </div>
          <div class="mt-3 divide-y divide-gray-200">
            {featuredProjects.map((project, index) => (
              <ProjectShowcase
                href={withBase(`/projects/${project.slug}`)}
                title={project.data.title}
                summary={project.data.summary ?? project.data.excerpt}
                date={yearOf(project.data.date)}
                index={index}
                role={project.data.role}
                engineeringFocus={project.data.engineeringFocus}
                tags={project.data.tags}
                repository={project.data.repository}
                caseStudySummary={project.data.caseStudySummary}
              />
            ))}
          </div>
        </section>
      )}

      {moreProjects.length > 0 && (
        <section class="border-t border-gray-200 py-10" aria-labelledby="archive-heading">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow">More work</p>
              <h2 id="archive-heading" class="mt-2 text-[25px] font-semibold tracking-[-0.035em] text-gray-900">Additional shipped systems.</h2>
            </div>
            <p class="text-xs text-gray-500">{moreProjects.length} projects</p>
          </div>
          <div class="mt-6 grid gap-3 md:grid-cols-2">
            {moreProjects.map((project) => (
              <ProjectListItem
                href={withBase(`/projects/${project.slug}`)}
                title={project.data.title}
                excerpt={project.data.excerpt}
                date={yearOf(project.data.date)}
                role={project.data.role}
                engineeringFocus={project.data.engineeringFocus}
                tags={project.data.tags}
                repository={project.data.repository}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
</BaseLayout>
