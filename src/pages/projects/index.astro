---
export const prerender = true;

import ThreeColumnLayout from "../../layouts/ThreeColumnLayout.astro";
import TagFilter from "../../components/content/TagFilter.astro";
import ProjectListItem from "../../components/content/ProjectListItem.astro";
import { getProjectTypeLabel } from "../../constants/projectTypes";
import { sortByDateDesc } from "../../utils/collectionHelpers";
import { withBase } from "../../lib/paths";
import { getCollection, type CollectionEntry } from 'astro:content';

const projects = await getCollection('projects');
const sortedByDate = sortByDateDesc(projects);
const featuredProjects = sortedByDate
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const otherProjects = sortedByDate.filter((project) => !project.data.featured);
const sortedProjects = [...featuredProjects, ...otherProjects];

const typeCounts = new Map<string, number>();
projects.forEach((project) => {
  const label = getProjectTypeLabel(project.data.type);
  typeCounts.set(label, (typeCounts.get(label) || 0) + 1);
});

const typeFilters = Array.from(typeCounts.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);

function getFilterValue(project: CollectionEntry<'projects'>) {
  const typeLabel = getProjectTypeLabel(project.data.type);
  return [typeLabel, ...project.data.tags, ...project.data.engineeringFocus].join(',');
}
---

<ThreeColumnLayout
  title="Work - Mhd Ulil Abshar"
  headerTitle="Work"
  headerDescription=""
>
  <div slot="content" id="projects-content">
    <div data-filter-banner class="site-ui hidden mb-4 border-y border-gray-200 py-3 text-sm text-gray-700">
      <span>Showing work with </span>
      <span data-filter-label class="font-semibold"></span>
      <button type="button" data-filter-clear class="ml-2 min-h-8 underline underline-offset-2">Clear</button>
    </div>

    <div class="border-t border-gray-200" id="projects-list">
      {sortedProjects.map((project) => (
        <ProjectListItem
          href={withBase(`/projects/${project.slug}`)}
          title={project.data.title}
          typeLabel={getProjectTypeLabel(project.data.type)}
          excerpt={project.data.excerpt}
          focus={project.data.engineeringFocus.length > 0 ? project.data.engineeringFocus : project.data.tags}
          date={project.data.date}
          filterValue={getFilterValue(project)}
        />
      ))}
    </div>

    <p data-filter-empty class="hidden py-8 text-sm text-gray-600" role="status">No projects match this filter.</p>
  </div>

  <TagFilter slot="sidebar" tags={typeFilters} title="Category" showHash={false} />
</ThreeColumnLayout>
