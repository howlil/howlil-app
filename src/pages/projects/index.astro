---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectListItem from "../../components/content/ProjectListItem.astro";
import { sortByDateDesc } from "../../utils/collectionHelpers";
import { withBase } from "../../lib/paths";
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedByDate = sortByDateDesc(projects);
const featuredProjects = sortedByDate
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const featuredSlugs = new Set(featuredProjects.map((project) => project.slug));
const moreProjects = sortedByDate.filter((project) => !featuredSlugs.has(project.slug));
const yearOf = (date: string) => date.slice(0, 4);
---

<BaseLayout
  title="Work - Mhd Ulil Abshar"
  description="Backend, infrastructure, and product engineering work by Mhd Ulil Abshar."
>
  <main id="main-content" class="site-ui pb-14 pt-[72px]">
    <div class="site-shell">
      <header class="grid gap-5 border-b-2 border-gray-900 pb-7 pt-3 md:grid-cols-[8rem_minmax(0,1fr)] md:gap-x-8">
        <p class="swiss-label"><span class="swiss-index">00</span> / WORK</p>
        <div>
          <h1 class="text-[28px] font-semibold leading-[1.08] tracking-[-0.032em] text-gray-900 sm:text-[32px]">Engineering work</h1>
          <p class="reading-column mt-3 text-sm leading-6 text-gray-600">
            Backend and infrastructure systems, organized around the problem solved, ownership boundary, and implementation trade-offs.
          </p>
        </div>
      </header>

      {featuredProjects.length > 0 && (
        <section class="grid gap-5 border-b border-gray-300 py-7 md:grid-cols-[8rem_minmax(0,1fr)] md:gap-x-8" aria-labelledby="selected-work-heading">
          <h2 id="selected-work-heading" class="swiss-label"><span class="swiss-index">01</span> / SELECTED</h2>
          <div class="border-t border-gray-300">
            {featuredProjects.map((project) => (
              <ProjectListItem
                href={withBase(`/projects/${project.slug}`)}
                title={project.data.title}
                excerpt={project.data.summary ?? project.data.excerpt}
                date={yearOf(project.data.date)}
                role={project.data.role}
                engineeringFocus={project.data.engineeringFocus}
                tags={project.data.tags}
                repository={project.data.repository}
              />
            ))}
          </div>
        </section>
      )}

      {moreProjects.length > 0 && (
        <section class="grid gap-5 py-7 md:grid-cols-[8rem_minmax(0,1fr)] md:gap-x-8" aria-labelledby="archive-heading">
          <h2 id="archive-heading" class="swiss-label"><span class="swiss-index">02</span> / ARCHIVE</h2>
          <div class="border-t border-gray-300">
            {moreProjects.map((project) => (
              <ProjectListItem
                href={withBase(`/projects/${project.slug}`)}
                title={project.data.title}
                excerpt={project.data.excerpt}
                date={yearOf(project.data.date)}
                role={project.data.role}
                engineeringFocus={project.data.engineeringFocus}
                tags={project.data.tags}
                repository={project.data.repository}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
</BaseLayout>
