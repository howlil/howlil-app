---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectListItem from "../../components/content/ProjectListItem.astro";
import { sortByDateDesc } from "../../utils/collectionHelpers";
import { withBase } from "../../lib/paths";
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedByDate = sortByDateDesc(projects);
const featuredProjects = sortedByDate
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999))
  .slice(0, 3);
const flagshipProject = featuredProjects[0];
const supportingFeatured = featuredProjects.slice(1);
const featuredSlugs = new Set(featuredProjects.map((project) => project.slug));
const moreProjects = sortedByDate.filter((project) => !featuredSlugs.has(project.slug));
const yearOf = (date: string) => date.slice(0, 4);
---

<BaseLayout
  title="Work - Mhd Ulil Abshar"
  description="Selected backend, infrastructure, and product engineering work by Mhd Ulil Abshar."
>
  <main id="main-content" class="site-ui pb-20 pt-28">
    <div class="site-shell">
      <header class="grid gap-8 border-b border-gray-300 pb-12 lg:grid-cols-12 lg:gap-x-10 lg:pb-16">
        <div class="lg:col-span-3">
          <p class="font-mono text-xs text-gray-500">WORK / SELECTED SYSTEMS</p>
        </div>
        <div class="lg:col-span-9">
          <h1 class="max-w-4xl text-5xl font-bold leading-[0.98] tracking-[-0.05em] text-gray-900 sm:text-6xl lg:text-7xl">
            Engineering work shaped by constraints, not screenshots.
          </h1>
          <p class="mt-6 max-w-2xl text-base leading-7 text-gray-600">
            Backend and infrastructure work where state, authorization, persistence, or failure behavior materially changed the implementation.
          </p>
        </div>
      </header>

      {flagshipProject && (
        <section class="py-16 lg:py-24" aria-labelledby="flagship-work-heading">
          <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-10">
            <div class="lg:col-span-2">
              <p class="font-mono text-xs text-gray-500">01 / FLAGSHIP</p>
              <p class="mt-3 text-sm text-gray-500">{yearOf(flagshipProject.data.date)}</p>
            </div>

            <div class="lg:col-span-7">
              <h2 id="flagship-work-heading" class="text-4xl font-bold leading-[1.02] tracking-[-0.045em] text-gray-900 sm:text-5xl">
                {flagshipProject.data.title}
              </h2>
              <p class="mt-5 max-w-2xl text-lg leading-8 text-gray-600">
                {flagshipProject.data.summary ?? flagshipProject.data.excerpt}
              </p>

              {flagshipProject.data.caseStudySummary && (
                <div class="mt-9 max-w-3xl border-l border-gray-300 pl-6 sm:pl-8">
                  <p class="text-sm font-semibold text-gray-900">Decision</p>
                  <p class="mt-3 text-xl leading-8 text-gray-800">{flagshipProject.data.caseStudySummary.decision}</p>
                  <p class="mt-5 text-sm leading-6 text-gray-600">{flagshipProject.data.caseStudySummary.result}</p>
                </div>
              )}
            </div>

            <aside class="lg:col-span-3">
              {flagshipProject.data.role && (
                <div class="border-t border-gray-300 pt-4">
                  <p class="text-xs text-gray-500">Role</p>
                  <p class="mt-2 text-sm leading-6 text-gray-800">{flagshipProject.data.role}</p>
                </div>
              )}
              {flagshipProject.data.engineeringFocus.length > 0 && (
                <div class="mt-6 border-t border-gray-300 pt-4">
                  <p class="text-xs text-gray-500">Focus</p>
                  <p class="mt-2 text-sm leading-6 text-gray-700">{flagshipProject.data.engineeringFocus.join(' · ')}</p>
                </div>
              )}
              <a href={withBase(`/projects/${flagshipProject.slug}`)} class="mt-8 inline-block text-sm font-semibold text-gray-900 hover:underline underline-offset-4">
                Read case study
              </a>
            </aside>
          </div>
        </section>
      )}

      {supportingFeatured.length > 0 && (
        <section class="border-y border-gray-300" aria-labelledby="selected-work-heading">
          <div class="grid lg:grid-cols-12">
            <div class="py-8 lg:col-span-3 lg:pr-8">
              <h2 id="selected-work-heading" class="text-sm font-semibold text-gray-900">Selected</h2>
              <p class="mt-2 text-sm leading-6 text-gray-600">Two more systems worth opening.</p>
            </div>

            <div class="lg:col-span-9 lg:border-l lg:border-gray-300">
              {supportingFeatured.map((project, index) => (
                <a href={withBase(`/projects/${project.slug}`)} class="group grid gap-3 border-t border-gray-300 py-7 first:border-t-0 lg:grid-cols-[3rem_minmax(0,1fr)_auto] lg:gap-x-6 lg:px-8">
                  <span class="font-mono text-xs text-gray-500">{String(index + 2).padStart(2, '0')}</span>
                  <div>
                    <h3 class="text-2xl font-semibold tracking-tight text-gray-900 group-hover:underline underline-offset-4">{project.data.title}</h3>
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-600">{project.data.summary ?? project.data.excerpt}</p>
                    {project.data.engineeringFocus.length > 0 && <p class="mt-3 text-xs text-gray-500">{project.data.engineeringFocus.join(' · ')}</p>}
                  </div>
                  <span class="text-sm text-gray-500 lg:text-right">{yearOf(project.data.date)}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      {moreProjects.length > 0 && (
        <section class="pt-16" aria-labelledby="more-work-heading">
          <div class="grid gap-8 lg:grid-cols-12 lg:gap-x-10">
            <div class="lg:col-span-3">
              <h2 id="more-work-heading" class="text-sm font-semibold text-gray-900">Archive</h2>
            </div>
            <div class="border-t border-gray-300 lg:col-span-9">
              {moreProjects.map((project) => (
                <ProjectListItem
                  href={withBase(`/projects/${project.slug}`)}
                  title={project.data.title}
                  excerpt={project.data.excerpt}
                  date={yearOf(project.data.date)}
                  role={project.data.role}
                  engineeringFocus={project.data.engineeringFocus}
                />
              ))}
            </div>
          </div>
        </section>
      )}
    </div>
  </main>
</BaseLayout>
