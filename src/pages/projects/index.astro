---
export const prerender = true;

import ThreeColumnLayout from "../../layouts/ThreeColumnLayout.astro";
import { TagFilter, ContentListCard } from "../../components/content";
import { getProjectTypeLabel } from "../../constants/projectTypes";
import { sortByDateDesc } from "../../utils/collectionHelpers";
import { withBase } from "../../lib/paths";
import { getCollection, type CollectionEntry } from 'astro:content';

const projects = await getCollection('projects');
const sortedProjects = sortByDateDesc(projects);

const typeCounts = new Map<string, number>();
projects.forEach((project) => {
  const label = getProjectTypeLabel(project.data.type);
  typeCounts.set(label, (typeCounts.get(label) || 0) + 1);
});

const typeFilters = Array.from(typeCounts.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);

function getFilterValue(project: CollectionEntry<'projects'>) {
  const typeLabel = getProjectTypeLabel(project.data.type);
  return [typeLabel, ...project.data.tags].join(',');
}
---

<ThreeColumnLayout
  title="Projects - Portfolio"
  headerTitle="I like building things"
  headerDescription="A collection of projects I've built—from work and academic to hackathon. Each project represents a unique challenge solved with code, creativity, and collaboration."
>
  <div slot="content" id="projects-content">
    <div id="tag-filter-banner" class="hidden mb-4 py-2 px-3 rounded-lg border border-gray-200 bg-gray-50 text-sm text-gray-700">
      <span>Showing projects with </span>
      <span id="tag-filter-value" class="font-semibold"></span>
      <a href={withBase("/projects")} id="tag-filter-clear" class="ml-2 text-gray-600 hover:text-gray-900 underline">Clear</a>
    </div>
    <div class="border-t border-gray-400/40" id="projects-list">
      {sortedProjects.map((project) => (
        <ContentListCard
          href={withBase(`/projects/${project.slug}`)}
          title={project.data.title}
          subtitle={getProjectTypeLabel(project.data.type)}
          excerpt={project.data.excerpt}
          tags={project.data.tags}
          date={project.data.date}
          filterValue={getFilterValue(project)}
        />
      ))}
    </div>
    <p data-filter-empty class="hidden py-8 text-sm text-gray-600">
      No projects match this filter.
    </p>
  </div>

  <TagFilter slot="sidebar" tags={typeFilters} title="Category" showHash={false} />
</ThreeColumnLayout>

<script>
  import { matchesTag } from '../../lib/filters';

  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    const selectedTag = params.get('tag')?.trim();
    if (!selectedTag) return;

    const banner = document.getElementById('tag-filter-banner');
    const valueEl = document.getElementById('tag-filter-value');
    const list = document.getElementById('projects-list');
    const emptyState = document.querySelector<HTMLElement>('[data-filter-empty]');
    if (!banner || !valueEl || !list) return;

    const items = list.querySelectorAll<HTMLElement>('[data-tags]');
    let visible = 0;
    items.forEach((item) => {
      const itemTags = (item.dataset.tags || '').split(',').filter(Boolean);
      const match = itemTags.some((tag) => matchesTag(tag, selectedTag));
      item.style.display = match ? 'block' : 'none';
      if (match) visible += 1;
    });

    valueEl.textContent = `#${selectedTag}`;
    banner.classList.remove('hidden');
    emptyState?.classList.toggle('hidden', visible !== 0);
  });
</script>
