---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectShowcase from "../../components/content/ProjectShowcase.astro";
import ProjectListItem from "../../components/content/ProjectListItem.astro";
import { sortByDateDesc } from "../../utils/collectionHelpers";
import { withBase } from "../../lib/paths";
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedByDate = sortByDateDesc(projects);
const featuredProjects = sortedByDate
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const featuredSlugs = new Set(featuredProjects.map((project) => project.slug));
const moreProjects = sortedByDate.filter((project) => !featuredSlugs.has(project.slug));
const yearOf = (date: string) => date.slice(0, 4);
---

<BaseLayout
  title="Engineering Work - Mhd Ulil Abshar"
  description="Backend, infrastructure, payments, stateful workflow, and product engineering work by Mhd Ulil Abshar."
>
  <main id="main-content" class="site-ui pb-20 pt-[76px]">
    <div class="site-shell">
      <header class="max-w-3xl pb-10 pt-8 sm:pb-12 sm:pt-10">
        <p class="eyebrow">Engineering work</p>
        <h1 class="mt-4 text-[36px] font-semibold leading-[1.04] tracking-[-0.04em] text-gray-900 sm:text-[42px]">
          Selected systems and implementation work.
        </h1>
        <p class="mt-4 max-w-2xl text-[15px] leading-7 text-gray-600">
          Backend and infrastructure work organized for fast scanning first, with deeper constraints, decisions, failure modes, and implementation detail inside each case study.
        </p>
      </header>

      {featuredProjects.length > 0 && (
        <section class="border-t border-gray-200 py-10" aria-labelledby="selected-work-heading">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow">Selected work</p>
              <h2 id="selected-work-heading" class="mt-2 text-[25px] font-semibold tracking-[-0.03em] text-gray-900">High-signal engineering work.</h2>
            </div>
            <p class="max-w-md text-sm leading-6 text-gray-600">Ownership, technical focus, and outcome here. Full reasoning stays inside the case study.</p>
          </div>
          <div class="mt-5 border-b border-gray-200">
            {featuredProjects.map((project, index) => (
              <ProjectShowcase
                href={withBase(`/projects/${project.slug}`)}
                title={project.data.title}
                summary={project.data.summary ?? project.data.excerpt}
                date={yearOf(project.data.date)}
                index={index}
                role={project.data.role}
                engineeringFocus={project.data.engineeringFocus}
                tags={project.data.tags}
                repository={project.data.repository}
                caseStudySummary={project.data.caseStudySummary}
              />
            ))}
          </div>
        </section>
      )}

      {moreProjects.length > 0 && (
        <section class="border-t border-gray-200 py-10" aria-labelledby="archive-heading">
          <div class="flex items-end justify-between gap-5">
            <div>
              <p class="eyebrow">Additional work</p>
              <h2 id="archive-heading" class="mt-2 text-[23px] font-semibold tracking-[-0.03em] text-gray-900">More shipped systems.</h2>
            </div>
            <p class="font-mono text-[10px] text-gray-500">{moreProjects.length} projects</p>
          </div>
          <div class="mt-5 border-b border-gray-200">
            {moreProjects.map((project) => (
              <ProjectListItem
                href={withBase(`/projects/${project.slug}`)}
                title={project.data.title}
                excerpt={project.data.excerpt}
                date={yearOf(project.data.date)}
                role={project.data.role}
                engineeringFocus={project.data.engineeringFocus}
                tags={project.data.tags}
                repository={project.data.repository}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
</BaseLayout>
