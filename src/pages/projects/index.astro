---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/content/PageHeader.astro";
import ProjectCard from "../../features/projects/ProjectCard.astro";
import {
  getFeaturedProjects,
  getMoreProjects,
  getProjectYear,
} from "../../features/projects/model";
import { withBase } from "../../lib/paths";
import { getCollection } from 'astro:content';
import { Star } from "lucide-react";

const projects = await getCollection('projects');
const featuredProjects = getFeaturedProjects(projects);
const moreProjects = getMoreProjects(projects);
---

<BaseLayout
  title="Projects - Mhd Ulil Abshar"
  description="Selected engineering case studies covering backend correctness, system design, workflow, infrastructure, and product engineering by Mhd Ulil Abshar."
>
  <main id="main-content" class="index-page site-ui">
    <div class="site-shell">
      <PageHeader
        title="Projects"
        description="Selected engineering case studies: the problem, constraints, decisions, failure modes, and implementation evidence behind systems I owned."
      >
        <Star slot="icon" size={23} strokeWidth={1.7} aria-hidden="true" />
      </PageHeader>

      {featuredProjects.length > 0 && (
        <section class="index-section" aria-labelledby="selected-projects-heading">
          <h2 id="selected-projects-heading" class="portfolio-section-title"><Star size={20} strokeWidth={1.8} aria-hidden="true" /> Featured Engineering Cases</h2>
          <div class="project-dossier-list grid gap-4">
            {featuredProjects.map((project, index) => <ProjectCard project={project} index={index} variant="dossier" />)}
          </div>
        </section>
      )}

      {moreProjects.length > 0 && (
        <section class="index-section" aria-labelledby="more-projects-heading">
          <div class="index-section-heading">
            <h2 id="more-projects-heading">Additional Work</h2>
            <span>{moreProjects.length} entries</span>
          </div>
          <div class="index-list">
            {moreProjects.map((project) => (
              <a href={withBase(`/projects/${project.slug}`)} class="index-list-item">
                <time>{getProjectYear(project)}</time>
                <span>
                  <strong>{project.data.title}</strong>
                  <small>{project.data.caseStudySummary?.result ?? project.data.excerpt}</small>
                  <em>
                    {project.data.role
                      ? `${project.data.role}${project.data.engineeringFocus.length > 0 ? ' · ' : ''}`
                      : ''}
                    {project.data.engineeringFocus.length > 0
                      ? project.data.engineeringFocus.slice(0, 3).join(' · ')
                      : project.data.tags.slice(0, 5).join(' · ')}
                  </em>
                </span>
                <b aria-hidden="true">→</b>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
</BaseLayout>
