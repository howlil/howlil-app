---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectShowcase from "../../components/content/ProjectShowcase.astro";
import ProjectListItem from "../../components/content/ProjectListItem.astro";
import { sortByDateDesc } from "../../utils/collectionHelpers";
import { withBase } from "../../lib/paths";
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedByDate = sortByDateDesc(projects);
const featuredProjects = sortedByDate
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const featuredSlugs = new Set(featuredProjects.map((project) => project.slug));
const moreProjects = sortedByDate.filter((project) => !featuredSlugs.has(project.slug));
const yearOf = (date: string) => date.slice(0, 4);
---

<BaseLayout
  title="Engineering Work - Mhd Ulil Abshar"
  description="Backend, infrastructure, payments, stateful workflow, and product engineering work by Mhd Ulil Abshar."
>
  <main id="main-content" class="site-ui">
    <div class="site-shell">
      <header class="frame-section border-b border-gray-200 py-10 sm:py-12">
        <p class="eyebrow">02 / Engineering work</p>
        <h1 class="mt-4 max-w-[18ch] text-[35px] font-semibold leading-[1.04] tracking-[-0.045em] text-gray-900 sm:text-[42px]">
          Systems, ownership, and implementation evidence.
        </h1>
        <p class="mt-4 max-w-2xl text-[15px] leading-7 text-gray-600">
          Scan the system and engineering focus here. Open a case study for constraints, state decisions, failure modes, implementation detail, and limitations.
        </p>
      </header>

      {featuredProjects.length > 0 && (
        <section class="frame-section border-b border-gray-200 py-10" aria-labelledby="selected-work-heading">
          <div class="grid gap-4 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-10">
            <div>
              <p class="eyebrow">Selected work</p>
              <h2 id="selected-work-heading" class="mt-2 text-[24px] font-semibold tracking-[-0.03em] text-gray-900">High-signal systems.</h2>
            </div>
            <p class="max-w-xl text-sm leading-6 text-gray-600">Featured work is ordered by relevance, not visual presentation. Each row exposes enough evidence to decide whether the deeper case study is worth opening.</p>
          </div>
          <div class="mt-6 border-y border-gray-200">
            {featuredProjects.map((project, index) => (
              <ProjectShowcase
                href={withBase(`/projects/${project.slug}`)}
                title={project.data.title}
                summary={project.data.summary ?? project.data.excerpt}
                date={yearOf(project.data.date)}
                index={index}
                role={project.data.role}
                engineeringFocus={project.data.engineeringFocus}
                tags={project.data.tags}
                repository={project.data.repository}
                caseStudySummary={project.data.caseStudySummary}
              />
            ))}
          </div>
        </section>
      )}

      {moreProjects.length > 0 && (
        <section class="frame-section py-10" aria-labelledby="archive-heading">
          <div class="grid gap-4 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-10">
            <div>
              <p class="eyebrow">Archive</p>
              <h2 id="archive-heading" class="mt-2 text-[23px] font-semibold tracking-[-0.03em] text-gray-900">Additional shipped work.</h2>
            </div>
            <p class="font-mono text-[10px] text-gray-500 md:self-end">{moreProjects.length} projects</p>
          </div>
          <div class="mt-6 border-y border-gray-200">
            {moreProjects.map((project) => (
              <ProjectListItem
                href={withBase(`/projects/${project.slug}`)}
                title={project.data.title}
                excerpt={project.data.excerpt}
                date={yearOf(project.data.date)}
                role={project.data.role}
                engineeringFocus={project.data.engineeringFocus}
                tags={project.data.tags}
                repository={project.data.repository}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
</BaseLayout>
