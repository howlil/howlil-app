---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectListItem from "../../components/content/ProjectListItem.astro";
import { sortByDateDesc } from "../../utils/collectionHelpers";
import { withBase } from "../../lib/paths";
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedByDate = sortByDateDesc(projects);
const featuredProjects = sortedByDate
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const featuredSlugs = new Set(featuredProjects.map((project) => project.slug));
const moreProjects = sortedByDate.filter((project) => !featuredSlugs.has(project.slug));
const yearOf = (date: string) => date.slice(0, 4);
---

<BaseLayout
  title="Work - Mhd Ulil Abshar"
  description="Backend, infrastructure, and product engineering work by Mhd Ulil Abshar."
>
  <main id="main-content" class="site-ui pb-16 pt-[84px]">
    <div class="site-shell">
      <header class="border-b border-gray-300 pb-8">
        <p class="font-mono text-[11px] text-gray-500">WORK</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-[-0.03em] text-gray-900 sm:text-4xl">Engineering work</h1>
        <p class="mt-4 max-w-2xl text-[15px] leading-7 text-gray-600">
          Backend and infrastructure systems, organized around the problem solved, ownership boundary, and implementation trade-offs.
        </p>
      </header>

      {featuredProjects.length > 0 && (
        <section class="border-b border-gray-300" aria-labelledby="selected-work-heading">
          <div class="border-b border-gray-300 py-4">
            <h2 id="selected-work-heading" class="font-mono text-[11px] font-semibold uppercase tracking-[0.08em] text-gray-700">Selected</h2>
          </div>

          <div>
            {featuredProjects.map((project) => (
              <ProjectListItem
                href={withBase(`/projects/${project.slug}`)}
                title={project.data.title}
                excerpt={project.data.summary ?? project.data.excerpt}
                date={yearOf(project.data.date)}
                role={project.data.role}
                engineeringFocus={project.data.engineeringFocus}
                tags={project.data.tags}
                repository={project.data.repository}
              />
            ))}
          </div>
        </section>
      )}

      {moreProjects.length > 0 && (
        <section aria-labelledby="archive-heading">
          <div class="border-b border-gray-300 py-4">
            <h2 id="archive-heading" class="font-mono text-[11px] font-semibold uppercase tracking-[0.08em] text-gray-700">Archive</h2>
          </div>

          <div>
            {moreProjects.map((project) => (
              <ProjectListItem
                href={withBase(`/projects/${project.slug}`)}
                title={project.data.title}
                excerpt={project.data.excerpt}
                date={yearOf(project.data.date)}
                role={project.data.role}
                engineeringFocus={project.data.engineeringFocus}
                tags={project.data.tags}
                repository={project.data.repository}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
</BaseLayout>
