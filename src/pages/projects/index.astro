---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectShowcase from "../../components/content/ProjectShowcase.astro";
import ProjectListItem from "../../components/content/ProjectListItem.astro";
import { sortByDateDesc } from "../../utils/collectionHelpers";
import { withBase } from "../../lib/paths";
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedByDate = sortByDateDesc(projects);
const featuredProjects = sortedByDate
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const featuredSlugs = new Set(featuredProjects.map((project) => project.slug));
const moreProjects = sortedByDate.filter((project) => !featuredSlugs.has(project.slug));
const yearOf = (date: string) => date.slice(0, 4);
---

<BaseLayout
  title="Projects - Mhd Ulil Abshar"
  description="Selected backend, infrastructure, payments, data workflow, and product engineering projects by Mhd Ulil Abshar."
>
  <main id="main-content" class="site-ui">
    <div class="site-shell">
      <header class="frame-section border-b border-gray-200 py-10 sm:py-12">
        <p class="eyebrow">02 / Projects</p>
        <h1 class="page-title mt-3">Projects</h1>
        <p class="page-lede mt-4">
          A curated set of systems I’ve built across backend, infrastructure, payments, data workflows, and product engineering. Open a project for the constraints, decisions, failure modes, and implementation details.
        </p>
      </header>

      {featuredProjects.length > 0 && (
        <section class="frame-section border-b border-gray-200 py-10 sm:py-11" aria-labelledby="selected-projects-heading">
          <div class="max-w-[60ch]">
            <p class="eyebrow">Selected projects</p>
            <h2 id="selected-projects-heading" class="mt-2 text-[25px] font-semibold leading-tight tracking-[-0.035em] text-gray-900">The systems that best represent how I approach engineering.</h2>
          </div>
          <div class="mt-6 border-y border-gray-200">
            {featuredProjects.map((project, index) => (
              <ProjectShowcase
                href={withBase(`/projects/${project.slug}`)}
                title={project.data.title}
                summary={project.data.summary ?? project.data.excerpt}
                date={yearOf(project.data.date)}
                index={index}
                role={project.data.role}
                engineeringFocus={project.data.engineeringFocus}
                tags={project.data.tags}
                repository={project.data.repository}
                caseStudySummary={project.data.caseStudySummary}
              />
            ))}
          </div>
        </section>
      )}

      {moreProjects.length > 0 && (
        <section class="frame-section py-10 sm:py-11" aria-labelledby="more-projects-heading">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow">More projects</p>
              <h2 id="more-projects-heading" class="mt-2 text-[24px] font-semibold tracking-[-0.03em] text-gray-900">Additional shipped and experimental systems.</h2>
            </div>
            <p class="font-mono text-[10px] text-gray-500">{moreProjects.length} projects</p>
          </div>
          <div class="mt-6 border-y border-gray-200">
            {moreProjects.map((project) => (
              <ProjectListItem
                href={withBase(`/projects/${project.slug}`)}
                title={project.data.title}
                excerpt={project.data.excerpt}
                date={yearOf(project.data.date)}
                role={project.data.role}
                engineeringFocus={project.data.engineeringFocus}
                tags={project.data.tags}
                repository={project.data.repository}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
</BaseLayout>
