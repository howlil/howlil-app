---
export const prerender = true;

import ThreeColumnLayout from "../../layouts/ThreeColumnLayout.astro";
import { TagFilter, ContentListCard } from "../../components/content";
import { getProjectTypeLabel } from "../../constants/projectTypes";
import { sortByDateDesc } from "../../utils/collectionHelpers";
import { withBase } from "../../lib/paths";
import { getCollection, type CollectionEntry } from 'astro:content';

const projects = await getCollection('projects');
const sortedByDate = sortByDateDesc(projects);
const featuredProjects = sortedByDate
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const otherProjects = sortedByDate.filter((project) => !project.data.featured);
const sortedProjects = [...featuredProjects, ...otherProjects];

const typeCounts = new Map<string, number>();
projects.forEach((project) => {
  const label = getProjectTypeLabel(project.data.type);
  typeCounts.set(label, (typeCounts.get(label) || 0) + 1);
});

const typeFilters = Array.from(typeCounts.entries())
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);

function getFilterValue(project: CollectionEntry<'projects'>) {
  const typeLabel = getProjectTypeLabel(project.data.type);
  return [typeLabel, ...project.data.tags].join(',');
}
---

<ThreeColumnLayout
  title="Engineering Work - Mhd Ulil Abshar"
  headerTitle="Engineering work"
  headerDescription="Featured systems come first: projects where architecture, state, failure modes, and engineering trade-offs are documented explicitly. The rest remain as an archive of shipped work, academic systems, and experiments."
>
  <div slot="content" id="projects-content">
    <div data-filter-banner class="hidden mb-4 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-700">
      <span>Showing projects with </span>
      <span data-filter-label class="font-semibold"></span>
      <button type="button" data-filter-clear class="ml-2 min-h-8 underline underline-offset-2">
        Clear
      </button>
    </div>

    <div class="border-t border-gray-400/40" id="projects-list">
      {sortedProjects.map((project) => (
        <div class={project.data.featured ? 'relative' : undefined}>
          {project.data.featured && (
            <span class="absolute right-0 top-4 z-10 font-mono text-[10px] uppercase tracking-[0.14em] text-gray-500 pointer-events-none">
              Featured system
            </span>
          )}
          <ContentListCard
            href={withBase(`/projects/${project.slug}`)}
            title={project.data.title}
            subtitle={getProjectTypeLabel(project.data.type)}
            excerpt={project.data.excerpt}
            tags={project.data.engineeringFocus.length > 0 ? project.data.engineeringFocus : project.data.tags}
            date={project.data.date}
            filterValue={getFilterValue(project)}
          />
        </div>
      ))}
    </div>

    <p data-filter-empty class="hidden py-8 text-sm text-gray-600" role="status">
      No projects match this filter.
    </p>
  </div>

  <TagFilter slot="sidebar" tags={typeFilters} title="Category" showHash={false} />
</ThreeColumnLayout>
