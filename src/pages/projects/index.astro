---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/content/PageHeader.astro";
import { sortByDateDesc } from "../../utils/collectionHelpers";
import { withBase } from "../../lib/paths";
import { getCollection } from 'astro:content';
import { BarChart3, Cloud, CreditCard, Star } from "lucide-react";

const projects = await getCollection('projects');
const sortedByDate = sortByDateDesc(projects);
const featuredProjects = sortedByDate
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const featuredSlugs = new Set(featuredProjects.map((project) => project.slug));
const moreProjects = sortedByDate.filter((project) => !featuredSlugs.has(project.slug));
const yearOf = (date: string) => date.slice(0, 4);
const projectIcon = (index: number) => index % 3;
---

<BaseLayout
  title="Projects - Mhd Ulil Abshar"
  description="Selected backend, infrastructure, payments, data workflow, and product engineering projects by Mhd Ulil Abshar."
>
  <main id="main-content" class="index-page site-ui">
    <div class="site-shell">
      <PageHeader
        title="Projects"
        description="Case studies about backend systems, infrastructure, payments, and product engineering—with the constraints and failure modes left in."
      >
        <Star slot="icon" size={23} strokeWidth={1.7} aria-hidden="true" />
      </PageHeader>

      {featuredProjects.length > 0 && (
        <section class="index-section" aria-labelledby="selected-projects-heading">
          <h2 id="selected-projects-heading" class="portfolio-section-title"><Star size={20} strokeWidth={1.8} aria-hidden="true" /> Selected Projects</h2>
          <div class="project-grid">
            {featuredProjects.map((project, index) => (
              <a href={withBase(`/projects/${project.slug}`)} class="project-card" data-tone={String(projectIcon(index) + 1)}>
                <div class="project-card-meta"><span>{yearOf(project.data.date)}</span><span>Case study ↗</span></div>
                <div class="project-art" aria-hidden="true">
                  <span class="project-art-icon">
                    {projectIcon(index) === 0 ? <CreditCard size={68} strokeWidth={1.5} /> : projectIcon(index) === 1 ? <BarChart3 size={68} strokeWidth={1.5} /> : <Cloud size={68} strokeWidth={1.5} />}
                  </span>
                </div>
                <div class="project-card-body">
                  <h3>{project.data.title}</h3>
                  <p>{project.data.summary ?? project.data.excerpt}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {moreProjects.length > 0 && (
        <section class="index-section" aria-labelledby="more-projects-heading">
          <div class="index-section-heading">
            <h2 id="more-projects-heading">More Projects</h2>
            <span>{moreProjects.length} entries</span>
          </div>
          <div class="index-list">
            {moreProjects.map((project) => (
              <a href={withBase(`/projects/${project.slug}`)} class="index-list-item">
                <time>{yearOf(project.data.date)}</time>
                <span>
                  <strong>{project.data.title}</strong>
                  <small>{project.data.excerpt}</small>
                  <em>{project.data.tags.slice(0, 5).join(" · ")}</em>
                </span>
                <b aria-hidden="true">→</b>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
</BaseLayout>
