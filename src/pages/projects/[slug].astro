---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { ImageSlider } from "../../components/interactive";
import { withBase } from "../../lib/paths";
import { resolveProjectMedia } from "../../lib/media";
import { getCollection, type CollectionEntry } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as {project: CollectionEntry<'projects'>};
const { Content } = await project.render();
const coverImages = project.data.coverImages?.map((image) => withBase(image));
const coverMedia = project.data.coverVideo ? resolveProjectMedia(project.data.coverVideo) : undefined;
const coverMediaSrc = coverMedia?.kind === 'video' && coverMedia.src.startsWith('/')
  ? withBase(coverMedia.src)
  : coverMedia?.src;
const caseStudySummary = project.data.caseStudySummary;
const hasProjectBrief = Boolean(
  project.data.role || project.data.engineeringFocus.length > 0 || project.data.tags.length > 0,
);
---

<ArticleLayout
  title={`${project.data.title} - Engineering Case Study`}
  description={project.data.summary ?? project.data.excerpt}
  image={project.data.coverImages?.[0]}
  articleTitle={project.data.title}
  date={project.data.date}
  backHref={withBase("/projects")}
  backLabel="Back to Work"
  contentVariant="technical"
>
  <div slot="meta" class="site-ui mt-4">
    <p class="max-w-2xl text-[15px] leading-7 text-gray-600">
      {project.data.summary ?? project.data.excerpt}
    </p>
  </div>

  <Fragment slot="actions">
    {project.data.liveSite && (
      <a href={project.data.liveSite} target="_blank" rel="noopener noreferrer" class="ui-action">Live site ↗</a>
    )}
    {project.data.repository && (
      <a href={project.data.repository} target="_blank" rel="noopener noreferrer" class="ui-action">Repository ↗</a>
    )}
    {project.data.videoDemo && (
      <a href={project.data.videoDemo} target="_blank" rel="noopener noreferrer" class="ui-action">Video demo ↗</a>
    )}
  </Fragment>

  {(coverImages || coverMedia) && (
    <div slot="cover" class="mb-8">
      {coverImages && coverImages.length > 0 ? (
        <ImageSlider client:visible images={coverImages} alt={project.data.title} />
      ) : coverMedia?.kind === 'youtube' ? (
        <div class="w-full aspect-video overflow-hidden rounded-md bg-gray-100">
          <iframe src={coverMediaSrc} title={`${project.data.title} video preview`} loading="lazy" class="w-full h-full" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      ) : coverMedia?.kind === 'google-drive' ? (
        <div class="w-full aspect-video overflow-hidden rounded-md bg-gray-100">
          <iframe src={coverMediaSrc} title={`${project.data.title} Google Drive preview`} loading="lazy" class="w-full h-full" frameborder="0" allow="autoplay"></iframe>
        </div>
      ) : coverMedia ? (
        <div class="w-full aspect-video overflow-hidden rounded-md bg-gray-100">
          <video src={coverMediaSrc} controls preload="metadata" class="w-full h-full">Your browser does not support the video tag.</video>
        </div>
      ) : null}
    </div>
  )}

  <Fragment slot="beforeContent">
    {hasProjectBrief && (
      <aside class="not-prose mb-8 border-y border-gray-300" aria-label="Project brief">
        <dl class="grid sm:grid-cols-3">
          {project.data.role && (
            <div class="py-4 sm:pr-6">
              <dt class="font-mono text-[10px] uppercase tracking-[0.08em] text-gray-500">Role</dt>
              <dd class="site-ui mt-2 text-sm leading-6 text-gray-800">{project.data.role}</dd>
            </div>
          )}
          {project.data.engineeringFocus.length > 0 && (
            <div class="border-t border-gray-300 py-4 sm:border-l sm:border-t-0 sm:px-6">
              <dt class="font-mono text-[10px] uppercase tracking-[0.08em] text-gray-500">Focus</dt>
              <dd class="site-ui mt-2 text-sm leading-6 text-gray-700">{project.data.engineeringFocus.join(' / ')}</dd>
            </div>
          )}
          {project.data.tags.length > 0 && (
            <div class="border-t border-gray-300 py-4 sm:border-l sm:border-t-0 sm:pl-6">
              <dt class="font-mono text-[10px] uppercase tracking-[0.08em] text-gray-500">Stack</dt>
              <dd class="site-ui mt-2 text-sm leading-6 text-gray-700">{project.data.tags.slice(0, 7).join(' / ')}</dd>
            </div>
          )}
        </dl>
      </aside>
    )}

    {caseStudySummary && (
      <section class="not-prose mb-10 border-y border-gray-300" aria-label="Case study summary">
        <div class="grid border-b border-gray-200 py-4 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-x-6">
          <p class="font-mono text-[10px] uppercase tracking-[0.08em] text-gray-500">Constraint</p>
          <p class="site-ui mt-2 text-sm leading-6 text-gray-700 sm:mt-0">{caseStudySummary.problem}</p>
        </div>
        <div class="grid border-b border-gray-200 py-4 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-x-6">
          <h2 class="font-mono text-[10px] font-normal uppercase tracking-[0.08em] text-gray-500">Decision</h2>
          <p class="site-ui mt-2 text-sm leading-6 text-gray-800 sm:mt-0">{caseStudySummary.decision}</p>
        </div>
        <div class="grid py-4 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-x-6">
          <p class="font-mono text-[10px] uppercase tracking-[0.08em] text-gray-500">Outcome</p>
          <p class="site-ui mt-2 text-sm leading-6 text-gray-700 sm:mt-0">{caseStudySummary.result}</p>
        </div>
      </section>
    )}
  </Fragment>

  <Content />
</ArticleLayout>
