---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import ProjectVisual from "../../components/content/ProjectVisual.astro";
import { ImageSlider } from "../../components/interactive";
import { withBase } from "../../lib/paths";
import { resolveProjectMedia } from "../../lib/media";
import { getCollection, type CollectionEntry } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as {project: CollectionEntry<'projects'>};
const { Content } = await project.render();
const coverImages = project.data.coverImages?.map((image) => withBase(image));
const coverMedia = project.data.coverVideo ? resolveProjectMedia(project.data.coverVideo) : undefined;
const coverMediaSrc = coverMedia?.kind === 'video' && coverMedia.src.startsWith('/') ? withBase(coverMedia.src) : coverMedia?.src;
const caseStudySummary = project.data.caseStudySummary;
const hasProjectBrief = Boolean(project.data.role || project.data.engineeringFocus.length > 0 || project.data.tags.length > 0);
const indexSeed = Math.max(0, (project.data.featuredRank ?? 1) - 1);
---

<ArticleLayout
  title={`${project.data.title} - Engineering Case Study`}
  description={project.data.summary ?? project.data.excerpt}
  image={project.data.coverImages?.[0]}
  articleTitle={project.data.title}
  date={project.data.date}
  backHref={withBase("/projects")}
  backLabel="Back to Engineering Work"
  contentVariant="technical"
  recordLabel="Engineering case study"
>
  <div slot="meta" class="site-ui mt-5">
    <p class="max-w-2xl text-[16px] leading-7 text-gray-600">{project.data.summary ?? project.data.excerpt}</p>
  </div>

  <Fragment slot="actions">
    {project.data.liveSite && <a href={project.data.liveSite} target="_blank" rel="noopener noreferrer" class="signal-link">Live site ↗</a>}
    {project.data.repository && <a href={project.data.repository} target="_blank" rel="noopener noreferrer" class="signal-link">Repository ↗</a>}
    {project.data.videoDemo && <a href={project.data.videoDemo} target="_blank" rel="noopener noreferrer" class="signal-link">Video demo ↗</a>}
  </Fragment>

  <div slot="cover" class="mb-8">
    {coverImages && coverImages.length > 0 ? (
      <ImageSlider client:visible images={coverImages} alt={project.data.title} />
    ) : coverMedia?.kind === 'youtube' ? (
      <div class="aspect-video w-full overflow-hidden rounded-xl bg-gray-100"><iframe src={coverMediaSrc} title={`${project.data.title} video preview`} loading="lazy" class="h-full w-full" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>
    ) : coverMedia?.kind === 'google-drive' ? (
      <div class="aspect-video w-full overflow-hidden rounded-xl bg-gray-100"><iframe src={coverMediaSrc} title={`${project.data.title} Google Drive preview`} loading="lazy" class="h-full w-full" frameborder="0" allow="autoplay"></iframe></div>
    ) : coverMedia ? (
      <div class="aspect-video w-full overflow-hidden rounded-xl bg-gray-100"><video src={coverMediaSrc} controls preload="metadata" class="h-full w-full">Your browser does not support the video tag.</video></div>
    ) : caseStudySummary ? (
      <ProjectVisual
        title={project.data.title}
        index={indexSeed}
        problem={caseStudySummary.problem}
        decision={caseStudySummary.decision}
        outcome={caseStudySummary.result}
        focus={project.data.engineeringFocus}
      />
    ) : null}
  </div>

  <Fragment slot="beforeContent">
    {hasProjectBrief && (
      <aside class="not-prose mb-8 border-y border-gray-200 py-5" aria-label="Engineering brief">
        <dl class="grid gap-5 sm:grid-cols-3">
          {project.data.role && (
            <div>
              <dt class="eyebrow">Ownership</dt>
              <dd class="mt-2 text-sm leading-6 text-gray-800">{project.data.role}</dd>
            </div>
          )}
          {project.data.engineeringFocus.length > 0 && (
            <div>
              <dt class="eyebrow">Engineering focus</dt>
              <dd class="mt-2 text-sm leading-6 text-gray-700">{project.data.engineeringFocus.join(' · ')}</dd>
            </div>
          )}
          {project.data.tags.length > 0 && (
            <div>
              <dt class="eyebrow">Implementation</dt>
              <dd class="mt-2 text-sm leading-6 text-gray-600">{project.data.tags.slice(0, 7).join(' · ')}</dd>
            </div>
          )}
        </dl>
      </aside>
    )}

    {caseStudySummary && (
      <section class="not-prose mb-10" aria-label="Engineering decision summary">
        <p class="eyebrow">Engineering decision summary</p>
        <div class="mt-4 border-y border-gray-200">
          <div class="grid gap-2 py-4 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-5">
            <h2 class="text-sm font-semibold text-gray-900">Constraint</h2>
            <p class="text-sm leading-6 text-gray-600">{caseStudySummary.problem}</p>
          </div>
          <div class="grid gap-2 border-t border-gray-200 py-4 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-5">
            <h2 class="text-sm font-semibold text-gray-900">Decision</h2>
            <p class="text-sm leading-6 text-gray-700">{caseStudySummary.decision}</p>
          </div>
          <div class="grid gap-2 border-t border-gray-200 py-4 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-5">
            <h2 class="text-sm font-semibold text-gray-900">Outcome</h2>
            <p class="text-sm leading-6 text-gray-600">{caseStudySummary.result}</p>
          </div>
        </div>
      </section>
    )}
  </Fragment>

  <Content />
</ArticleLayout>
