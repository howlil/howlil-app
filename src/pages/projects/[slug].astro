---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import DiagramFigure from "../../components/content/DiagramFigure.astro";
import { CaseStudyPlayground, DiagramExplorer, ImageSlider } from "../../components/interactive";
import { withBase } from "../../lib/paths";
import { resolveProjectMedia } from "../../lib/media";
import { getCollection, type CollectionEntry } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as {project: CollectionEntry<'projects'>};
const { Content } = await project.render();
const coverImages = project.data.coverImages?.map((image) => withBase(image));
const coverMedia = project.data.coverVideo ? resolveProjectMedia(project.data.coverVideo) : undefined;
const coverMediaSrc = coverMedia?.kind === 'video' && coverMedia.src.startsWith('/')
  ? withBase(coverMedia.src)
  : coverMedia?.src;
const diagrams = project.data.diagrams.map((diagram) => ({
  ...diagram,
  src: diagram.src.startsWith('/') ? withBase(diagram.src) : diagram.src,
  source: diagram.source?.startsWith('/') ? withBase(diagram.source) : diagram.source,
}));
const primaryDiagram = diagrams[0];
const playgroundKind = project.slug === 'tedx-payment-service'
  ? 'payment-state'
  : project.slug === 'tracer-survey'
    ? 'survey-branch'
    : project.slug === 'stunby-cloud-api'
      ? 'failure-boundary'
      : undefined;
const hasProjectBrief = Boolean(
  project.data.role || project.data.engineeringFocus.length > 0 || project.data.tags.length > 0,
);
---

<ArticleLayout
  title={`${project.data.title} - Engineering Case Study`}
  description={project.data.summary ?? project.data.excerpt}
  image={project.data.coverImages?.[0]}
  articleTitle={project.data.title}
  date={project.data.date}
  backHref={withBase("/projects")}
  backLabel="Back to Work"
>
  <div slot="meta" class="site-ui mt-4">
    <p class="max-w-2xl text-base leading-7 text-gray-700">
      {project.data.summary ?? project.data.excerpt}
    </p>
  </div>

  <Fragment slot="actions">
    {project.data.liveSite && (
      <a href={project.data.liveSite} target="_blank" rel="noopener noreferrer" class="ui-action">Live site</a>
    )}
    {project.data.repository && (
      <a href={project.data.repository} target="_blank" rel="noopener noreferrer" class="ui-action">Repository</a>
    )}
    {project.data.videoDemo && (
      <a href={project.data.videoDemo} target="_blank" rel="noopener noreferrer" class="ui-action">Video demo</a>
    )}
  </Fragment>

  {(coverImages || coverMedia) && (
    <div slot="cover" class="mb-8">
      {coverImages && coverImages.length > 0 ? (
        <ImageSlider client:visible images={coverImages} alt={project.data.title} />
      ) : coverMedia?.kind === 'youtube' ? (
        <div class="w-full aspect-video rounded-lg overflow-hidden bg-gray-100">
          <iframe src={coverMediaSrc} title={`${project.data.title} video preview`} loading="lazy" class="w-full h-full" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      ) : coverMedia?.kind === 'google-drive' ? (
        <div class="w-full aspect-video rounded-lg overflow-hidden bg-gray-100">
          <iframe src={coverMediaSrc} title={`${project.data.title} Google Drive preview`} loading="lazy" class="w-full h-full" frameborder="0" allow="autoplay"></iframe>
        </div>
      ) : coverMedia ? (
        <div class="w-full aspect-video rounded-lg overflow-hidden bg-gray-100">
          <video src={coverMediaSrc} controls preload="metadata" class="w-full h-full">Your browser does not support the video tag.</video>
        </div>
      ) : null}
    </div>
  )}

  <Fragment slot="beforeContent">
    {hasProjectBrief && (
      <aside class="not-prose mb-10 border-y border-gray-200 py-5" aria-label="Project brief">
        <dl class="grid gap-5 sm:grid-cols-3 sm:gap-8">
          {project.data.role && (
            <div>
              <dt class="site-ui mb-1 text-xs font-medium text-gray-500">Role</dt>
              <dd class="site-ui text-sm leading-6 text-gray-800">{project.data.role}</dd>
            </div>
          )}
          {project.data.engineeringFocus.length > 0 && (
            <div>
              <dt class="site-ui mb-1 text-xs font-medium text-gray-500">Scope</dt>
              <dd class="site-ui text-sm leading-6 text-gray-700">{project.data.engineeringFocus.join(' · ')}</dd>
            </div>
          )}
          {project.data.tags.length > 0 && (
            <div>
              <dt class="site-ui mb-1 text-xs font-medium text-gray-500">Stack</dt>
              <dd class="site-ui text-sm leading-6 text-gray-700">{project.data.tags.slice(0, 6).join(' · ')}</dd>
            </div>
          )}
        </dl>
      </aside>
    )}

    {diagrams.length > 1 ? (
      <DiagramExplorer client:visible diagrams={diagrams} />
    ) : primaryDiagram ? (
      <DiagramFigure
        title={primaryDiagram.title}
        src={primaryDiagram.src}
        source={primaryDiagram.source}
        alt={primaryDiagram.alt}
        caption={primaryDiagram.caption}
      />
    ) : null}

    {playgroundKind && <CaseStudyPlayground client:visible kind={playgroundKind} />}
  </Fragment>

  <Content />
</ArticleLayout>
