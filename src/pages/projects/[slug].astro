---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import DiagramFigure from "../../components/content/DiagramFigure.astro";
import { ImageSlider } from "../../components/interactive";
import { getProjectTypeLabel } from "../../constants/projectTypes";
import { withBase } from "../../lib/paths";
import { resolveProjectMedia } from "../../lib/media";
import { getCollection, type CollectionEntry } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as {project: CollectionEntry<'projects'>};
const { Content } = await project.render();
const coverImages = project.data.coverImages?.map((image) => withBase(image));
const coverMedia = project.data.coverVideo ? resolveProjectMedia(project.data.coverVideo) : undefined;
const coverMediaSrc = coverMedia?.kind === 'video' && coverMedia.src.startsWith('/')
  ? withBase(coverMedia.src)
  : coverMedia?.src;
const hasEngineeringSnapshot = Boolean(
  project.data.role || project.data.engineeringFocus.length > 0 || project.data.verifiedEvidence.length > 0,
);
const projectType = getProjectTypeLabel(project.data.type);
---

<ArticleLayout
  title={`${project.data.title} - Engineering Case Study`}
  description={project.data.summary ?? project.data.excerpt}
  image={project.data.coverImages?.[0]}
  articleTitle={project.data.title}
  date={project.data.date}
  backHref={withBase("/projects")}
  backLabel="Back to Projects"
>
  <div slot="meta" class="site-ui mt-4 space-y-3">
    <p class="text-sm text-gray-500">
      {[project.data.featured ? 'Featured system' : null, projectType].filter(Boolean).join(' · ')}
    </p>
    <p class="max-w-2xl text-base leading-7 text-gray-700">
      {project.data.summary ?? project.data.excerpt}
    </p>
    {project.data.tags.length > 0 && (
      <p class="text-sm leading-6 text-gray-500">{project.data.tags.join(' · ')}</p>
    )}
  </div>

  <Fragment slot="actions">
    {project.data.liveSite && (
      <a href={project.data.liveSite} target="_blank" rel="noopener noreferrer" class="ui-action">Live site</a>
    )}
    {project.data.repository && (
      <a href={project.data.repository} target="_blank" rel="noopener noreferrer" class="ui-action">Repository</a>
    )}
    {project.data.videoDemo && (
      <a href={project.data.videoDemo} target="_blank" rel="noopener noreferrer" class="ui-action">Video demo</a>
    )}
  </Fragment>

  {(coverImages || coverMedia) && (
    <div slot="cover" class="mb-8">
      {coverImages && coverImages.length > 0 ? (
        <ImageSlider client:visible images={coverImages} alt={project.data.title} />
      ) : coverMedia?.kind === 'youtube' ? (
        <div class="w-full aspect-video rounded-lg overflow-hidden bg-gray-100">
          <iframe src={coverMediaSrc} title={`${project.data.title} video preview`} loading="lazy" class="w-full h-full" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      ) : coverMedia?.kind === 'google-drive' ? (
        <div class="w-full aspect-video rounded-lg overflow-hidden bg-gray-100">
          <iframe src={coverMediaSrc} title={`${project.data.title} Google Drive preview`} loading="lazy" class="w-full h-full" frameborder="0" allow="autoplay"></iframe>
        </div>
      ) : coverMedia ? (
        <div class="w-full aspect-video rounded-lg overflow-hidden bg-gray-100">
          <video src={coverMediaSrc} controls preload="metadata" class="w-full h-full">Your browser does not support the video tag.</video>
        </div>
      ) : null}
    </div>
  )}

  {hasEngineeringSnapshot && (
    <aside class="not-prose mb-10 border-y border-gray-200 py-6" aria-label="Engineering snapshot">
      <h2 class="mb-5 text-lg font-semibold tracking-tight text-gray-900">Snapshot</h2>
      <div class="grid gap-6 sm:grid-cols-2 sm:gap-8">
        <div class="space-y-5">
          {project.data.role && (
            <div>
              <p class="site-ui mb-1 text-xs font-medium text-gray-500">Role</p>
              <p class="site-ui text-sm text-gray-800">{project.data.role}</p>
            </div>
          )}
          {project.data.engineeringFocus.length > 0 && (
            <div>
              <p class="site-ui mb-1 text-xs font-medium text-gray-500">Focus</p>
              <p class="site-ui text-sm leading-6 text-gray-700">{project.data.engineeringFocus.join(' · ')}</p>
            </div>
          )}
        </div>
        {project.data.verifiedEvidence.length > 0 && (
          <div>
            <p class="site-ui mb-2 text-xs font-medium text-gray-500">Evidence</p>
            <ul class="site-ui space-y-2 text-sm leading-6 text-gray-700">
              {project.data.verifiedEvidence.map((item) => (
                <li class="flex gap-2"><span aria-hidden="true">✓</span><span>{item}</span></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </aside>
  )}

  {project.data.diagrams.length > 0 && (
    <section class="not-prose mb-12" aria-label="System diagrams">
      {project.data.diagrams.map((diagram) => (
        <DiagramFigure
          title={diagram.title}
          src={diagram.src.startsWith('/') ? withBase(diagram.src) : diagram.src}
          source={diagram.source}
          alt={diagram.alt}
          caption={diagram.caption}
        />
      ))}
    </section>
  )}

  <Content />
</ArticleLayout>
