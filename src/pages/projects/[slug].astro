---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { ImageSlider } from "../../components/interactive";
import { withBase } from "../../lib/paths";
import { resolveProjectMedia } from "../../lib/media";
import { ArrowUpRight } from "lucide-react";
import { getCollection, type CollectionEntry } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as {project: CollectionEntry<'projects'>};
const { Content } = await project.render();
const coverImages = project.data.coverImages?.map((image) => withBase(image));
const coverMedia = project.data.coverVideo ? resolveProjectMedia(project.data.coverVideo) : undefined;
const coverMediaSrc = coverMedia?.kind === 'video' && coverMedia.src.startsWith('/') ? withBase(coverMedia.src) : coverMedia?.src;
const hasProjectBrief = Boolean(project.data.role || project.data.engineeringFocus.length > 0 || project.data.tags.length > 0);
---

<ArticleLayout
  title={`${project.data.title} - Project Case Study`}
  description={project.data.summary ?? project.data.excerpt}
  image={project.data.coverImages?.[0]}
  articleTitle={project.data.title}
  date={project.data.date}
  backHref={withBase("/projects")}
  backLabel="Back to Projects"
  contentVariant="technical"
  recordLabel="Project case study"
>
  <div slot="meta" class="site-ui document-summary">
    <p>{project.data.summary ?? project.data.excerpt}</p>
  </div>

  <Fragment slot="actions">
    {project.data.liveSite && <a href={project.data.liveSite} target="_blank" rel="noopener noreferrer" class="signal-link inline-flex items-center gap-1">Live site <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" /></a>}
    {project.data.repository && <a href={project.data.repository} target="_blank" rel="noopener noreferrer" class="signal-link inline-flex items-center gap-1">Repository <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" /></a>}
    {project.data.videoDemo && <a href={project.data.videoDemo} target="_blank" rel="noopener noreferrer" class="signal-link inline-flex items-center gap-1">Video demo <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" /></a>}
  </Fragment>

  <Fragment slot="cover">
    {coverImages && coverImages.length > 0 ? (
      <div class="mb-9"><ImageSlider client:visible images={coverImages} alt={project.data.title} /></div>
    ) : coverMedia?.kind === 'youtube' ? (
      <div class="mb-9 aspect-video w-full overflow-hidden rounded-[6px] border border-gray-200 bg-gray-100"><iframe src={coverMediaSrc} title={`${project.data.title} video preview`} loading="lazy" class="h-full w-full" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>
    ) : coverMedia?.kind === 'google-drive' ? (
      <div class="mb-9 aspect-video w-full overflow-hidden rounded-[6px] border border-gray-200 bg-gray-100"><iframe src={coverMediaSrc} title={`${project.data.title} Google Drive preview`} loading="lazy" class="h-full w-full" allow="autoplay"></iframe></div>
    ) : coverMedia ? (
      <div class="mb-9 aspect-video w-full overflow-hidden rounded-[6px] border border-gray-200 bg-gray-100"><video src={coverMediaSrc} controls preload="metadata" class="h-full w-full">Your browser does not support the video tag.</video></div>
    ) : null}
  </Fragment>

  <Fragment slot="beforeContent">
    {hasProjectBrief && (
      <aside class="project-brief" aria-label="Project brief">
        <p>Project brief</p>
        <dl>
          {project.data.role && (
            <div>
              <dt>Ownership</dt>
              <dd>{project.data.role}</dd>
            </div>
          )}
          {project.data.engineeringFocus.length > 0 && (
            <div>
              <dt>Focus</dt>
              <dd>{project.data.engineeringFocus.join(' · ')}</dd>
            </div>
          )}
          {project.data.tags.length > 0 && (
            <div>
              <dt>Implementation</dt>
              <dd>{project.data.tags.slice(0, 7).join(' · ')}</dd>
            </div>
          )}
        </dl>
      </aside>
    )}
  </Fragment>

  <Content />
</ArticleLayout>
