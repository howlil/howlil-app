---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import WorkExperienceItem from '../components/about/WorkExperienceItem.astro';
import EducationItem from '../components/about/EducationItem.astro';
import AwardItem from '../components/about/AwardItem.astro';
import OrganizationItem from '../components/about/OrganizationItem.astro';
import Skills from '../components/about/Skills.astro';
import { awards, education, organizations, skills, workExperiences } from '../data/about';
import { matchesTag } from '../lib/filters';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

const skillItems = skills.map((skill) => ({
  name: skill,
  projectCount: projects.filter((project) =>
    project.data.tags.some((tag) => matchesTag(tag, skill)),
  ).length,
}));
---

<BaseLayout title="About - Mhd Ulil Abshar" description="About Mhd Ulil Abshar - Software Engineer">
  <main id="main-content" class="pt-20 pb-12 px-6">
    <div class="max-w-2xl mx-auto">
      <div class="space-y-10">
        <section>
          <h2 class="text-xl font-semibold text-gray-800 mb-4">About</h2>
          <p class="text-base text-gray-700 leading-7 mb-4">
            I build backend systems with a strong focus on reliability,
            automation, and clear operational boundaries. Most of my work
            revolves around designing APIs and workflows using
            JavaScript/TypeScript and Node.js, where reducing failure points
            and manual intervention matters more than adding features.
          </p>
          <p class="text-base text-gray-700 leading-7 mb-4">
            I've worked on logistics tracking, remote mentoring platforms,
            school management systems, and ticketing applications. Across
            these projects, I often handle the parts that break under
            real-world usage—payments, real-time communication, status
            synchronization, and deployment pipelines—ensuring systems remain
            predictable and stable in production.
          </p>
          <p class="text-base text-gray-700 leading-7">
            Recently, I've been exploring infrastructure and DevOps more
            deeply, including containerization, networking, operating systems,
            and Kubernetes. My goal is to better understand how systems behave
            beyond application code, and how architectural decisions impact
            long-term maintainability. I'm also interested in integrating
            AI/ML into backend systems where it meaningfully improves
            reliability, security, or observability.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200">Work Experience</h2>
          <div>
            {workExperiences.map((experience) => (
              <WorkExperienceItem {...experience} />
            ))}
          </div>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200">Education</h2>
          <div>
            {education.map((item) => (
              <EducationItem {...item} />
            ))}
          </div>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200">Awards</h2>
          <div>
            {awards.map((award) => (
              <AwardItem {...award} />
            ))}
          </div>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200">Organization & Leadership</h2>
          <div>
            {organizations.map((organization) => (
              <OrganizationItem {...organization} />
            ))}
          </div>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-gray-800 mb-4">Skills</h2>
          <Skills skills={skillItems} />
        </section>
      </div>
    </div>
  </main>
</BaseLayout>
