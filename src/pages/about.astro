---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/content/PageHeader.astro';
import WorkExperienceItem from '../components/about/WorkExperienceItem.astro';
import EducationItem from '../components/about/EducationItem.astro';
import AwardItem from '../components/about/AwardItem.astro';
import OrganizationItem from '../components/about/OrganizationItem.astro';
import { awards, capabilityGroups, education, organizations, workExperiences } from '../data/about';
import { withBase } from '../lib/paths';
import { Briefcase, GraduationCap, Info, Sparkles, Users } from 'lucide-react';
---

<BaseLayout title="About - Mhd Ulil Abshar" description="Software engineering background, experience, and technical scope of Mhd Ulil Abshar">
  <main id="main-content" class="index-page site-ui">
    <div class="site-shell">
      <PageHeader
        title="About"
        description="I build backend systems and infrastructure that stay understandable when state changes, dependencies fail, or operations become messy."
      >
        <Info slot="icon" size={23} strokeWidth={1.7} aria-hidden="true" />
      </PageHeader>

      <section class="about-intro index-section" aria-label="Profile">
        <div class="readable-copy" data-reading-measure>
          <p>I work across APIs, relational data, payments, stateful workflows, and deployment. The common thread is making ownership, state transitions, and failure paths explicit enough that a system can be reasoned about in production.</p>
          <p>My experience spans logistics, school operations, ticketing, mentoring, analytics, and cloud workloads. I prefer engineering decisions that reduce ambiguity for both the people using a product and the people operating it.</p>
        </div>
        <figure data-about-portrait>
          <img src={withBase('/profile.webp')} alt="Mhd Ulil Abshar" class="profile-portrait" />
          <figcaption>Mhd Ulil Abshar<br />Jakarta, Indonesia</figcaption>
        </figure>
      </section>

      <section class="index-section" aria-labelledby="scope-heading">
        <div class="index-section-heading with-icon">
          <h2 id="scope-heading"><Sparkles size={19} strokeWidth={1.7} aria-hidden="true" /> Engineering Focus</h2>
        </div>
        <div class="compact-record-list">
          {capabilityGroups.map((group) => (
            <article class="compact-record">
              <h3>{group.title}</h3>
              <div>
                <p>{group.description}</p>
                <small>{group.items.join(' · ')}</small>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="index-section" aria-labelledby="experience-heading">
        <div class="index-section-heading with-icon">
          <h2 id="experience-heading"><Briefcase size={19} strokeWidth={1.7} aria-hidden="true" /> Experience</h2>
        </div>
        <div class="about-records">
          {workExperiences.map((experience) => <WorkExperienceItem {...experience} />)}
        </div>
      </section>

      <section class="index-section" aria-labelledby="education-heading">
        <div class="index-section-heading with-icon">
          <h2 id="education-heading"><GraduationCap size={19} strokeWidth={1.7} aria-hidden="true" /> Education</h2>
        </div>
        <div class="about-records">
          {education.map((item) => <EducationItem {...item} />)}
        </div>
      </section>

      <section class="index-section" aria-labelledby="recognition-heading">
        <div class="index-section-heading with-icon">
          <h2 id="recognition-heading"><Sparkles size={19} strokeWidth={1.7} aria-hidden="true" /> Recognition</h2>
        </div>
        <div class="about-records">
          {awards.map((award) => <AwardItem {...award} />)}
        </div>
      </section>

      <section class="index-section" aria-labelledby="community-heading">
        <div class="index-section-heading with-icon">
          <h2 id="community-heading"><Users size={19} strokeWidth={1.7} aria-hidden="true" /> Community</h2>
        </div>
        <div class="about-records">
          {organizations.map((organization) => <OrganizationItem {...organization} />)}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
