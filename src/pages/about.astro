---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import WorkExperienceItem from '../components/about/WorkExperienceItem.astro';
import EducationItem from '../components/about/EducationItem.astro';
import AwardItem from '../components/about/AwardItem.astro';
import OrganizationItem from '../components/about/OrganizationItem.astro';
import { awards, capabilityGroups, education, organizations, workExperiences } from '../data/about';
import { withBase } from '../lib/paths';
---

<BaseLayout title="About - Mhd Ulil Abshar" description="Software engineering background, experience, and technical scope of Mhd Ulil Abshar">
  <main id="main-content" class="site-ui">
    <div class="site-shell">
      <header class="frame-section grid gap-8 border-b border-gray-200 py-10 sm:py-12 md:grid-cols-[minmax(0,1fr)_12rem] md:items-start md:gap-12">
        <div>
          <p class="eyebrow">04 / About</p>
          <h1 class="mt-4 max-w-[17ch] text-[35px] font-semibold leading-[1.04] tracking-[-0.045em] text-gray-900 sm:text-[42px]">
            Software engineer focused on system behavior, reliability, and implementation clarity.
          </h1>
          <div class="mt-6 max-w-2xl space-y-4 text-[15px] leading-7 text-gray-600">
            <p>I work across backend services, relational data, payments, stateful workflows, and infrastructure. I care most about making ownership, failure paths, and production behavior explicit enough to reason about.</p>
            <p>I have shipped systems for logistics, school operations, ticketing, payments, mentoring, analytics, and cloud workloads. My product judgment comes from implementation reality: what must stay correct, what can fail, and what operators or users need the system to communicate clearly.</p>
          </div>
        </div>
        <figure>
          <img src={withBase('/profile.webp')} alt="Mhd Ulil Abshar" class="aspect-[4/5] w-full rounded-[8px] border border-gray-200 object-cover" />
        </figure>
      </header>

      <section class="frame-section border-b border-gray-200 py-10 sm:py-11" aria-labelledby="scope-heading">
        <div class="grid gap-7 md:grid-cols-[15rem_minmax(0,1fr)] md:gap-10">
          <div>
            <p class="eyebrow">Engineering scope</p>
            <h2 id="scope-heading" class="mt-2 text-[24px] font-semibold leading-tight tracking-[-0.035em] text-gray-900">Technical depth grounded in production behavior.</h2>
          </div>
          <div class="border-t border-gray-200">
            {capabilityGroups.map((group) => (
              <article class="engineering-row py-4 first:border-t-0 sm:grid sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-5">
                <h3 class="text-sm font-semibold text-gray-900">{group.title}</h3>
                <p class="mt-2 text-sm leading-6 text-gray-600 sm:mt-0">{group.items.join(' · ')}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="frame-section border-b border-gray-200 py-10 sm:py-11" aria-labelledby="experience-heading">
        <div class="grid gap-7 md:grid-cols-[15rem_minmax(0,1fr)] md:gap-10">
          <div>
            <p class="eyebrow">Experience</p>
            <h2 id="experience-heading" class="mt-2 text-[24px] font-semibold tracking-[-0.035em] text-gray-900">Shipped work across operational domains.</h2>
          </div>
          <div class="border-t border-gray-200">
            {workExperiences.map((experience) => <WorkExperienceItem {...experience} />)}
          </div>
        </div>
      </section>

      <section class="frame-section py-10 sm:py-11" aria-labelledby="background-heading">
        <div class="grid gap-7 md:grid-cols-[15rem_minmax(0,1fr)] md:gap-10">
          <div>
            <p class="eyebrow">Background</p>
            <h2 id="background-heading" class="mt-2 text-[24px] font-semibold tracking-[-0.035em] text-gray-900">Education, recognition, and community.</h2>
          </div>

          <div class="grid gap-7 lg:grid-cols-3">
            <section class="border-t border-gray-200 pt-5" aria-labelledby="education-heading">
              <h3 id="education-heading" class="text-sm font-semibold text-gray-900">Education</h3>
              <div class="mt-3">{education.map((item) => <EducationItem {...item} />)}</div>
            </section>
            <section class="border-t border-gray-200 pt-5" aria-labelledby="recognition-heading">
              <h3 id="recognition-heading" class="text-sm font-semibold text-gray-900">Recognition</h3>
              <div class="mt-3">{awards.map((award) => <AwardItem {...award} />)}</div>
            </section>
            <section class="border-t border-gray-200 pt-5" aria-labelledby="leadership-heading">
              <h3 id="leadership-heading" class="text-sm font-semibold text-gray-900">Leadership</h3>
              <div class="mt-3">{organizations.map((organization) => <OrganizationItem {...organization} />)}</div>
            </section>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
