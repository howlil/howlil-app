---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import WorkExperienceItem from '../components/about/WorkExperienceItem.astro';
import EducationItem from '../components/about/EducationItem.astro';
import AwardItem from '../components/about/AwardItem.astro';
import OrganizationItem from '../components/about/OrganizationItem.astro';
import Skills from '../components/about/Skills.astro';
import { awards, capabilityGroups, education, organizations, skills, workExperiences } from '../data/about';
import { matchesTag } from '../lib/filters';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

const evidencedSkills = skills
  .map((skill) => ({
    name: skill,
    projectCount: projects.filter((project) =>
      project.data.tags.some((tag) => matchesTag(tag, skill)),
    ).length,
  }))
  .filter((skill) => skill.projectCount > 0)
  .sort((a, b) => b.projectCount - a.projectCount || a.name.localeCompare(b.name));
---

<BaseLayout title="About - Mhd Ulil Abshar" description="Backend and systems engineering background, experience, and technical capabilities of Mhd Ulil Abshar">
  <main id="main-content" class="pt-24 pb-16 px-6">
    <div class="max-w-3xl mx-auto">
      <div class="space-y-14">
        <section>
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-gray-500 mb-3">About</p>
          <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">Backend engineer moving deeper into systems and production engineering.</h1>
          <div class="space-y-4 max-w-2xl">
            <p class="text-base text-gray-700 leading-7">
              I build backend systems with an emphasis on reliable state transitions, clear APIs, and operational simplicity. My strongest practical experience is in TypeScript/Node.js services, relational databases, payment and webhook workflows, and deployment automation.
            </p>
            <p class="text-base text-gray-700 leading-7">
              In production-facing work I have handled logistics tracking, mentoring platforms, school operations, ticketing, payments, real-time communication, analytics, and release pipelines. I try to separate what was implemented and observed from what I would improve next, so project case studies remain technically defensible.
            </p>
            <p class="text-base text-gray-700 leading-7">
              I am currently deepening distributed systems, databases, networking, operating systems, Kubernetes, and performance engineering. The goal is not to collect tools, but to understand how systems behave across application, data, network, and infrastructure layers when load and failures appear.
            </p>
          </div>
        </section>

        <section>
          <div class="mb-6">
            <p class="font-mono text-xs uppercase tracking-[0.16em] text-gray-500 mb-2">Capability map</p>
            <h2 class="text-xl font-semibold text-gray-900">How my engineering work connects</h2>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            {capabilityGroups.map((group) => (
              <article class="rounded-xl border border-gray-200 p-5">
                <h3 class="font-semibold text-gray-900 mb-2">{group.title}</h3>
                <p class="text-sm text-gray-600 leading-6 mb-4">{group.description}</p>
                <ul class="space-y-1.5 text-sm text-gray-700">
                  {group.items.map((item) => (
                    <li class="flex gap-2">
                      <span aria-hidden="true" class="text-gray-400">→</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-gray-900 mb-4 pb-2 border-b border-gray-200">Work Experience</h2>
          <div>
            {workExperiences.map((experience) => (
              <WorkExperienceItem {...experience} />
            ))}
          </div>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-gray-900 mb-4 pb-2 border-b border-gray-200">Education</h2>
          <div>
            {education.map((item) => (
              <EducationItem {...item} />
            ))}
          </div>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-gray-900 mb-4 pb-2 border-b border-gray-200">Awards</h2>
          <div>
            {awards.map((award) => (
              <AwardItem {...award} />
            ))}
          </div>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-gray-900 mb-4 pb-2 border-b border-gray-200">Organization & Leadership</h2>
          <div>
            {organizations.map((organization) => (
              <OrganizationItem {...organization} />
            ))}
          </div>
        </section>

        <section>
          <div class="mb-4">
            <h2 class="text-xl font-semibold text-gray-900">Technologies evidenced in portfolio</h2>
            <p class="text-sm text-gray-600 leading-6 mt-2">Only technologies connected to at least one published project are listed here. The count links each claim back to project evidence.</p>
          </div>
          <Skills skills={evidencedSkills} />
        </section>
      </div>
    </div>
  </main>
</BaseLayout>
