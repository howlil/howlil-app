---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import WorkExperienceItem from '../components/about/WorkExperienceItem.astro';
import EducationItem from '../components/about/EducationItem.astro';
import AwardItem from '../components/about/AwardItem.astro';
import OrganizationItem from '../components/about/OrganizationItem.astro';
import { awards, capabilityGroups, education, organizations, workExperiences } from '../data/about';
---

<BaseLayout title="About - Mhd Ulil Abshar" description="Software engineering background, experience, and technical scope of Mhd Ulil Abshar">
  <main id="main-content" class="site-ui pb-16 pt-[84px]">
    <div class="site-shell">
      <header class="border-b border-gray-300 pb-7">
        <p class="font-mono text-[10px] uppercase tracking-[0.08em] text-gray-500">Profile</p>
        <h1 class="mt-3 text-2xl font-semibold tracking-[-0.025em] text-gray-900 sm:text-3xl">About</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-gray-600">
          Software engineer focused on backend services, relational data, infrastructure, and production correctness.
        </p>
      </header>

      <section class="grid gap-4 border-b border-gray-300 py-6 md:grid-cols-[9rem_minmax(0,1fr)] md:gap-x-8" aria-labelledby="overview-heading">
        <h2 id="overview-heading" class="font-mono text-[10px] font-semibold uppercase tracking-[0.08em] text-gray-500">Overview</h2>
        <div class="max-w-2xl space-y-3 text-sm leading-6 text-gray-600">
          <p>
            I have shipped logistics, school operations, ticketing, payment, mentoring, and analytics systems across backend and full-stack roles.
          </p>
          <p>
            My recent work is mostly about backend correctness, relational data, deployment automation, and making production behavior easier to understand and operate.
          </p>
        </div>
      </section>

      <section class="grid gap-4 border-b border-gray-300 py-6 md:grid-cols-[9rem_minmax(0,1fr)] md:gap-x-8" aria-labelledby="experience-heading">
        <h2 id="experience-heading" class="font-mono text-[10px] font-semibold uppercase tracking-[0.08em] text-gray-500">Experience</h2>
        <div class="border-t border-gray-200">
          {workExperiences.map((experience) => <WorkExperienceItem {...experience} />)}
        </div>
      </section>

      <section class="grid gap-4 border-b border-gray-300 py-6 md:grid-cols-[9rem_minmax(0,1fr)] md:gap-x-8" aria-labelledby="scope-heading">
        <h2 id="scope-heading" class="font-mono text-[10px] font-semibold uppercase tracking-[0.08em] text-gray-500">Technical scope</h2>
        <div class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
          {capabilityGroups.map((group, index) => (
            <article class="border-t border-gray-200 pt-3">
              <div class="flex items-baseline gap-3">
                <span class="font-mono text-[10px] text-gray-500">{String(index + 1).padStart(2, '0')}</span>
                <h3 class="text-sm font-semibold text-gray-900">{group.title}</h3>
              </div>
              <p class="mt-2 font-mono text-[10px] leading-5 text-gray-500">{group.items.join(' / ')}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="grid gap-4 border-b border-gray-300 py-6 md:grid-cols-[9rem_minmax(0,1fr)] md:gap-x-8" aria-labelledby="education-heading">
        <h2 id="education-heading" class="font-mono text-[10px] font-semibold uppercase tracking-[0.08em] text-gray-500">Education</h2>
        <div class="border-t border-gray-200">
          {education.map((item) => <EducationItem {...item} />)}
        </div>
      </section>

      <section class="grid gap-4 border-b border-gray-300 py-6 md:grid-cols-[9rem_minmax(0,1fr)] md:gap-x-8" aria-labelledby="recognition-heading">
        <h2 id="recognition-heading" class="font-mono text-[10px] font-semibold uppercase tracking-[0.08em] text-gray-500">Recognition</h2>
        <div class="border-t border-gray-200">
          {awards.map((award) => <AwardItem {...award} />)}
        </div>
      </section>

      <section class="grid gap-4 py-6 md:grid-cols-[9rem_minmax(0,1fr)] md:gap-x-8" aria-labelledby="leadership-heading">
        <h2 id="leadership-heading" class="font-mono text-[10px] font-semibold uppercase tracking-[0.08em] text-gray-500">Leadership</h2>
        <div class="border-t border-gray-200">
          {organizations.map((organization) => <OrganizationItem {...organization} />)}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
