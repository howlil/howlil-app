---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import WorkExperienceItem from '../components/about/WorkExperienceItem.astro';
import EducationItem from '../components/about/EducationItem.astro';
import AwardItem from '../components/about/AwardItem.astro';
import OrganizationItem from '../components/about/OrganizationItem.astro';
import { awards, capabilityGroups, education, organizations, workExperiences } from '../data/about';
---

<BaseLayout title="About - Mhd Ulil Abshar" description="Software engineering background, experience, and technical scope of Mhd Ulil Abshar">
  <main id="main-content" class="pt-28 pb-20">
    <div class="site-shell">
      <div class="grid gap-12 md:grid-cols-12 md:gap-8">
        <aside class="md:col-span-3">
          <p class="meta-label">About</p>
        </aside>

        <div class="space-y-14 md:col-span-9 lg:col-span-8">
          <section>
            <h1 class="text-balance text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
              Software engineer focused on backend services, data, and infrastructure.
            </h1>
            <div class="site-ui reading-column mt-6 space-y-4 text-base leading-7 text-gray-600">
              <p>
                I have shipped logistics, school operations, ticketing, payment, mentoring, and analytics systems across backend and full-stack roles.
              </p>
              <p>
                My recent work is mostly about backend correctness, relational data, deployment automation, and making production behavior easier to understand and operate.
              </p>
            </div>
          </section>

          <section>
            <h2 class="mb-4 text-xl font-semibold text-gray-900">Experience</h2>
            <div class="border-t border-gray-200">
              {workExperiences.map((experience) => <WorkExperienceItem {...experience} />)}
            </div>
          </section>

          <section>
            <h2 class="mb-6 text-xl font-semibold text-gray-900">Technical scope</h2>
            <div class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
              {capabilityGroups.map((group, index) => (
                <article>
                  <div class="flex items-baseline gap-3">
                    <span class="font-mono text-xs text-gray-400">{String(index + 1).padStart(2, '0')}</span>
                    <h3 class="font-semibold text-gray-900">{group.title}</h3>
                  </div>
                  <p class="site-ui mt-2 text-sm leading-6 text-gray-600">{group.items.join(' · ')}</p>
                </article>
              ))}
            </div>
          </section>

          <section class="grid gap-10 border-t border-gray-200 pt-10 sm:grid-cols-2">
            <div>
              <h2 class="mb-4 text-lg font-semibold text-gray-900">Education</h2>
              {education.map((item) => <EducationItem {...item} />)}
            </div>

            <div>
              <h2 class="mb-4 text-lg font-semibold text-gray-900">Awards</h2>
              {awards.map((award) => <AwardItem {...award} />)}
            </div>
          </section>

          <section>
            <h2 class="mb-4 text-lg font-semibold text-gray-900">Leadership</h2>
            <div class="border-t border-gray-200">
              {organizations.map((organization) => <OrganizationItem {...organization} />)}
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
