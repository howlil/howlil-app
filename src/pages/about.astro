---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import WorkExperienceItem from '../components/about/WorkExperienceItem.astro';
import EducationItem from '../components/about/EducationItem.astro';
import AwardItem from '../components/about/AwardItem.astro';
import OrganizationItem from '../components/about/OrganizationItem.astro';
import { awards, capabilityGroups, education, organizations, workExperiences } from '../data/about';
---

<BaseLayout title="About - Mhd Ulil Abshar" description="Software engineering background, experience, and technical scope of Mhd Ulil Abshar">
  <main id="main-content" class="site-ui pb-14 pt-[72px]">
    <div class="site-shell">
      <header class="grid gap-5 border-b-2 border-gray-900 pb-7 pt-3 md:grid-cols-[8rem_minmax(0,1fr)] md:gap-x-8">
        <p class="swiss-label"><span class="swiss-index">00</span> / PROFILE</p>
        <div>
          <h1 class="text-[28px] font-semibold leading-[1.08] tracking-[-0.032em] text-gray-900 sm:text-[32px]">Background &amp; scope</h1>
          <p class="reading-column mt-3 text-sm leading-6 text-gray-600">
            Software engineer focused on backend services, relational data, infrastructure, and production correctness.
          </p>
        </div>
      </header>

      <section class="grid gap-5 border-b border-gray-300 py-7 md:grid-cols-[8rem_minmax(0,1fr)] md:gap-x-8" aria-labelledby="overview-heading">
        <h2 id="overview-heading" class="swiss-label"><span class="swiss-index">01</span> / OVERVIEW</h2>
        <div class="reading-column space-y-3 text-sm leading-6 text-gray-600">
          <p>
            I have shipped logistics, school operations, ticketing, payment, mentoring, and analytics systems across backend and full-stack roles.
          </p>
          <p>
            My recent work is mostly about backend correctness, relational data, deployment automation, and making production behavior easier to understand and operate.
          </p>
        </div>
      </section>

      <section class="grid gap-5 border-b border-gray-300 py-7 md:grid-cols-[8rem_minmax(0,1fr)] md:gap-x-8" aria-labelledby="experience-heading">
        <h2 id="experience-heading" class="swiss-label"><span class="swiss-index">02</span> / EXPERIENCE</h2>
        <div class="border-t border-gray-300">
          {workExperiences.map((experience) => <WorkExperienceItem {...experience} />)}
        </div>
      </section>

      <section class="grid gap-5 border-b border-gray-300 py-7 md:grid-cols-[8rem_minmax(0,1fr)] md:gap-x-8" aria-labelledby="scope-heading">
        <h2 id="scope-heading" class="swiss-label"><span class="swiss-index">03</span> / SCOPE</h2>
        <div class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
          {capabilityGroups.map((group, index) => (
            <article class="border-t border-gray-300 pt-3">
              <div class="flex items-baseline gap-3">
                <span class="font-mono text-[10px] text-[var(--color-signal)]">{String(index + 1).padStart(2, '0')}</span>
                <h3 class="text-sm font-semibold text-gray-900">{group.title}</h3>
              </div>
              <p class="mt-2 font-mono text-[10px] leading-5 text-gray-500">{group.items.join(' / ')}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="grid gap-5 border-b border-gray-300 py-7 md:grid-cols-[8rem_minmax(0,1fr)] md:gap-x-8" aria-labelledby="education-heading">
        <h2 id="education-heading" class="swiss-label"><span class="swiss-index">04</span> / EDUCATION</h2>
        <div class="border-t border-gray-300">
          {education.map((item) => <EducationItem {...item} />)}
        </div>
      </section>

      <section class="grid gap-5 border-b border-gray-300 py-7 md:grid-cols-[8rem_minmax(0,1fr)] md:gap-x-8" aria-labelledby="recognition-heading">
        <h2 id="recognition-heading" class="swiss-label"><span class="swiss-index">05</span> / RECOGNITION</h2>
        <div class="border-t border-gray-300">
          {awards.map((award) => <AwardItem {...award} />)}
        </div>
      </section>

      <section class="grid gap-5 py-7 md:grid-cols-[8rem_minmax(0,1fr)] md:gap-x-8" aria-labelledby="leadership-heading">
        <h2 id="leadership-heading" class="swiss-label"><span class="swiss-index">06</span> / LEADERSHIP</h2>
        <div class="border-t border-gray-300">
          {organizations.map((organization) => <OrganizationItem {...organization} />)}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
