---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import WorkExperienceItem from '../components/about/WorkExperienceItem.astro';
import EducationItem from '../components/about/EducationItem.astro';
import AwardItem from '../components/about/AwardItem.astro';
import OrganizationItem from '../components/about/OrganizationItem.astro';
import { awards, capabilityGroups, education, organizations, workExperiences } from '../data/about';
import { withBase } from '../lib/paths';
---

<BaseLayout title="About - Mhd Ulil Abshar" description="Software engineering background, experience, and technical scope of Mhd Ulil Abshar">
  <main id="main-content" class="site-ui pb-20 pt-[92px]">
    <div class="site-shell">
      <header class="grid gap-8 pb-14 pt-5 md:grid-cols-[minmax(0,1fr)_16rem] md:items-center md:gap-12">
        <div>
          <p class="eyebrow">About</p>
          <h1 class="mt-4 max-w-[15ch] text-[38px] font-semibold leading-[1.02] tracking-[-0.05em] text-gray-900 sm:text-[46px]">
            I care about how systems behave and how people experience them.
          </h1>
          <div class="mt-6 max-w-2xl space-y-4 text-[15px] leading-7 text-gray-600">
            <p>I am a software engineer focused on backend services, relational data, infrastructure, and production correctness.</p>
            <p>I have shipped logistics, school operations, ticketing, payments, mentoring, and analytics systems. The recurring theme is reducing ambiguity: making state, ownership, failure paths, and operational behavior easier to reason about.</p>
          </div>
        </div>
        <div class="surface-card overflow-hidden p-3">
          <img src={withBase('/profile.webp')} alt="Mhd Ulil Abshar" class="aspect-[4/5] w-full rounded-xl object-cover" />
        </div>
      </header>

      <section class="border-t border-gray-200 py-12" aria-labelledby="scope-heading">
        <div class="grid gap-7 md:grid-cols-[.75fr_1.25fr]">
          <div>
            <p class="eyebrow">What I bring</p>
            <h2 id="scope-heading" class="mt-2 text-[27px] font-semibold leading-tight tracking-[-0.04em] text-gray-900">Technical depth with a bias for product clarity.</h2>
            <p class="mt-4 text-sm leading-6 text-gray-600">I treat architecture, state design, reliability, and developer experience as parts of the product experience—not isolated backend concerns.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {capabilityGroups.map((group) => (
              <article class="surface-card p-5">
                <h3 class="text-[16px] font-semibold tracking-[-0.02em] text-gray-900">{group.title}</h3>
                <p class="mt-3 text-sm leading-6 text-gray-600">{group.items.join(' · ')}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="border-t border-gray-200 py-12" aria-labelledby="experience-heading">
        <div class="grid gap-7 md:grid-cols-[.75fr_1.25fr]">
          <div>
            <p class="eyebrow">Experience</p>
            <h2 id="experience-heading" class="mt-2 text-[27px] font-semibold tracking-[-0.04em] text-gray-900">Shipped work across real operational domains.</h2>
          </div>
          <div class="surface-card px-5 sm:px-6">
            {workExperiences.map((experience) => <WorkExperienceItem {...experience} />)}
          </div>
        </div>
      </section>

      <section class="border-t border-gray-200 py-12" aria-labelledby="background-heading">
        <div>
          <p class="eyebrow">Beyond the day-to-day</p>
          <h2 id="background-heading" class="mt-2 text-[27px] font-semibold tracking-[-0.04em] text-gray-900">Education, recognition, and community.</h2>
        </div>

        <div class="mt-7 grid gap-4 lg:grid-cols-3">
          <section class="surface-card p-5" aria-labelledby="education-heading">
            <h3 id="education-heading" class="text-sm font-semibold text-gray-900">Education</h3>
            <div class="mt-3 border-t border-gray-200">{education.map((item) => <EducationItem {...item} />)}</div>
          </section>
          <section class="surface-card p-5" aria-labelledby="recognition-heading">
            <h3 id="recognition-heading" class="text-sm font-semibold text-gray-900">Recognition</h3>
            <div class="mt-3 border-t border-gray-200">{awards.map((award) => <AwardItem {...award} />)}</div>
          </section>
          <section class="surface-card p-5" aria-labelledby="leadership-heading">
            <h3 id="leadership-heading" class="text-sm font-semibold text-gray-900">Leadership</h3>
            <div class="mt-3 border-t border-gray-200">{organizations.map((organization) => <OrganizationItem {...organization} />)}</div>
          </section>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
