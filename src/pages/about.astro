---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import WorkExperienceItem from '../components/about/WorkExperienceItem.astro';
import EducationItem from '../components/about/EducationItem.astro';
import AwardItem from '../components/about/AwardItem.astro';
import OrganizationItem from '../components/about/OrganizationItem.astro';
import Skills from '../components/about/Skills.astro';
import { awards, capabilityGroups, education, organizations, skills, workExperiences } from '../data/about';
import { matchesTag } from '../lib/filters';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

const evidencedSkills = skills
  .map((skill) => ({
    name: skill,
    projectCount: projects.filter((project) =>
      project.data.tags.some((tag) => matchesTag(tag, skill)),
    ).length,
  }))
  .filter((skill) => skill.projectCount > 0)
  .sort((a, b) => b.projectCount - a.projectCount || a.name.localeCompare(b.name));
---

<BaseLayout title="About - Mhd Ulil Abshar" description="Backend and systems engineering background, experience, and technical capabilities of Mhd Ulil Abshar">
  <main id="main-content" class="pt-28 pb-20">
    <div class="site-shell">
      <div class="grid gap-12 md:grid-cols-12 md:gap-8">
        <aside class="md:col-span-3">
          <p class="meta-label">About</p>
        </aside>

        <div class="space-y-16 md:col-span-9 lg:col-span-8">
          <section>
            <h1 class="text-balance text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
              Backend engineer moving deeper into systems and production engineering.
            </h1>
            <div class="reading-column mt-6 space-y-4">
              <p class="text-base text-gray-700 leading-7">
                I build backend systems with an emphasis on reliable state transitions, clear APIs, and operational simplicity. My strongest practical experience is in TypeScript/Node.js services, relational databases, payment and webhook workflows, and deployment automation.
              </p>
              <p class="text-base text-gray-700 leading-7">
                In production-facing work I have handled logistics tracking, mentoring platforms, school operations, ticketing, payments, real-time communication, analytics, and release pipelines. I separate what was implemented and observed from what I would improve next, so project case studies remain technically defensible.
              </p>
              <p class="text-base text-gray-700 leading-7">
                I am currently deepening distributed systems, databases, networking, operating systems, Kubernetes, and performance engineering. The goal is not to collect tools, but to understand how systems behave across application, data, network, and infrastructure layers when load and failures appear.
              </p>
            </div>
          </section>

          <section>
            <div class="mb-6">
              <p class="meta-label mb-2">Capability map</p>
              <h2 class="text-xl font-semibold text-gray-900">How my engineering work connects</h2>
            </div>
            <div class="grid sm:grid-cols-2 gap-x-8 gap-y-8">
              {capabilityGroups.map((group, index) => (
                <article>
                  <div class="flex items-baseline gap-3">
                    <span class="font-mono text-xs text-gray-400">{String(index + 1).padStart(2, '0')}</span>
                    <h3 class="font-semibold text-gray-900">{group.title}</h3>
                  </div>
                  <p class="text-sm text-gray-600 leading-6 mt-2 mb-3">{group.description}</p>
                  <ul class="site-ui space-y-1.5 text-sm text-gray-700">
                    {group.items.map((item) => (
                      <li class="flex gap-2"><span aria-hidden="true" class="text-gray-400">→</span><span>{item}</span></li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </section>

          <section>
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Work Experience</h2>
            <div class="border-t border-gray-200">
              {workExperiences.map((experience) => <WorkExperienceItem {...experience} />)}
            </div>
          </section>

          <section>
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Education</h2>
            <div class="border-t border-gray-200">
              {education.map((item) => <EducationItem {...item} />)}
            </div>
          </section>

          <section>
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Awards</h2>
            <div class="border-t border-gray-200">
              {awards.map((award) => <AwardItem {...award} />)}
            </div>
          </section>

          <section>
            <h2 class="text-xl font-semibold text-gray-900 mb-4">Organization & Leadership</h2>
            <div class="border-t border-gray-200">
              {organizations.map((organization) => <OrganizationItem {...organization} />)}
            </div>
          </section>

          <section>
            <div class="mb-4">
              <p class="meta-label mb-2">Evidence map</p>
              <h2 class="text-xl font-semibold text-gray-900">Technologies evidenced in portfolio</h2>
              <p class="text-sm text-gray-600 leading-6 mt-2 reading-column">Only technologies connected to at least one published project are listed here. The count links each claim back to project evidence.</p>
            </div>
            <Skills skills={evidencedSkills} />
          </section>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
