---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getReadingTime } from "../../utils/readingTime";
import { withBase } from "../../lib/paths";
import { getCollection, type CollectionEntry } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as {post: CollectionEntry<'blog'>};
const { Content } = await post.render();
const readingTime = getReadingTime(post.body || '');
---

<ArticleLayout
  title={`${post.data.title} - Blog`}
  description={post.data.excerpt}
  image={post.data.coverImage}
  articleTitle={post.data.title}
  date={post.data.date}
  backHref={withBase("/blog")}
  backLabel="Back to Writing"
  tags={post.data.tags}
  tagLinkPrefix={withBase("/blog")}
  readingTime={readingTime}
  contentVariant="technical"
  recordLabel="Writing"
>
  {post.data.coverImage && (
    <div slot="cover" class="mb-7">
      <img src={withBase(post.data.coverImage)} alt={post.data.title} class="aspect-video w-full cursor-pointer rounded-xl border border-gray-200 object-cover" id="cover-image" />
    </div>
  )}
  <Content />
</ArticleLayout>
