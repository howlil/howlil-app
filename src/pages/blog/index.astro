---
export const prerender = true;

import ThreeColumnLayout from "../../layouts/ThreeColumnLayout.astro";
import TagFilter from "../../components/content/TagFilterWrapper.astro";
import ArticleListItem from "../../components/content/ArticleListItem.astro";
import { sortByDateDesc, countTagOccurrences } from "../../utils/collectionHelpers";
import { withBase } from "../../lib/paths";
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = sortByDateDesc(posts);
const tags = countTagOccurrences(posts, (post) => post.data.tags);
---

<ThreeColumnLayout
  title="Writing - Mhd Ulil Abshar"
  headerLabel="03 / Writing"
  headerTitle="Notes from building software systems."
  headerDescription="Engineering notes on backend behavior, infrastructure, reliability, and the implementation decisions that make systems easier to operate and reason about."
>
  <div slot="content" class="border-b border-gray-200">
    <div data-filter-banner class="hidden border-b border-gray-200 py-3 text-xs text-gray-500">
      Showing <span data-filter-label class="font-medium text-gray-800"></span>
      <button type="button" data-filter-clear class="ml-2 underline underline-offset-2 hover:text-gray-900">clear</button>
    </div>

    <div>
      {sortedPosts.map((post) => (
        <ArticleListItem
          href={withBase(`/blog/${post.slug}`)}
          title={post.data.title}
          category={post.data.category}
          excerpt={post.data.excerpt}
          date={post.data.date}
          filterValue={post.data.tags.join(',')}
        />
      ))}
    </div>

    <p data-filter-empty class="hidden py-10 text-sm text-gray-600" role="status">No posts match this filter.</p>
  </div>

  <div slot="sidebar">
    <p class="eyebrow mb-4">Filter by topic</p>
    <TagFilter tags={tags} />
  </div>
</ThreeColumnLayout>
