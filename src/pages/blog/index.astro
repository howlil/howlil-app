---
export const prerender = true;

import ThreeColumnLayout from "../../layouts/ThreeColumnLayout.astro";
import TagFilter from "../../components/content/TagFilterWrapper.astro";
import ArticleListItem from "../../components/content/ArticleListItem.astro";
import { sortByDateDesc, countTagOccurrences } from "../../utils/collectionHelpers";
import { withBase } from "../../lib/paths";
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = sortByDateDesc(posts);
const tags = countTagOccurrences(posts, (post) => post.data.tags);
---

<ThreeColumnLayout
  title="Writing - Mhd Ulil Abshar"
  headerLabel="Writing"
  headerTitle="Notes on building useful, reliable software."
  headerDescription="Technical writing on backend systems, infrastructure, and the product decisions hiding inside engineering constraints."
>
  <div slot="content">
    <div data-filter-banner class="hidden mb-4 rounded-lg border border-gray-200 bg-[var(--color-surface)] px-4 py-2 text-xs text-gray-500">
      Showing <span data-filter-label class="font-medium text-gray-800"></span>
      <button type="button" data-filter-clear class="ml-2 underline underline-offset-2 hover:text-gray-900">clear</button>
    </div>

    <div class="grid gap-3 md:grid-cols-2">
      {sortedPosts.map((post) => (
        <ArticleListItem
          href={withBase(`/blog/${post.slug}`)}
          title={post.data.title}
          category={post.data.category}
          excerpt={post.data.excerpt}
          date={post.data.date}
          filterValue={post.data.tags.join(',')}
        />
      ))}
    </div>

    <p data-filter-empty class="hidden py-10 text-sm text-gray-600" role="status">No posts match this filter.</p>
  </div>

  <TagFilter slot="sidebar" tags={tags} />
</ThreeColumnLayout>
