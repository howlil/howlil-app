---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/content/PageHeader.astro";
import TagFilter from "../../components/content/TagFilterWrapper.astro";
import { sortByDateDesc, countTagOccurrences } from "../../utils/collectionHelpers";
import { withBase } from "../../lib/paths";
import { getCollection } from 'astro:content';
import { BookOpenText } from "lucide-react";

const posts = await getCollection('blog');
const sortedPosts = sortByDateDesc(posts);
const tags = countTagOccurrences(posts, (post) => post.data.tags);
---

<BaseLayout
  title="Writing - Mhd Ulil Abshar"
  description="Engineering notes on backend behavior, infrastructure, reliability, and implementation decisions."
>
  <main id="main-content" class="index-page site-ui">
    <div class="site-shell">
      <PageHeader
        title="Writing"
        description="Engineering notes on backend behavior, infrastructure, reliability, and the implementation decisions that make systems easier to operate."
      >
        <BookOpenText slot="icon" size={23} strokeWidth={1.7} aria-hidden="true" />
      </PageHeader>

      <section class="index-section" aria-labelledby="article-index-heading">
        <div class="index-section-heading">
          <h2 id="article-index-heading">Notes</h2>
          <span>{sortedPosts.length} {sortedPosts.length === 1 ? "article" : "articles"}</span>
        </div>
        <TagFilter tags={tags} title="topic" />
        <div data-filter-banner class="filter-banner hidden">
          Showing <span data-filter-label></span>
          <button type="button" data-filter-clear>clear</button>
        </div>
        <div class="index-list article-index-list">
          {sortedPosts.map((post) => (
            <a href={withBase(`/blog/${post.slug}`)} data-tags={post.data.tags.join(',')} class="index-list-item">
              <time>{post.data.date}</time>
              <span>
                <strong>{post.data.title}</strong>
                <small>{post.data.excerpt}</small>
                <em>{post.data.category ?? "Note"}</em>
              </span>
              <b aria-hidden="true">→</b>
            </a>
          ))}
        </div>
        <p data-filter-empty class="filter-empty hidden" role="status">No posts match this filter.</p>
      </section>
    </div>
  </main>
</BaseLayout>
