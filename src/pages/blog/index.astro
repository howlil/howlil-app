---
export const prerender = true;

import ThreeColumnLayout from "../../layouts/ThreeColumnLayout.astro";
import TagFilter from "../../components/content/TagFilterWrapper.astro";
import ArticleListItem from "../../components/content/ArticleListItem.astro";
import { sortByDateDesc, countTagOccurrences } from "../../utils/collectionHelpers";
import { withBase } from "../../lib/paths";
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = sortByDateDesc(posts);
const tags = countTagOccurrences(posts, (post) => post.data.tags);
---

<ThreeColumnLayout
  title="Writing - Mhd Ulil Abshar"
  headerLabel="03 / NOTES"
  headerTitle="Technical writing"
  headerDescription="Notes on backend systems, infrastructure, software engineering, and the decisions behind production systems."
>
  <div slot="content">
    <div data-filter-banner class="hidden mb-3 border-y border-gray-200 py-2 font-mono text-[10px] text-gray-500">
      <span>FILTER / </span>
      <span data-filter-label class="text-gray-800"></span>
      <button type="button" data-filter-clear class="ml-3 min-h-8 text-gray-600 underline underline-offset-2 hover:text-gray-900">clear</button>
    </div>

    <div class="border-t border-gray-300">
      {sortedPosts.map((post) => (
        <ArticleListItem
          href={withBase(`/blog/${post.slug}`)}
          title={post.data.title}
          category={post.data.category}
          excerpt={post.data.excerpt}
          date={post.data.date}
          filterValue={post.data.tags.join(',')}
        />
      ))}
    </div>

    <p data-filter-empty class="hidden py-8 text-sm text-gray-600" role="status">No posts match this filter.</p>
  </div>

  <TagFilter slot="sidebar" tags={tags} />
</ThreeColumnLayout>
