---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";
import { NAV_LINKS } from "../constants/navigation";
import { workExperiences } from "../data/about";
import { sortByDateDesc } from "../utils/collectionHelpers";
import { withBase } from "../lib/paths";
import { getCollection } from "astro:content";

const sortedPosts = sortByDateDesc(await getCollection("blog"));
const latestPosts = sortedPosts.slice(0, 3);

const sortedProjects = sortByDateDesc(await getCollection("projects"));
const featuredProjects = sortedProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const selectedProjects = (featuredProjects.length > 0 ? featuredProjects : sortedProjects).slice(0, 3);
const flagshipProject = selectedProjects[0];
const supportingProjects = selectedProjects.slice(1);
const resumeHref = NAV_LINKS.find((link) => link.name === 'Resume')?.href;
const linkedInHref = SITE.social.find((url) => url.includes('linkedin.com'));
const siteUrl = Astro.site?.href || SITE.url;
const yearOf = (date: string) => date.slice(0, 4);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": SITE.name,
    "url": new URL(withBase('/'), siteUrl).href,
    "sameAs": SITE.social,
    "jobTitle": SITE.jobTitle,
    "description": SITE.description
  })} />

  <main id="main-content" class="site-ui pb-20 pt-24">
    <div class="site-shell">
      <section class="border-b border-gray-300 pb-14 pt-6 sm:pb-18 lg:pb-24" aria-labelledby="home-heading">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-10">
          <div class="lg:col-span-9">
            <div class="mb-8 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-gray-600">
              <span class="font-semibold text-gray-900">{SITE.name}</span>
              <span aria-hidden="true">/</span>
              <span>Backend &amp; platform engineering</span>
            </div>

            <h1 id="home-heading" class="max-w-5xl text-[clamp(3.3rem,8vw,7.2rem)] font-bold leading-[0.9] tracking-[-0.06em] text-gray-900">
              I build systems that stay correct when the happy path ends.
            </h1>
          </div>

          <aside class="self-end lg:col-span-3 lg:pb-2" aria-label="Engineering focus">
            <p class="text-sm leading-6 text-gray-600">
              Payment state, backend contracts, durable data, and infrastructure boundaries.
            </p>
            <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm">
              <a href={withBase('/projects')} class="font-semibold text-gray-900 hover:underline underline-offset-4">Work</a>
              <a href="https://github.com/howlil" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">GitHub</a>
              {linkedInHref && <a href={linkedInHref} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">LinkedIn</a>}
              {resumeHref && <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">Resume</a>}
            </div>
          </aside>
        </div>
      </section>

      {flagshipProject && (
        <section class="py-16 lg:py-24" aria-labelledby="flagship-heading">
          <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-10">
            <div class="lg:col-span-2">
              <p class="font-mono text-xs text-gray-500">01 / FLAGSHIP</p>
              <p class="mt-3 text-sm text-gray-500">{yearOf(flagshipProject.data.date)}</p>
            </div>

            <div class="lg:col-span-7">
              <h2 id="flagship-heading" class="max-w-3xl text-4xl font-bold leading-[1.02] tracking-[-0.045em] text-gray-900 sm:text-5xl lg:text-6xl">
                {flagshipProject.data.title}
              </h2>
              <p class="mt-6 max-w-2xl text-lg leading-8 text-gray-600">
                {flagshipProject.data.summary ?? flagshipProject.data.excerpt}
              </p>

              {flagshipProject.data.caseStudySummary && (
                <div class="mt-10 max-w-3xl border-l border-gray-300 pl-6 sm:pl-8">
                  <p class="text-sm font-semibold text-gray-900">The engineering decision</p>
                  <p class="mt-3 text-xl leading-8 text-gray-800">
                    {flagshipProject.data.caseStudySummary.decision}
                  </p>
                  <p class="mt-5 text-sm leading-6 text-gray-600">
                    {flagshipProject.data.caseStudySummary.problem}
                  </p>
                </div>
              )}
            </div>

            <div class="lg:col-span-3 lg:pt-2">
              {flagshipProject.data.role && (
                <div class="border-t border-gray-300 pt-4">
                  <p class="text-xs text-gray-500">Role</p>
                  <p class="mt-2 text-sm leading-6 text-gray-800">{flagshipProject.data.role}</p>
                </div>
              )}

              {flagshipProject.data.engineeringFocus.length > 0 && (
                <div class="mt-6 border-t border-gray-300 pt-4">
                  <p class="text-xs text-gray-500">Focus</p>
                  <p class="mt-2 text-sm leading-6 text-gray-700">{flagshipProject.data.engineeringFocus.join(' · ')}</p>
                </div>
              )}

              {flagshipProject.data.caseStudySummary && (
                <div class="mt-6 border-t border-gray-300 pt-4">
                  <p class="text-xs text-gray-500">Outcome</p>
                  <p class="mt-2 text-sm leading-6 text-gray-700">{flagshipProject.data.caseStudySummary.result}</p>
                </div>
              )}

              <a href={withBase(`/projects/${flagshipProject.slug}`)} class="mt-8 inline-block text-sm font-semibold text-gray-900 hover:underline underline-offset-4">
                Read the case study
              </a>
            </div>
          </div>
        </section>
      )}

      {supportingProjects.length > 0 && (
        <section class="border-y border-gray-300" aria-labelledby="more-selected-heading">
          <div class="grid lg:grid-cols-12">
            <div class="py-8 lg:col-span-3 lg:pr-8">
              <h2 id="more-selected-heading" class="text-sm font-semibold text-gray-900">More selected work</h2>
              <p class="mt-2 text-sm leading-6 text-gray-600">Different systems, less ceremony.</p>
            </div>

            <div class="lg:col-span-9 lg:border-l lg:border-gray-300">
              {supportingProjects.map((project, index) => (
                <a href={withBase(`/projects/${project.slug}`)} class="group grid gap-3 border-t border-gray-300 py-7 first:border-t-0 lg:grid-cols-[3rem_minmax(0,1fr)_auto] lg:gap-x-6 lg:px-8">
                  <span class="font-mono text-xs text-gray-500">{String(index + 2).padStart(2, '0')}</span>
                  <div>
                    <h3 class="text-2xl font-semibold tracking-tight text-gray-900 group-hover:underline underline-offset-4">{project.data.title}</h3>
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-600">{project.data.summary ?? project.data.excerpt}</p>
                    {project.data.engineeringFocus.length > 0 && (
                      <p class="mt-3 text-xs text-gray-500">{project.data.engineeringFocus.join(' · ')}</p>
                    )}
                  </div>
                  <span class="text-sm text-gray-500 lg:text-right">{yearOf(project.data.date)}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      <section class="py-16 lg:py-20" aria-labelledby="experience-heading">
        <div class="grid gap-8 lg:grid-cols-12 lg:gap-x-10">
          <div class="lg:col-span-3">
            <h2 id="experience-heading" class="text-sm font-semibold text-gray-900">Experience</h2>
            <a href={withBase('/about')} class="mt-3 inline-block text-sm text-gray-600 hover:text-gray-900">Full background</a>
          </div>

          <div class="lg:col-span-9">
            {workExperiences.map((experience) => (
              <article class="grid gap-2 border-t border-gray-300 py-5 first:border-t-0 sm:grid-cols-[minmax(0,1fr)_minmax(11rem,0.7fr)_auto] sm:gap-x-6">
                <div>
                  <h3 class="font-semibold text-gray-900">{experience.company}</h3>
                  {experience.points[0] && <p class="mt-1 max-w-2xl text-sm leading-6 text-gray-600">{experience.points[0]}</p>}
                </div>
                <p class="text-sm text-gray-600">{experience.position}</p>
                <p class="text-sm text-gray-500 sm:text-right">{experience.period}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="border-t border-gray-300 pt-10" aria-labelledby="writing-heading">
        <div class="grid gap-8 lg:grid-cols-12 lg:gap-x-10">
          <div class="lg:col-span-3">
            <h2 id="writing-heading" class="text-sm font-semibold text-gray-900">Notes</h2>
            <a href={withBase('/blog')} class="mt-3 inline-block text-sm text-gray-600 hover:text-gray-900">All writing</a>
          </div>

          <ol class="lg:col-span-9">
            {latestPosts.length > 0 ? (
              latestPosts.map((post, index) => (
                <li class="border-t border-gray-300 first:border-t-0">
                  <a href={withBase(`/blog/${post.slug}`)} class="group grid grid-cols-[2.5rem_minmax(0,1fr)_auto] items-baseline gap-4 py-4">
                    <span class="font-mono text-xs text-gray-500">{String(index + 1).padStart(2, '0')}</span>
                    <span class="text-sm text-gray-800 group-hover:underline underline-offset-4">{post.data.title}</span>
                    <span class="text-xs text-gray-500">{post.data.date}</span>
                  </a>
                </li>
              ))
            ) : (
              <li class="py-4 text-sm text-gray-500">No writing yet.</li>
            )}
          </ol>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
