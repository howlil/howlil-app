---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectShowcase from "../components/content/ProjectShowcase.astro";
import { SITE } from "../config/site";
import { NAV_LINKS } from "../constants/navigation";
import { workExperiences } from "../data/about";
import { sortByDateDesc } from "../utils/collectionHelpers";
import { withBase } from "../lib/paths";
import { getCollection } from "astro:content";

const sortedPosts = sortByDateDesc(await getCollection("blog"));
const latestPosts = sortedPosts.slice(0, 4);
const sortedProjects = sortByDateDesc(await getCollection("projects"));
const featuredProjects = sortedProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const selectedProjects = (featuredProjects.length > 0 ? featuredProjects : sortedProjects).slice(0, 3);
const resumeHref = NAV_LINKS.find((link) => link.name === 'Resume')?.href;
const linkedInHref = SITE.social.find((url) => url.includes('linkedin.com'));
const siteUrl = Astro.site?.href || SITE.url;
const yearOf = (date: string) => date.slice(0, 4);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": SITE.name,
    "url": new URL(withBase('/'), siteUrl).href,
    "sameAs": SITE.social,
    "jobTitle": SITE.jobTitle,
    "description": SITE.description
  })} />

  <main id="main-content" class="site-ui pb-20 pt-[92px]">
    <div class="site-shell">
      <header class="pb-14 pt-6 sm:pb-16 sm:pt-8">
        <p class="eyebrow">Software Engineer · Backend & Infrastructure · Jakarta, Indonesia</p>
        <h1 class="mt-4 text-[40px] font-semibold leading-[1.02] tracking-[-0.05em] text-gray-900 sm:text-[46px]">
          {SITE.name}
        </h1>
        <p class="mt-4 max-w-[25ch] text-[25px] font-medium leading-[1.18] tracking-[-0.035em] text-gray-900 sm:text-[30px]">
          I build reliable backend systems for complex product behavior.
        </p>
        <p class="mt-5 max-w-2xl text-[15px] leading-7 text-gray-600 sm:text-[16px]">
          I work across backend services, payment workflows, stateful systems, and cloud infrastructure—making ownership, failure paths, and production behavior easier to reason about.
        </p>
        <nav class="mt-7 flex flex-wrap gap-x-5 gap-y-3 text-sm" aria-label="Profile links">
          <a href={withBase('/projects')} class="signal-link font-medium">Selected engineering work →</a>
          <a href="https://github.com/howlil" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">GitHub ↗</a>
          {linkedInHref && <a href={linkedInHref} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">LinkedIn ↗</a>}
          {resumeHref && <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">Resume ↗</a>}
        </nav>
      </header>

      <section class="border-t border-gray-200 py-11" aria-labelledby="work-heading">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow">Selected engineering work</p>
            <h2 id="work-heading" class="mt-2 text-[26px] font-semibold tracking-[-0.035em] text-gray-900 sm:text-[28px]">Systems where correctness and behavior mattered.</h2>
          </div>
          <a href={withBase('/projects')} class="signal-link text-sm">View all work →</a>
        </div>

        <div class="mt-5 divide-y divide-gray-200 border-b border-gray-200">
          {selectedProjects.map((project, index) => (
            <ProjectShowcase
              href={withBase(`/projects/${project.slug}`)}
              title={project.data.title}
              summary={project.data.summary ?? project.data.excerpt}
              date={yearOf(project.data.date)}
              index={index}
              role={project.data.role}
              engineeringFocus={project.data.engineeringFocus}
              tags={project.data.tags}
              repository={project.data.repository}
              caseStudySummary={project.data.caseStudySummary}
            />
          ))}
        </div>
      </section>

      <section class="border-t border-gray-200 py-11" aria-labelledby="experience-heading">
        <div class="grid gap-7 md:grid-cols-[15rem_minmax(0,1fr)] md:gap-10">
          <div>
            <p class="eyebrow">Experience</p>
            <h2 id="experience-heading" class="mt-2 text-[25px] font-semibold leading-tight tracking-[-0.035em] text-gray-900">
              Engineering across operational product domains.
            </h2>
            <p class="mt-4 text-sm leading-6 text-gray-600">
              Backend and full-stack work spanning logistics, payments, school operations, mentoring, analytics, and cloud systems.
            </p>
            <a href={withBase('/about')} class="signal-link mt-5 inline-block text-sm">Full background →</a>
          </div>

          <div class="border-b border-gray-200">
            {workExperiences.slice(0, 4).map((experience) => (
              <article class="engineering-row py-4 first:border-t-0 sm:grid sm:grid-cols-[minmax(0,1fr)_8.5rem] sm:gap-5">
                <div>
                  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                    <h3 class="text-sm font-semibold text-gray-900">{experience.company}</h3>
                    <span class="text-xs text-gray-500">{experience.position}</span>
                  </div>
                  {experience.points[0] && <p class="mt-2 text-sm leading-6 text-gray-600">{experience.points[0]}</p>}
                </div>
                <p class="mt-2 font-mono text-[10px] text-gray-500 sm:mt-0 sm:text-right">{experience.period}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="border-t border-gray-200 py-11" aria-labelledby="writing-heading">
        <div class="grid gap-7 md:grid-cols-[15rem_minmax(0,1fr)] md:gap-10">
          <div>
            <p class="eyebrow">Writing</p>
            <h2 id="writing-heading" class="mt-2 text-[25px] font-semibold tracking-[-0.035em] text-gray-900">Notes from building systems.</h2>
            <a href={withBase('/blog')} class="signal-link mt-5 inline-block text-sm">All writing →</a>
          </div>

          <div class="border-b border-gray-200">
            {latestPosts.map((post) => (
              <article class="engineering-row py-4 first:border-t-0">
                <a href={withBase(`/blog/${post.slug}`)} class="group grid gap-2 sm:grid-cols-[minmax(0,1fr)_7rem] sm:items-baseline sm:gap-5">
                  <h3 class="text-[16px] font-semibold leading-6 tracking-[-0.02em] text-gray-900 group-hover:text-[var(--color-link)]">{post.data.title}</h3>
                  <time class="font-mono text-[10px] text-gray-500 sm:text-right">{post.data.date}</time>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
