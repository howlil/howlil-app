---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/about/SocialLinks";
import SectionHeader from "../components/content/SectionHeader.astro";
import ArrowLink from "../components/content/ArrowLink.astro";
import { SITE } from "../config/site";
import { sortByDateDesc } from "../utils/collectionHelpers";
import { withBase } from "../lib/paths";
import { getCollection } from "astro:content";

const sortedPosts = sortByDateDesc(await getCollection("blog"));
const latestPosts = sortedPosts.slice(0, 3);

const sortedProjects = sortByDateDesc(await getCollection("projects"));
const recentProjects = sortedProjects.slice(0, 2);
const siteUrl = Astro.site?.href || SITE.url;
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": SITE.name,
    "url": new URL(withBase('/'), siteUrl).href,
    "sameAs": SITE.social,
    "jobTitle": SITE.jobTitle,
    "description": SITE.description
  })} />

  <main id="main-content" class="pt-20 pb-16 px-6">
    <div class="max-w-2xl mx-auto">
      <section class="mb-14">
        <img
          src={withBase("/profile.webp")}
          alt={SITE.name}
          width="96"
          height="96"
          decoding="async"
          fetchpriority="high"
          class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover mb-6 border border-gray-200"
        />
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-800 mb-4">
          Hi, I'm {SITE.shortName} <span class="inline-block">👋</span>
        </h1>
        <p class="text-base text-gray-700 leading-7 mb-6">
          I build backend systems and fullstack solutions with a focus on reliability,
          automation, and clear APIs. Most of my work is in Node.js/TypeScript, from
          logistics and mentoring platforms to school systems and ticketing, handling
          payments, real-time features, and deployment pipelines so things stay stable
          in production. I like diving into infrastructure, DevOps, and how architecture
          choices affect long-term maintainability.
        </p>
        <ArrowLink href={withBase("/about")} label="Explore My Story" direction="forward" underline={true} />
      </section>

      <section class="mb-14">
        <SectionHeader title="Latest posts" linkHref={withBase("/blog")} linkLabel="See all posts" />
        <ul class="space-y-3">
          {latestPosts.length > 0 ? (
            latestPosts.map((post) => (
              <li>
                <a
                  href={withBase(`/blog/${post.slug}`)}
                  class="block text-gray-700 hover:text-gray-900 transition-colors"
                >
                  {post.data.title}
                </a>
              </li>
            ))
          ) : (
            <li class="text-sm text-gray-500">No posts yet.</li>
          )}
        </ul>
      </section>

      <section class="mb-14">
        <SectionHeader title="Recent projects" linkHref={withBase("/projects")} linkLabel="See all projects" />
        <ul class="space-y-4">
          {recentProjects.length > 0 ? (
            recentProjects.map((project) => (
              <li>
                <a
                  href={withBase(`/projects/${project.slug}`)}
                  class="group block p-4 rounded-lg border border-gray-200 hover:border-gray-400 transition-colors"
                >
                  <h3 class="font-semibold text-gray-800 group-hover:text-gray-900">
                    {project.data.title}
                  </h3>
                  <p class="text-sm text-gray-600 mt-1 leading-6">
                    {project.data.excerpt}
                  </p>
                </a>
              </li>
            ))
          ) : (
            <li class="text-sm text-gray-500">No projects yet.</li>
          )}
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Get in Touch</h2>
        <p class="text-sm text-gray-600 mb-4 leading-6">
          Feel free to reach out via social media.
        </p>
        <SocialLinks client:visible orientation="horizontal" />
      </section>
    </div>
  </main>
</BaseLayout>
