---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import CompanyLogo from "../components/about/CompanyLogo.astro";
import TechnologyBadges from "../components/about/TechnologyBadges.astro";
import { PROFILE } from "../config/profile";
import { SITE } from "../config/site";
import ProfileActions from "../components/interactive/ProfileActions";
import ProjectArchiveCard from "../features/projects/ProjectArchiveCard.astro";
import ProjectCard from "../features/projects/ProjectCard.astro";
import { getFeaturedProjects } from "../features/projects/model";
import { workExperiences } from "../data/about";
import { withBase } from "../lib/paths";
import { getCollection } from "astro:content";
import { Briefcase, Code2, Star } from "lucide-react";
import { FaGithub } from "react-icons/fa6";
import {
  SiDocker,
  SiExpress,
  SiGithubactions,
  SiGo,
  SiGooglecloud,
  SiKubernetes,
  SiMysql,
  SiNestjs,
  SiPostgresql,
  SiTerraform,
  SiTypescript,
  SiWebrtc,
} from "@icons-pack/react-simple-icons";

const selectedProjects = getFeaturedProjects(await getCollection("projects"), 3);
const siteUrl = Astro.site?.href || SITE.url;

const stackItems = [
  { name: "Go", Icon: SiGo, color: "#00ADD8" },
  { name: "TypeScript", Icon: SiTypescript, color: "#3178C6" },
  { name: "Express", Icon: SiExpress, color: "#3f423d" },
  { name: "NestJS", Icon: SiNestjs, color: "#E0234E" },
  { name: "PostgreSQL", Icon: SiPostgresql, color: "#4169E1" },
  { name: "MySQL", Icon: SiMysql, color: "#4479A1" },
  { name: "Docker", Icon: SiDocker, color: "#2496ED" },
  { name: "Kubernetes", Icon: SiKubernetes, color: "#326CE5" },
  { name: "Google Cloud", Icon: SiGooglecloud, color: "#4285F4" },
  { name: "Terraform", Icon: SiTerraform, color: "#844FBA" },
  { name: "GitHub Actions", Icon: SiGithubactions, color: "#2088FF" },
  { name: "WebRTC", Icon: SiWebrtc, color: "#333333" },
];
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": SITE.name,
    "url": new URL(withBase("/"), siteUrl).href,
    "sameAs": SITE.social,
    "jobTitle": SITE.jobTitle,
    "description": SITE.description
  })} />

  <main id="main-content" class="portfolio-main site-ui">
    <div class="site-shell">
      <section id="home" class="portfolio-intro" aria-labelledby="profile-heading">
        <h1 id="profile-heading" class="portfolio-name">{SITE.name}</h1>

        <div class="portfolio-copy">
          <p>👋 Hey! I’m a <strong>backend-focused software engineer</strong> building dependable APIs, payment flows, and cloud infrastructure. I work <strong>remotely from Indonesia</strong>.</p>
          <p>I turn product requirements into <strong>clear, reliable systems</strong>, focusing on backend correctness while still shipping across the full stack.</p>
          <p>On the side, I build and maintain <strong>open-source projects</strong> and write about the engineering decisions behind them.</p>
        </div>

        <ProfileActions
          client:load
          email={PROFILE.email}
          githubHref={PROFILE.links.github}
          linkedInHref={PROFILE.links.linkedin}
          xHref={PROFILE.links.x}
          resumeHref={PROFILE.resume}
        />

        <a href={PROFILE.links.github} target="_blank" rel="noopener noreferrer" class="portfolio-activity">
          <FaGithub size={14} aria-hidden="true" />
          <span>github.com/howlil</span>
          <small>Projects, code, and recent contributions</small>
        </a>
      </section>

      <div class="section-break" aria-hidden="true"></div>

      <section id="experience" class="portfolio-section" aria-labelledby="experience-heading">
        <h2 id="experience-heading" class="portfolio-section-title"><Briefcase size={21} strokeWidth={1.8} aria-hidden="true" /> Experience</h2>

        <ol class="experience-list">
          {workExperiences.map((experience) => (
            <li class="experience-item">
              <article>
                <p class="experience-period">{experience.period}</p>
                <h3 class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
                  {experience.position}
                  <span>at</span>
                  <strong class="experience-company-name"><CompanyLogo src={experience.logo} />{experience.company}</strong>
                </h3>
                <p class="experience-company">{experience.companyDescription}</p>
                <ul class="experience-points">
                  {experience.points.map((point) => <li>{point}</li>)}
                </ul>
                <TechnologyBadges technologies={experience.technologies} label={`Technologies used at ${experience.company}`} />
              </article>
            </li>
          ))}
        </ol>
      </section>

      <div class="section-break" aria-hidden="true"></div>

      <section id="projects" class="portfolio-section" aria-labelledby="projects-heading">
        <h2 id="projects-heading" class="portfolio-section-title"><Star size={22} strokeWidth={1.8} aria-hidden="true" /> Selected Projects</h2>

        <div class="project-grid">
          {selectedProjects.map((project, index) => <ProjectCard project={project} index={index} />)}
          <ProjectArchiveCard />
        </div>
      </section>

      <div class="section-break" aria-hidden="true"></div>

      <section id="stack" class="portfolio-section portfolio-stack" aria-labelledby="stack-heading">
        <h2 id="stack-heading" class="portfolio-section-title"><Code2 size={22} strokeWidth={1.8} aria-hidden="true" /> Tech Stack</h2>

        <ul class="stack-grid">
          {stackItems.map(({ name, Icon, color }) => (
            <li class="stack-item" style={`--stack-color:${color}`}>
              <Icon size={40} aria-hidden="true" />
              <span>{name}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>

</BaseLayout>
