---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectShowcase from "../components/content/ProjectShowcase.astro";
import { SITE } from "../config/site";
import { NAV_LINKS } from "../constants/navigation";
import { workExperiences } from "../data/about";
import { sortByDateDesc } from "../utils/collectionHelpers";
import { withBase } from "../lib/paths";
import { getCollection } from "astro:content";

const sortedPosts = sortByDateDesc(await getCollection("blog"));
const latestPosts = sortedPosts.slice(0, 4);
const sortedProjects = sortByDateDesc(await getCollection("projects"));
const featuredProjects = sortedProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const selectedProjects = (featuredProjects.length > 0 ? featuredProjects : sortedProjects).slice(0, 3);
const resumeHref = NAV_LINKS.find((link) => link.name === 'Resume')?.href;
const linkedInHref = SITE.social.find((url) => url.includes('linkedin.com'));
const siteUrl = Astro.site?.href || SITE.url;
const yearOf = (date: string) => date.slice(0, 4);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": SITE.name,
    "url": new URL(withBase('/'), siteUrl).href,
    "sameAs": SITE.social,
    "jobTitle": SITE.jobTitle,
    "description": SITE.description
  })} />

  <main id="main-content" class="site-ui pb-20 pt-[76px]">
    <div class="site-shell">
      <header class="max-w-3xl pb-12 pt-8 sm:pb-14 sm:pt-10">
        <p class="eyebrow">Software Engineer · Backend & Infrastructure · Jakarta, Indonesia</p>
        <h1 class="mt-4 text-[38px] font-semibold leading-[1.02] tracking-[-0.045em] text-gray-900 sm:text-[44px]">
          {SITE.name}
        </h1>
        <p class="mt-4 max-w-[29ch] text-[23px] font-medium leading-[1.2] tracking-[-0.03em] text-gray-900 sm:text-[28px]">
          I build reliable backend systems for stateful, asynchronous product workflows.
        </p>
        <p class="mt-4 max-w-2xl text-[15px] leading-7 text-gray-600">
          Backend services, payments, data systems, and cloud infrastructure—with explicit ownership, failure handling, and production behavior.
        </p>
        <nav class="mt-6 flex flex-wrap gap-x-5 gap-y-3 text-sm" aria-label="Profile links">
          <a href="https://github.com/howlil" target="_blank" rel="noopener noreferrer" class="signal-link font-medium">GitHub ↗</a>
          {linkedInHref && <a href={linkedInHref} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">LinkedIn ↗</a>}
          {resumeHref && <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">Resume ↗</a>}
        </nav>
      </header>

      <section class="border-t border-gray-200 py-10 sm:py-12" aria-labelledby="work-heading">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow">Selected work</p>
            <h2 id="work-heading" class="mt-2 text-[25px] font-semibold tracking-[-0.03em] text-gray-900 sm:text-[27px]">
              Engineering work worth inspecting in depth.
            </h2>
          </div>
          <a href={withBase('/projects')} class="signal-link text-sm">All engineering work →</a>
        </div>

        <div class="mt-5 border-b border-gray-200">
          {selectedProjects.map((project, index) => (
            <ProjectShowcase
              href={withBase(`/projects/${project.slug}`)}
              title={project.data.title}
              summary={project.data.summary ?? project.data.excerpt}
              date={yearOf(project.data.date)}
              index={index}
              role={project.data.role}
              engineeringFocus={project.data.engineeringFocus}
              tags={project.data.tags}
              repository={project.data.repository}
              caseStudySummary={project.data.caseStudySummary}
            />
          ))}
        </div>
      </section>

      <section class="border-t border-gray-200 py-10 sm:py-12" aria-labelledby="experience-heading">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow">Experience</p>
            <h2 id="experience-heading" class="mt-2 text-[24px] font-semibold tracking-[-0.03em] text-gray-900">
              Backend and product engineering across operational domains.
            </h2>
          </div>
          <a href={withBase('/about')} class="signal-link text-sm">Full background →</a>
        </div>

        <div class="mt-6 border-b border-gray-200">
          {workExperiences.slice(0, 4).map((experience) => (
            <article class="engineering-row py-5 first:border-t-0 sm:grid sm:grid-cols-[8.5rem_minmax(0,1fr)] sm:gap-7">
              <p class="font-mono text-[10px] leading-5 text-gray-500">{experience.period}</p>
              <div>
                <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                  <h3 class="text-sm font-semibold text-gray-900">{experience.company}</h3>
                  <span class="text-xs text-gray-500">{experience.position}</span>
                </div>
                {experience.points[0] && <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-600">{experience.points[0]}</p>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="border-t border-gray-200 py-10 sm:py-12" aria-labelledby="writing-heading">
        <div class="flex items-end justify-between gap-5">
          <div>
            <p class="eyebrow">Writing</p>
            <h2 id="writing-heading" class="mt-2 text-[23px] font-semibold tracking-[-0.03em] text-gray-900">Notes from building systems.</h2>
          </div>
          <a href={withBase('/blog')} class="signal-link text-sm">All writing →</a>
        </div>

        <div class="mt-6 grid gap-x-8 md:grid-cols-2">
          {latestPosts.map((post) => (
            <article class="border-t border-gray-200 py-4">
              <a href={withBase(`/blog/${post.slug}`)} class="group grid gap-2 sm:grid-cols-[minmax(0,1fr)_6.5rem] sm:items-baseline sm:gap-4">
                <h3 class="text-[15px] font-semibold leading-6 tracking-[-0.015em] text-gray-900 group-hover:text-[var(--color-link)]">{post.data.title}</h3>
                <time class="font-mono text-[10px] text-gray-500 sm:text-right">{post.data.date}</time>
              </a>
            </article>
          ))}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
