---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowLink from "../components/content/ArrowLink.astro";
import FeaturedProjectItem from "../components/content/FeaturedProjectItem.astro";
import { SITE } from "../config/site";
import { NAV_LINKS } from "../constants/navigation";
import { workExperiences } from "../data/about";
import { sortByDateDesc } from "../utils/collectionHelpers";
import { withBase } from "../lib/paths";
import { getCollection } from "astro:content";

const sortedPosts = sortByDateDesc(await getCollection("blog"));
const latestPosts = sortedPosts.slice(0, 3);

const sortedProjects = sortByDateDesc(await getCollection("projects"));
const featuredProjects = sortedProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const selectedProjects = (featuredProjects.length > 0 ? featuredProjects : sortedProjects).slice(0, 3);
const heroProject = selectedProjects[0];
const heroDiagram = heroProject?.data.diagrams[0];
const heroDiagramSrc = heroDiagram
  ? heroDiagram.src.startsWith('/')
    ? withBase(heroDiagram.src)
    : heroDiagram.src
  : undefined;
const resumeHref = NAV_LINKS.find((link) => link.name === 'Resume')?.href;
const linkedInHref = SITE.social.find((url) => url.includes('linkedin.com'));
const siteUrl = Astro.site?.href || SITE.url;
const yearOf = (date: string) => date.slice(0, 4);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": SITE.name,
    "url": new URL(withBase('/'), siteUrl).href,
    "sameAs": SITE.social,
    "jobTitle": SITE.jobTitle,
    "description": SITE.description
  })} />

  <main id="main-content" class="pt-24 pb-16">
    <div class="site-shell">
      <section class="grid gap-10 pb-16 lg:grid-cols-12 lg:items-end lg:gap-x-12 lg:pb-20">
        <div class="lg:col-span-7">
          <p class="site-ui mb-4 text-sm font-semibold tracking-tight text-gray-900">{SITE.name}</p>
          <h1 class="text-balance max-w-4xl text-[2.85rem] font-bold leading-[1.02] tracking-[-0.045em] text-gray-900 sm:text-[3.65rem] lg:text-[4.25rem]">
            Backend systems for reliable state, data &amp; infrastructure.
          </h1>
          <p class="site-ui mt-6 max-w-2xl text-lg leading-8 text-gray-600">
            Software engineer designing payment workflows, data-heavy services, and cloud infrastructure around explicit state, correctness, and operability.
          </p>
          <div class="site-ui mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
            <ArrowLink href={withBase("/projects")} label="Work" direction="forward" underline={true} />
            <a href="https://github.com/howlil" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">GitHub</a>
            {linkedInHref && <a href={linkedInHref} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">LinkedIn</a>}
            {resumeHref && <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">Resume</a>}
          </div>
        </div>

        {heroDiagram && heroDiagramSrc && heroProject && (
          <figure class="border-y border-gray-200 py-5 lg:col-span-5">
            <div class="flex min-h-52 items-center justify-center bg-gray-50 p-4">
              <img
                src={heroDiagramSrc}
                alt={heroDiagram.alt}
                class="max-h-56 w-full object-contain"
              />
            </div>
            <figcaption class="site-ui mt-3 flex flex-wrap items-baseline justify-between gap-2 text-xs leading-5 text-gray-500">
              <span>Architecture excerpt · {heroProject.data.title}</span>
              <span>{heroDiagram.title}</span>
            </figcaption>
          </figure>
        )}
      </section>

      <section class="pb-16 lg:pb-20" aria-labelledby="selected-work-heading">
        <div class="grid gap-5 border-t border-gray-200 pt-10 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
          <div>
            <p class="site-ui text-sm font-medium text-gray-600">Engineering case studies</p>
            <h2 id="selected-work-heading" class="mt-2 text-3xl font-semibold tracking-tight text-gray-900">Selected Work</h2>
            <p class="site-ui mt-3 max-w-2xl text-[15px] leading-6 text-gray-600">
              Systems where state, authorization, persistence, or failure boundaries materially shaped the implementation.
            </p>
          </div>
          <a href={withBase("/projects")} class="site-ui text-sm text-gray-600 hover:text-gray-900">All work →</a>
        </div>

        <div class="mt-8 border-t border-gray-200">
          {selectedProjects.map((project, index) => {
            const primaryDiagram = project.data.diagrams[0];
            const diagram = primaryDiagram
              ? {
                  src: primaryDiagram.src.startsWith('/') ? withBase(primaryDiagram.src) : primaryDiagram.src,
                  alt: primaryDiagram.alt,
                  title: primaryDiagram.title,
                }
              : undefined;

            return (
              <FeaturedProjectItem
                href={withBase(`/projects/${project.slug}`)}
                index={index + 1}
                title={project.data.title}
                excerpt={project.data.summary ?? project.data.excerpt}
                date={yearOf(project.data.date)}
                engineeringFocus={project.data.engineeringFocus}
                diagram={diagram}
                caseStudySummary={project.data.caseStudySummary}
              />
            );
          })}
        </div>
      </section>

      <div class="border-t border-gray-200 pt-10">
        <section class="pb-14" aria-labelledby="experience-heading">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <h2 id="experience-heading" class="text-2xl font-semibold tracking-tight text-gray-900">Experience</h2>
              <p class="site-ui mt-2 text-sm text-gray-600">Professional work, kept concise so engineering evidence stays primary.</p>
            </div>
            <a href={withBase("/about")} class="site-ui text-sm text-gray-600 hover:text-gray-900">Full background →</a>
          </div>

          <div class="mt-6 grid gap-y-7">
            {workExperiences.map((experience) => (
              <article class="grid gap-2 md:grid-cols-[minmax(0,1fr)_minmax(12rem,0.55fr)_auto] md:gap-x-8">
                <div class="min-w-0">
                  <h3 class="text-lg font-semibold tracking-tight text-gray-900">{experience.company}</h3>
                  {experience.points[0] && (
                    <p class="site-ui mt-2 max-w-3xl text-[15px] leading-6 text-gray-600">{experience.points[0]}</p>
                  )}
                </div>
                <p class="site-ui text-sm text-gray-500 md:pt-1">{experience.position}</p>
                <p class="site-ui text-sm text-gray-500 md:pt-1 md:whitespace-nowrap">{experience.period}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="pb-4" aria-labelledby="writing-heading">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 id="writing-heading" class="text-2xl font-semibold tracking-tight text-gray-900">Writing</h2>
            <a href={withBase("/blog")} class="site-ui text-sm text-gray-600 hover:text-gray-900">All writing →</a>
          </div>

          <ul class="mt-5 divide-y divide-gray-200">
            {latestPosts.length > 0 ? (
              latestPosts.map((post) => (
                <li>
                  <a href={withBase(`/blog/${post.slug}`)} class="group site-ui grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-4 py-4">
                    <span class="text-sm text-gray-800 group-hover:underline underline-offset-4">{post.data.title}</span>
                    <span class="whitespace-nowrap font-mono text-xs text-gray-500">{post.data.date}</span>
                  </a>
                </li>
              ))
            ) : (
              <li class="py-4 text-sm text-gray-500">No writing yet.</li>
            )}
          </ul>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>
