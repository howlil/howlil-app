---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";
import { NAV_LINKS } from "../constants/navigation";
import { workExperiences, skills } from "../data/about";
import { sortByDateDesc } from "../utils/collectionHelpers";
import { withBase } from "../lib/paths";
import { getCollection } from "astro:content";

const sortedPosts = sortByDateDesc(await getCollection("blog"));
const latestPosts = sortedPosts.slice(0, 3);
const sortedProjects = sortByDateDesc(await getCollection("projects"));
const featuredProjects = sortedProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const selectedProjects = (featuredProjects.length > 0 ? featuredProjects : sortedProjects).slice(0, 4);
const resumeHref = NAV_LINKS.find((link) => link.name === "Resume")?.href;
const linkedInHref = SITE.social.find((url) => url.includes("linkedin.com"));
const siteUrl = Astro.site?.href || SITE.url;
const yearOf = (date: string) => date.slice(0, 4);
const projectInitials = (title: string) =>
  title
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0])
    .join("")
    .toUpperCase();
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": SITE.name,
    "url": new URL(withBase("/"), siteUrl).href,
    "sameAs": SITE.social,
    "jobTitle": SITE.jobTitle,
    "description": SITE.description
  })} />

  <main id="main-content" class="portfolio-main site-ui">
    <div class="site-shell">
      <section class="portfolio-intro" aria-labelledby="profile-heading">
        <p class="portfolio-kicker">Software engineer · Jakarta, Indonesia</p>
        <h1 id="profile-heading" class="portfolio-name">{SITE.name}</h1>

        <div class="portfolio-copy">
          <p>👋 I’m a <strong>backend-focused software engineer</strong> who likes turning ambiguous product problems into reliable systems.</p>
          <p>I work across <strong>APIs, stateful workflows, payments, and infrastructure</strong>, with a bias toward explicit ownership, safe failure modes, and boring operations.</p>
          <p>On the side, I build and maintain <strong>open-source projects</strong> and write about the engineering decisions behind them.</p>
        </div>

        <div class="portfolio-actions" aria-label="Profile links">
          <a href="https://github.com/howlil" target="_blank" rel="noopener noreferrer" class="portfolio-button">View GitHub ↗</a>
          {linkedInHref && <a href={linkedInHref} target="_blank" rel="noopener noreferrer" class="portfolio-icon-link">LinkedIn ↗</a>}
          {resumeHref && <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="portfolio-icon-link">Resume ↗</a>}
        </div>

        <div class="portfolio-signal">
          <span class="portfolio-signal-dot" aria-hidden="true"></span>
          <span>Currently building systems, tools, and a deeper backend practice.</span>
        </div>
      </section>

      <section class="portfolio-section" aria-labelledby="projects-heading">
        <div class="portfolio-section-heading">
          <div>
            <p class="portfolio-kicker">01 / Selected work</p>
            <h2 id="projects-heading">Projects I’ve shipped and studied.</h2>
          </div>
          <a href={withBase("/projects")} class="portfolio-inline-link">See all →</a>
        </div>

        <div class="project-grid">
          {selectedProjects.map((project, index) => (
            <a
              href={withBase("/projects/" + project.slug)}
              class="project-card"
              data-tone={String((index % 3) + 1)}
            >
              <div class="project-card-meta">
                <span>{yearOf(project.data.date)}</span>
                <span aria-hidden="true">↗</span>
              </div>
              <div class="project-art" aria-hidden="true">
                <span>{projectInitials(project.data.title)}</span>
              </div>
              <div class="project-card-body">
                <h3>{project.data.title}</h3>
                <p>{project.data.summary ?? project.data.excerpt}</p>
                <span class="project-card-tags">{project.data.tags.slice(0, 3).join(" · ")}</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="portfolio-section" aria-labelledby="experience-heading">
        <div class="portfolio-section-heading">
          <div>
            <p class="portfolio-kicker">02 / Experience</p>
            <h2 id="experience-heading">Where I’ve worked on production systems.</h2>
          </div>
          <a href={withBase("/about")} class="portfolio-inline-link">Full background →</a>
        </div>

        <div class="timeline">
          {workExperiences.map((experience) => (
            <article class="timeline-item">
              <div class="timeline-period">{experience.period}</div>
              <div class="timeline-content">
                <div class="timeline-heading">
                  <span class="company-mark" aria-hidden="true">{experience.company.slice(0, 1)}</span>
                  <h3>{experience.company}</h3>
                  <span>{experience.position}</span>
                </div>
                {experience.points[0] && <p>{experience.points[0]}</p>}
                <div class="timeline-tags">{experience.technologies.slice(0, 5).join(" · ")}</div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="portfolio-section" aria-labelledby="stack-heading">
        <div class="portfolio-section-heading">
          <div>
            <p class="portfolio-kicker">03 / Toolkit</p>
            <h2 id="stack-heading">Tools I use to make systems work.</h2>
          </div>
        </div>

        <div class="stack-grid">
          {skills.slice(0, 18).map((skill) => <span class="stack-item">{skill}</span>)}
        </div>
      </section>

      <section class="portfolio-section portfolio-writing" aria-labelledby="writing-heading">
        <div class="portfolio-section-heading">
          <div>
            <p class="portfolio-kicker">04 / Writing</p>
            <h2 id="writing-heading">Notes from building systems.</h2>
          </div>
          <a href={withBase("/blog")} class="portfolio-inline-link">All writing →</a>
        </div>

        <div class="writing-list">
          {latestPosts.map((post) => (
            <a href={withBase("/blog/" + post.slug)} class="writing-item">
              <time datetime={post.data.date}>{post.data.date}</time>
              <span>
                <strong>{post.data.title}</strong>
                <small>{post.data.excerpt}</small>
              </span>
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>

      <section class="portfolio-contact" aria-label="Contact">
        <p class="portfolio-kicker">Let’s build something useful.</p>
        <p>If you’re working on a product where backend correctness and delivery speed both matter, I’d be happy to compare notes.</p>
        <div class="portfolio-actions">
          <a href="https://github.com/howlil" target="_blank" rel="noopener noreferrer" class="portfolio-button">GitHub ↗</a>
          {linkedInHref && <a href={linkedInHref} target="_blank" rel="noopener noreferrer" class="portfolio-icon-link">LinkedIn ↗</a>}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
