---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectExplorer from "../components/interactive/ProjectExplorer";
import { SITE } from "../config/site";
import { NAV_LINKS } from "../constants/navigation";
import { workExperiences } from "../data/about";
import { sortByDateDesc } from "../utils/collectionHelpers";
import { withBase } from "../lib/paths";
import { getCollection } from "astro:content";

const sortedPosts = sortByDateDesc(await getCollection("blog"));
const latestPosts = sortedPosts.slice(0, 4);
const sortedProjects = sortByDateDesc(await getCollection("projects"));
const featuredProjects = sortedProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const selectedProjects = (featuredProjects.length > 0 ? featuredProjects : sortedProjects).slice(0, 3);
const resumeHref = NAV_LINKS.find((link) => link.name === 'Resume')?.href;
const linkedInHref = SITE.social.find((url) => url.includes('linkedin.com'));
const siteUrl = Astro.site?.href || SITE.url;
const yearOf = (date: string) => date.slice(0, 4);

const explorerProjects = selectedProjects.map((project, index) => ({
  slug: project.slug,
  sequence: String(index + 1).padStart(2, '0'),
  title: project.data.title,
  year: yearOf(project.data.date),
  summary: project.data.summary ?? project.data.excerpt,
  role: project.data.role,
  focus: project.data.engineeringFocus.slice(0, 3),
  stack: project.data.tags.slice(0, 4),
  result: project.data.caseStudySummary?.result,
  href: withBase(`/projects/${project.slug}`),
  repository: project.data.repository,
}));
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": SITE.name,
    "url": new URL(withBase('/'), siteUrl).href,
    "sameAs": SITE.social,
    "jobTitle": SITE.jobTitle,
    "description": SITE.description
  })} />

  <main id="main-content" class="site-ui">
    <div class="site-shell">
      <section class="frame-section grid gap-6 border-b border-gray-200 py-10 sm:py-12 md:grid-cols-[8rem_minmax(0,1fr)] md:items-center md:gap-8" aria-labelledby="profile-heading">
        <img
          src={withBase('/profile.webp')}
          alt="Mhd Ulil Abshar"
          class="aspect-square w-24 rounded-[10px] border border-gray-200 object-cover sm:w-28 md:w-32"
        />

        <div class="min-w-0">
          <p class="eyebrow">Software Engineer · Jakarta, Indonesia</p>
          <h1 id="profile-heading" class="mt-3 text-[34px] font-semibold leading-[1.02] tracking-[-0.045em] text-gray-900 sm:text-[40px]">
            {SITE.name}
          </h1>
          <p class="mt-2 text-[16px] font-medium text-gray-700 sm:text-[17px]">Backend & Infrastructure</p>
          <p class="mt-4 max-w-2xl text-[15px] leading-7 text-gray-600">
            I build reliable backend systems for stateful, asynchronous, and operational workflows.
          </p>
          <nav class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label="Profile links">
            <a href="https://github.com/howlil" target="_blank" rel="noopener noreferrer" class="signal-link font-medium">GitHub ↗</a>
            {linkedInHref && <a href={linkedInHref} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">LinkedIn ↗</a>}
            {resumeHref && <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">Resume ↗</a>}
          </nav>
        </div>
      </section>

      <section class="frame-section border-b border-gray-200 py-10 sm:py-12" aria-labelledby="work-heading">
        <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow">01 / Selected work</p>
            <h2 id="work-heading" class="mt-2 text-[24px] font-semibold tracking-[-0.03em] text-gray-900 sm:text-[27px]">
              Compare the systems, then inspect the engineering decisions.
            </h2>
          </div>
          <a href={withBase('/projects')} class="signal-link text-sm">All work →</a>
        </div>

        <ProjectExplorer client:load projects={explorerProjects} />
      </section>

      <section class="frame-section border-b border-gray-200 py-10 sm:py-12" aria-labelledby="experience-heading">
        <div class="grid gap-7 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-10">
          <div>
            <p class="eyebrow">02 / Experience</p>
            <h2 id="experience-heading" class="mt-2 text-[23px] font-semibold tracking-[-0.03em] text-gray-900">Where I shipped production systems.</h2>
            <a href={withBase('/about')} class="signal-link mt-4 inline-block text-sm">Full background →</a>
          </div>

          <div class="border-b border-gray-200">
            {workExperiences.slice(0, 4).map((experience) => (
              <article class="border-t border-gray-200 py-5 first:border-t-0 sm:grid sm:grid-cols-[8.5rem_minmax(0,1fr)] sm:gap-7">
                <p class="font-mono text-[10px] leading-5 text-gray-500">{experience.period}</p>
                <div>
                  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                    <h3 class="text-sm font-semibold text-gray-900">{experience.company}</h3>
                    <span class="text-xs text-gray-500">{experience.position}</span>
                  </div>
                  {experience.points[0] && <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-600">{experience.points[0]}</p>}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="frame-section py-10 sm:py-12" aria-labelledby="writing-heading">
        <div class="grid gap-7 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-10">
          <div>
            <p class="eyebrow">03 / Writing</p>
            <h2 id="writing-heading" class="mt-2 text-[23px] font-semibold tracking-[-0.03em] text-gray-900">Notes from building systems.</h2>
            <a href={withBase('/blog')} class="signal-link mt-4 inline-block text-sm">All writing →</a>
          </div>

          <div class="border-b border-gray-200">
            {latestPosts.map((post) => (
              <article class="border-t border-gray-200 py-4 first:border-t-0">
                <a href={withBase(`/blog/${post.slug}`)} class="group grid gap-2 sm:grid-cols-[7rem_minmax(0,1fr)_1.5rem] sm:items-baseline sm:gap-5">
                  <time class="font-mono text-[10px] text-gray-500">{post.data.date}</time>
                  <h3 class="text-[15px] font-semibold leading-6 tracking-[-0.015em] text-gray-900 group-hover:text-[var(--color-link)]">{post.data.title}</h3>
                  <span class="text-right text-gray-500 group-hover:text-gray-900" aria-hidden="true">→</span>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
