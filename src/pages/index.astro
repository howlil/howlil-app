---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";
import { NAV_LINKS } from "../constants/navigation";
import { workExperiences } from "../data/about";
import { sortByDateDesc } from "../utils/collectionHelpers";
import { withBase } from "../lib/paths";
import { getCollection } from "astro:content";

const sortedPosts = sortByDateDesc(await getCollection("blog"));
const latestPosts = sortedPosts.slice(0, 3);

const sortedProjects = sortByDateDesc(await getCollection("projects"));
const featuredProjects = sortedProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const selectedProjects = (featuredProjects.length > 0 ? featuredProjects : sortedProjects).slice(0, 3);
const selectedStack = Array.from(new Set(selectedProjects.flatMap((project) => project.data.tags))).slice(0, 7);
const resumeHref = NAV_LINKS.find((link) => link.name === 'Resume')?.href;
const linkedInHref = SITE.social.find((url) => url.includes('linkedin.com'));
const siteUrl = Astro.site?.href || SITE.url;
const yearOf = (date: string) => date.slice(0, 4);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": SITE.name,
    "url": new URL(withBase('/'), siteUrl).href,
    "sameAs": SITE.social,
    "jobTitle": SITE.jobTitle,
    "description": SITE.description
  })} />

  <main id="main-content" class="site-ui pb-16 pt-[84px]">
    <div class="site-shell">
      <header class="border-b border-gray-300 pb-10">
        <p class="font-mono text-[11px] text-gray-500">PROFILE</p>
        <h1 class="mt-4 text-3xl font-semibold tracking-[-0.03em] text-gray-900 sm:text-4xl">{SITE.name}</h1>
        <p class="mt-2 text-base font-medium text-gray-800">Software Engineer · Backend &amp; Infrastructure</p>
        <p class="mt-5 max-w-2xl text-[15px] leading-7 text-gray-600">
          I build backend services, stateful workflows, and cloud infrastructure with an emphasis on correctness, explicit boundaries, and operability.
        </p>

        <dl class="mt-8 grid border-y border-gray-300 sm:grid-cols-3">
          <div class="py-4 sm:pr-6">
            <dt class="font-mono text-[10px] uppercase tracking-[0.08em] text-gray-500">Focus</dt>
            <dd class="mt-2 text-sm text-gray-800">Backend / Platform / Reliability</dd>
          </div>
          <div class="border-t border-gray-300 py-4 sm:border-l sm:border-t-0 sm:px-6">
            <dt class="font-mono text-[10px] uppercase tracking-[0.08em] text-gray-500">Systems</dt>
            <dd class="mt-2 text-sm text-gray-800">Payments / Data / Cloud</dd>
          </div>
          <div class="border-t border-gray-300 py-4 sm:border-l sm:border-t-0 sm:pl-6">
            <dt class="font-mono text-[10px] uppercase tracking-[0.08em] text-gray-500">Stack</dt>
            <dd class="mt-2 text-sm leading-6 text-gray-800">{selectedStack.join(' / ')}</dd>
          </div>
        </dl>

        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm">
          <a href={withBase('/projects')} class="font-medium text-gray-900 hover:underline underline-offset-4">Work</a>
          <a href="https://github.com/howlil" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">GitHub ↗</a>
          {linkedInHref && <a href={linkedInHref} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">LinkedIn ↗</a>}
          {resumeHref && <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">Resume ↗</a>}
        </div>
      </header>

      <section class="border-b border-gray-300" aria-labelledby="selected-work-heading">
        <div class="flex items-center justify-between gap-4 border-b border-gray-300 py-4">
          <h2 id="selected-work-heading" class="font-mono text-[11px] font-semibold uppercase tracking-[0.08em] text-gray-700">Selected work</h2>
          <a href={withBase('/projects')} class="text-xs text-gray-500 hover:text-gray-900">View all</a>
        </div>

        <div>
          {selectedProjects.map((project, index) => (
            <article class="grid gap-3 border-b border-gray-200 py-6 last:border-b-0 sm:grid-cols-[2.5rem_minmax(0,1fr)_6rem] sm:gap-x-6">
              <span class="font-mono text-[11px] text-gray-500">{String(index + 1).padStart(2, '0')}</span>
              <div class="min-w-0">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="text-[17px] font-semibold tracking-[-0.015em] text-gray-900">
                    <a href={withBase(`/projects/${project.slug}`)} class="hover:underline underline-offset-4">{project.data.title}</a>
                  </h3>
                  {project.data.role && <span class="text-xs text-gray-500">{project.data.role}</span>}
                </div>
                <p class="mt-2 max-w-3xl text-sm leading-6 text-gray-600">{project.data.summary ?? project.data.excerpt}</p>
                <p class="mt-3 font-mono text-[10px] leading-5 text-gray-500">
                  {project.data.engineeringFocus.join(' / ')}
                  {project.data.tags.length > 0 && ` · ${project.data.tags.slice(0, 5).join(' / ')}`}
                </p>
                <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
                  <a href={withBase(`/projects/${project.slug}`)} class="font-medium text-gray-800 hover:underline underline-offset-4">Case study ↗</a>
                  {project.data.repository && <a href={project.data.repository} target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-gray-900">Repository ↗</a>}
                </div>
              </div>
              <span class="font-mono text-[11px] text-gray-500 sm:text-right">{yearOf(project.data.date)}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="border-b border-gray-300" aria-labelledby="experience-heading">
        <div class="flex items-center justify-between gap-4 border-b border-gray-300 py-4">
          <h2 id="experience-heading" class="font-mono text-[11px] font-semibold uppercase tracking-[0.08em] text-gray-700">Experience</h2>
          <a href={withBase('/about')} class="text-xs text-gray-500 hover:text-gray-900">Full background</a>
        </div>

        <div>
          {workExperiences.map((experience) => (
            <article class="grid gap-2 border-b border-gray-200 py-4 last:border-b-0 sm:grid-cols-[minmax(0,1fr)_minmax(11rem,0.55fr)_8rem] sm:gap-x-6">
              <div>
                <h3 class="text-sm font-semibold text-gray-900">{experience.company}</h3>
                {experience.points[0] && <p class="mt-1 max-w-2xl text-sm leading-6 text-gray-600">{experience.points[0]}</p>}
              </div>
              <p class="text-sm text-gray-600">{experience.position}</p>
              <p class="font-mono text-[11px] text-gray-500 sm:text-right">{experience.period}</p>
            </article>
          ))}
        </div>
      </section>

      <section aria-labelledby="writing-heading">
        <div class="flex items-center justify-between gap-4 border-b border-gray-300 py-4">
          <h2 id="writing-heading" class="font-mono text-[11px] font-semibold uppercase tracking-[0.08em] text-gray-700">Notes</h2>
          <a href={withBase('/blog')} class="text-xs text-gray-500 hover:text-gray-900">All notes</a>
        </div>

        <ol>
          {latestPosts.length > 0 ? (
            latestPosts.map((post, index) => (
              <li class="border-b border-gray-200 last:border-b-0">
                <a href={withBase(`/blog/${post.slug}`)} class="group grid grid-cols-[2.5rem_minmax(0,1fr)_6.5rem] items-baseline gap-4 py-4">
                  <span class="font-mono text-[11px] text-gray-500">{String(index + 1).padStart(2, '0')}</span>
                  <span class="text-sm text-gray-800 group-hover:underline underline-offset-4">{post.data.title}</span>
                  <span class="font-mono text-[10px] text-gray-500 text-right">{post.data.date}</span>
                </a>
              </li>
            ))
          ) : (
            <li class="py-4 text-sm text-gray-500">No writing yet.</li>
          )}
        </ol>
      </section>
    </div>
  </main>
</BaseLayout>
