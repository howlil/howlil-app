---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/about/SocialLinks.astro";
import ArrowLink from "../components/content/ArrowLink.astro";
import { SITE } from "../config/site";
import { sortByDateDesc } from "../utils/collectionHelpers";
import { withBase } from "../lib/paths";
import { getCollection } from "astro:content";

const sortedPosts = sortByDateDesc(await getCollection("blog"));
const latestPosts = sortedPosts.slice(0, 3);

const sortedProjects = sortByDateDesc(await getCollection("projects"));
const featuredProjects = sortedProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const selectedProjects = (featuredProjects.length > 0 ? featuredProjects : sortedProjects).slice(0, 3);
const siteUrl = Astro.site?.href || SITE.url;
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": SITE.name,
    "url": new URL(withBase('/'), siteUrl).href,
    "sameAs": SITE.social,
    "jobTitle": SITE.jobTitle,
    "description": SITE.description
  })} />

  <main id="main-content" class="pt-28 pb-20">
    <div class="site-shell">
      <section class="grid gap-10 pb-12 md:grid-cols-12 md:gap-8 lg:pb-14">
        <div class="md:col-span-9 lg:col-span-8">
          <h1 class="text-balance max-w-3xl text-[2.5rem] font-bold leading-[1.07] tracking-[-0.035em] text-gray-900 sm:text-5xl lg:text-[3.1rem]">
            Backend & Systems Engineer
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-gray-700">
            I work on backend systems, databases, and infrastructure for production.
          </p>
          <div class="site-ui mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
            <ArrowLink href={withBase("/projects")} label="Selected work" direction="forward" underline={true} />
            <a href="https://github.com/howlil" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">GitHub</a>
            <a href={withBase("/about")} class="text-gray-600 hover:text-gray-900">About</a>
          </div>
        </div>

        <aside class="md:col-span-3 md:border-l md:border-gray-200 md:pl-7 lg:col-span-4 lg:pl-8" aria-label="Focus areas">
          <p class="meta-label mb-3">Focus</p>
          <p class="site-ui max-w-xs text-sm leading-6 text-gray-600">
            Distributed systems · Databases · Infrastructure
          </p>
        </aside>
      </section>

      <section class="py-12 lg:py-14">
        <div class="mb-6 flex items-end justify-between gap-4">
          <h2 class="text-2xl font-semibold tracking-tight text-gray-900">Selected Work</h2>
          <a href={withBase("/projects")} class="site-ui hidden text-sm text-gray-600 hover:text-gray-900 sm:inline">All work →</a>
        </div>

        <div class="divide-y divide-gray-200 border-t border-gray-200">
          {selectedProjects.map((project, index) => (
            <a href={withBase(`/projects/${project.slug}`)} class="group grid gap-4 py-7 sm:grid-cols-[3rem_minmax(0,1fr)] sm:py-8">
              <span class="font-mono text-xs text-gray-400 pt-1">{String(index + 1).padStart(2, '0')}</span>
              <div class="min-w-0">
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                  <h3 class="text-xl font-semibold tracking-tight text-gray-900 group-hover:underline underline-offset-4">{project.data.title}</h3>
                  {project.data.role && <span class="site-ui text-xs text-gray-500">{project.data.role}</span>}
                </div>
                <p class="mt-2 max-w-3xl text-base leading-7 text-gray-600">{project.data.excerpt}</p>
                <p class="site-ui mt-3 text-xs text-gray-500">
                  {project.data.engineeringFocus.slice(0, 3).join(' · ')}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="grid gap-8 py-12 md:grid-cols-12 lg:py-14">
        <div class="md:col-span-4">
          <h2 class="text-2xl font-semibold tracking-tight text-gray-900">Writing</h2>
        </div>
        <div class="md:col-span-8">
          <ul class="divide-y divide-gray-200 border-t border-gray-200">
            {latestPosts.length > 0 ? (
              latestPosts.map((post) => (
                <li>
                  <a href={withBase(`/blog/${post.slug}`)} class="group site-ui flex items-center justify-between gap-4 py-4">
                    <span class="text-sm text-gray-800 group-hover:underline underline-offset-4">{post.data.title}</span>
                    <span class="font-mono text-xs text-gray-500">{post.data.date}</span>
                  </a>
                </li>
              ))
            ) : (
              <li class="py-4 text-sm text-gray-500">No writing yet.</li>
            )}
          </ul>
          <a href={withBase("/blog")} class="site-ui mt-4 inline-block text-sm text-gray-600 hover:text-gray-900">All writing →</a>
        </div>
      </section>

      <section class="grid gap-8 pt-12 md:grid-cols-12 lg:pt-14">
        <div class="md:col-span-4">
          <h2 class="text-2xl font-semibold tracking-tight text-gray-900">Contact</h2>
        </div>
        <div class="md:col-span-8">
          <div><SocialLinks orientation="horizontal" /></div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
