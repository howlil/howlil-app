---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowLink from "../components/content/ArrowLink.astro";
import { SITE } from "../config/site";
import { NAV_LINKS } from "../constants/navigation";
import { workExperiences } from "../data/about";
import { sortByDateDesc } from "../utils/collectionHelpers";
import { withBase } from "../lib/paths";
import { getCollection } from "astro:content";

const sortedPosts = sortByDateDesc(await getCollection("blog"));
const latestPosts = sortedPosts.slice(0, 3);

const sortedProjects = sortByDateDesc(await getCollection("projects"));
const featuredProjects = sortedProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 999) - (b.data.featuredRank ?? 999));
const selectedProjects = (featuredProjects.length > 0 ? featuredProjects : sortedProjects).slice(0, 3);
const resumeHref = NAV_LINKS.find((link) => link.name === 'Resume')?.href;
const siteUrl = Astro.site?.href || SITE.url;
const yearOf = (date: string) => date.slice(0, 4);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": SITE.name,
    "url": new URL(withBase('/'), siteUrl).href,
    "sameAs": SITE.social,
    "jobTitle": SITE.jobTitle,
    "description": SITE.description
  })} />

  <main id="main-content" class="pt-28 pb-20">
    <div class="site-shell">
      <section class="pb-16 lg:pb-20">
        <div class="max-w-4xl">
          <h1 class="text-balance max-w-4xl text-[2.6rem] font-bold leading-[1.04] tracking-[-0.04em] text-gray-900 sm:text-5xl lg:text-[3.2rem]">
            Software Engineer — Backend & Infrastructure
          </h1>
          <p class="site-ui mt-5 max-w-2xl text-lg leading-8 text-gray-600">
            I build backend services, payment workflows, and cloud infrastructure.
          </p>
          <div class="site-ui mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
            <ArrowLink href={withBase("/projects")} label="Work" direction="forward" underline={true} />
            <a href="https://github.com/howlil" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">GitHub</a>
            {resumeHref && <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">Resume</a>}
          </div>
        </div>
      </section>

      <section class="grid gap-8 py-12 md:grid-cols-12 md:gap-x-10 lg:py-16">
        <div class="md:col-span-3">
          <div class="flex items-end justify-between gap-4 md:block">
            <h2 class="text-2xl font-semibold tracking-tight text-gray-900">Selected Work</h2>
            <a href={withBase("/projects")} class="site-ui text-sm text-gray-600 hover:text-gray-900 md:mt-4 md:inline-block">All work →</a>
          </div>
        </div>

        <div class="md:col-span-9">
          <div class="divide-y divide-gray-200 border-t border-gray-200">
            {selectedProjects.map((project, index) => (
              <a href={withBase(`/projects/${project.slug}`)} class="group grid gap-3 py-6 sm:grid-cols-[2.25rem_minmax(0,1fr)_auto] sm:items-baseline sm:py-7">
                <span class="pt-1 font-mono text-xs text-gray-400">{String(index + 1).padStart(2, '0')}</span>
                <div class="min-w-0">
                  <h3 class="text-xl font-semibold tracking-tight text-gray-900 group-hover:underline underline-offset-4">{project.data.title}</h3>
                  <p class="site-ui mt-2 max-w-3xl text-[15px] leading-6 text-gray-600">{project.data.excerpt}</p>
                </div>
                <span class="site-ui text-sm text-gray-500">{yearOf(project.data.date)}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="grid gap-8 py-12 md:grid-cols-12 md:gap-x-10 lg:py-16">
        <div class="md:col-span-3">
          <h2 class="text-2xl font-semibold tracking-tight text-gray-900">Experience</h2>
          <a href={withBase("/about")} class="site-ui mt-4 inline-block text-sm text-gray-600 hover:text-gray-900">Full background →</a>
        </div>

        <div class="md:col-span-9">
          <div class="divide-y divide-gray-200 border-t border-gray-200">
            {workExperiences.map((experience) => (
              <article class="grid gap-3 py-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-8">
                <div class="min-w-0">
                  <h3 class="text-lg font-semibold tracking-tight text-gray-900">{experience.company}</h3>
                  <p class="site-ui mt-1 text-sm text-gray-500">{experience.position}</p>
                  {experience.points[0] && (
                    <p class="site-ui mt-3 max-w-3xl text-[15px] leading-6 text-gray-600">{experience.points[0]}</p>
                  )}
                </div>
                <p class="site-ui text-sm text-gray-500 sm:whitespace-nowrap">{experience.period}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="grid gap-8 py-12 md:grid-cols-12 md:gap-x-10 lg:py-16">
        <div class="md:col-span-3">
          <h2 class="text-2xl font-semibold tracking-tight text-gray-900">Writing</h2>
          <a href={withBase("/blog")} class="site-ui mt-4 inline-block text-sm text-gray-600 hover:text-gray-900">All writing →</a>
        </div>
        <div class="md:col-span-9">
          <ul class="divide-y divide-gray-200 border-t border-gray-200">
            {latestPosts.length > 0 ? (
              latestPosts.map((post) => (
                <li>
                  <a href={withBase(`/blog/${post.slug}`)} class="group site-ui grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-4 py-4">
                    <span class="text-sm text-gray-800 group-hover:underline underline-offset-4">{post.data.title}</span>
                    <span class="whitespace-nowrap font-mono text-xs text-gray-500">{post.data.date}</span>
                  </a>
                </li>
              ))
            ) : (
              <li class="py-4 text-sm text-gray-500">No writing yet.</li>
            )}
          </ul>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
