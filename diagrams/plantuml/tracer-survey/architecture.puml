@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #57534e
skinparam RectangleBorderColor #a8a29e
skinparam RectangleBackgroundColor #fafaf9
skinparam DatabaseBorderColor #a8a29e
skinparam DatabaseBackgroundColor #f5f5f4

rectangle "Admin UI" as Admin
rectangle "Respondent UI" as Respondent
rectangle "Express API" as API
database "MySQL / Prisma" as DB
rectangle "Email Provider" as Email
rectangle "Survey Graph\nquestions + branch metadata" as Graph
rectangle "Faculty-scoped RBAC" as RBAC
rectangle "Respondents / Answers" as Answers

Admin --> API
Respondent --> API
API --> DB
API --> Email
DB --> Graph
DB --> RBAC
DB --> Answers
@enduml
